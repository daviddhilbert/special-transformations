import Section3.VFAclField
import CanonicalStructure
open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Milestone0.Transfer
namespace SpecialTransformations.Section3
variable {M : Type} [LRV.Structure M] [hM : M ⊨ Axioms.ACVF]

theorem vfParameterField_union_rv (A B : Set M) (hB : ∀ t ∈ B, iRV t) :
    vfParameterField (A ∪ B) = vfParameterField A := by
  have he : {x : VFType (M := M) | x.val ∈ A ∪ B} =
      {x : VFType (M := M) | x.val ∈ A} := by
    ext x
    constructor
    · rintro (hx | hx)
      · exact hx
      · have hh := CanonicalStructure.sort_unique hM (s := .vf) (t := .rv)
          x.property (hB x.val hx)
        cases hh
    · exact fun h => Or.inl h
  unfold vfParameterField
  rw [he]

/-- Lemma 3.3, with all tuple arities and the original base S.
`vfParameterField (S ∪ range a)` is the field generated by VF(S) and the VF
tuple a. RV parameters do not enlarge this coefficient field. No saturation,
C-minimality, characteristic restriction or polynomial-stability premise
is assumed here. -/
theorem lemma_3_3 (S : Set M) {n m : ℕ} (a : Fin n → VFType (M := M))
    (t : Fin m → M) (ht : ∀ j, iRV (t j)) (b : VFType (M := M))
    (hb : AlgebraicAt ((S ∪ Set.range (fun i => (a i).val)) ∪ Set.range t) .vf b.val) :
    IsAlgebraic (vfParameterField (S ∪ Set.range (fun i => (a i).val))) b := by
  apply algebraicAt_vf_isAlgebraic _ (vfParameterField (S ∪ Set.range (fun i => (a i).val)))
    ?_ b hb
  intro x hx
  rcases hx with hx | ⟨j, hj⟩
  · exact Subfield.subset_closure hx
  · have hr : iRV x.val := hj ▸ ht j
    have hh := CanonicalStructure.sort_unique hM (s := .vf) (t := .rv) x.property hr
    cases hh

end SpecialTransformations.Section3