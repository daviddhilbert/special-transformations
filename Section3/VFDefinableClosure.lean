import Section3.DefinableConstants
import Section3.ClosureBridge
import Section3.RootDefinability
import Section3.VFAclField
set_option backward.isDefEq.respectTransparency false
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Milestone0.Transfer
/-!
VF definable closure is a field. Algebraicity over the field generated by
VF parameters is equivalent to sorted model-theoretic algebraicity.
The canonical hypothesis is used solely by the raw-to-sorted formula bridge.
No identification of generated fields with definable closure is assumed.
-/
namespace SpecialTransformations.Section3
variable {M : Type} [LRV.Structure M] [hM : M ⊨ Axioms.ACVF]

theorem definableClosureAt_iff_raw (hc : CanonicalStructure.IsCanonical (M := M))
    (S : Set M) (σ : SortTag) (x : M) :
    DefinableClosureAt S σ x ↔ S.Definable₁ LRV {x} ∧ sortEval σ x := by
  constructor
  · intro h
    exact ⟨h.raw_definable, h.algebraic.sorted⟩
  · rintro ⟨h, hx⟩
    apply raw_definable_sorted hc S {x} σ h
    rintro y rfl
    exact hx

theorem AlgebraicAt.eliminate_definable_params
    (hc : CanonicalStructure.IsCanonical (M := M)) {S B : Set M} {σ : SortTag} {x : M}
    (hB : ∀ b ∈ B, S.Definable₁ LRV {b}) (hx : AlgebraicAt B σ x) :
    AlgebraicAt S σ x := by
  obtain ⟨s, hs, hf, hxs⟩ := hx
  have hraw := DefinableConstants.eliminate_parameters {y : Fin 1 → M | y 0 ∈ s}
    hB hs.raw_definable
  exact ⟨s, raw_definable_sorted hc S s σ hraw hs.2, hf, hxs⟩

private theorem zero_dcl (hc : CanonicalStructure.IsCanonical (M := M)) (S : Set M) :
    DefinableClosureAt S .vf (0 : VFType (M := M)).val := by
  apply (definableClosureAt_iff_raw hc S .vf _).mpr
  refine ⟨?_, (0 : VFType (M := M)).property⟩
  exact DefinableConstants.function_symbol (L := LRV) Fn.vfZero Fin.elim0
    (fun i => i.elim0)

private theorem one_dcl (hc : CanonicalStructure.IsCanonical (M := M)) (S : Set M) :
    DefinableClosureAt S .vf (1 : VFType (M := M)).val := by
  apply (definableClosureAt_iff_raw hc S .vf _).mpr
  refine ⟨?_, (1 : VFType (M := M)).property⟩
  exact DefinableConstants.function_symbol (L := LRV) Fn.vfOne Fin.elim0
    (fun i => i.elim0)

private theorem inv_dcl (hc : CanonicalStructure.IsCanonical (M := M)) (S : Set M)
    (x : VFType (M := M)) (hx : DefinableClosureAt S .vf x.val) :
    DefinableClosureAt S .vf x⁻¹.val := by
  by_cases hx0 : x = 0
  · simpa only [hx0, inv_zero] using zero_dcl hc S
  · have hxc : S.Definable₁ LRV {x.val} := hx.raw_definable
    have hone : S.DefinableFun LRV (fun _ : Fin 1 → M => iVFOne) :=
      DefinableConstants.constant (one_dcl hc S).raw_definable
    have hmul : S.DefinableFun LRV (fun z : Fin 1 → M => iVFMul x.val (z 0)) := by
      have hf : S.DefinableFun LRV (Structure.funMap (L := LRV) Fn.vfMul) :=
        Set.DefinableFun.of_empty (Set.DefinableFun.fun_symbol (M := M) (L := LRV) Fn.vfMul)
      exact hf.comp (show S.DefinableMap LRV (fun z : Fin 1 → M => ![x.val, z 0]) from by
        intro i; fin_cases i
        · exact DefinableConstants.constant hxc
        · exact Set.DefinableFun.proj LRV)
    have hVF : S.Definable LRV {z : Fin 1 → M | iVF (z 0)} :=
      (definableAt_sort S .vf).raw_definable
    have hT : S.Definable₁ LRV {z | iVF z ∧ iVFMul x.val z = iVFOne} :=
      hVF.inter (hmul.ofPred_eq hone)
    have he : {z | iVF z ∧ iVFMul x.val z = iVFOne} = {x⁻¹.val} := by
      ext z
      constructor
      · rintro ⟨hz, hprod⟩
        let y : VFType (M := M) := ⟨z, hz⟩
        have hp : x * y = 1 := Subtype.ext hprod
        have hy : y = x⁻¹ := by
          calc
            y = x⁻¹ * (x * y) := by rw [← mul_assoc, inv_mul_cancel₀ hx0, one_mul]
            _ = x⁻¹ := by rw [hp, mul_one]
        exact congrArg Subtype.val hy
      · intro hz
        rw [Set.mem_singleton_iff] at hz
        subst z
        have hm : x * x⁻¹ = (1 : VFType (M := M)) := mul_inv_cancel₀ hx0
        exact ⟨x⁻¹.property, congrArg Subtype.val hm⟩
    rw [he] at hT
    exact (definableClosureAt_iff_raw hc S .vf _).mpr ⟨hT, x⁻¹.property⟩

noncomputable def vfDefinableClosureField
    (hc : CanonicalStructure.IsCanonical (M := M)) (S : Set M) :
    Subfield (VFType (M := M)) where
  carrier := {x | DefinableClosureAt S .vf x.val}
  zero_mem' := zero_dcl hc S
  one_mem' := one_dcl hc S
  add_mem' := by
    intro x y hx hy
    apply (definableClosureAt_iff_raw hc S .vf _).mpr
    refine ⟨?_, (x + y).property⟩
    exact DefinableConstants.function_symbol (L := LRV) Fn.vfAdd ![x.val, y.val]
      (by intro i; fin_cases i; exact hx.raw_definable; exact hy.raw_definable)
  mul_mem' := by
    intro x y hx hy
    apply (definableClosureAt_iff_raw hc S .vf _).mpr
    refine ⟨?_, (x * y).property⟩
    exact DefinableConstants.function_symbol (L := LRV) Fn.vfMul ![x.val, y.val]
      (by intro i; fin_cases i; exact hx.raw_definable; exact hy.raw_definable)
  neg_mem' := by
    intro x hx
    apply (definableClosureAt_iff_raw hc S .vf _).mpr
    refine ⟨?_, (-x).property⟩
    exact DefinableConstants.function_symbol (L := LRV) Fn.vfNeg ![x.val]
      (by intro i; fin_cases i; exact hx.raw_definable)
  inv_mem' := inv_dcl hc S

theorem vfParameterField_le_definableClosureField
    (hc : CanonicalStructure.IsCanonical (M := M)) (S : Set M) :
    vfParameterField S ≤ vfDefinableClosureField hc S := by
  apply Subfield.closure_le.mpr
  intro x hx
  exact definableClosureAt_of_mem hx x.property

theorem algebraicAt_vf_iff_parameterField
    (hc : CanonicalStructure.IsCanonical (M := M)) (S : Set M) (b : VFType (M := M)) :
    AlgebraicAt S .vf b.val ↔ IsAlgebraic (vfParameterField S) b := by
  constructor
  · exact algebraicAt_vf_parameterField S b
  · intro hb
    let D : Set M := {x | DefinableClosureAt S .vf x}
    have hE (x : vfParameterField S) : x.val.val ∈ D :=
      vfParameterField_le_definableClosureField hc S x.property
    have halg := PolynomialRoots.algebraicAt_of_isAlgebraic_named D
      (vfParameterField S) hE b hb
    exact halg.eliminate_definable_params hc (fun x hx => hx.raw_definable)

end SpecialTransformations.Section3
