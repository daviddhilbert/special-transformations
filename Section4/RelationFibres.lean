namespace SpecialTransformations.Section4

variable {M : Type} [LRV.Structure M] [hM : M ⊨ Axioms.ACVF]

theorem vfParameterField_union_mixed (S : Set M) {n r : ℕ}
    (a : (rawMixedSpace (M := M) n r).Carrier) :
    vfParameterField (S ∪ Set.range (mixedValues a)) = tupleField (vfParameterField S) a.1 := by
  have he : Set.range (mixedValues a) = Set.range (vfValues a.1) ∪ Set.range (rvValues a.2) := by
    ext x
    constructor
    · rintro ⟨q, rfl⟩
      cases q with
      | inl j => exact Or.inl (Set.mem_range_self j)
      | inr j => exact Or.inr (Set.mem_range_self j)
    · rintro (⟨j, rfl⟩ | ⟨j, rfl⟩)
      · exact ⟨.inl j, rfl⟩
      · exact ⟨.inr j, rfl⟩
  rw [he, ← Set.union_assoc, vfParameterField_union_rv _ _ (by
    rintro x ⟨j, rfl⟩; exact (a.2 j).property), vfParameterField_union_tuple]

/-- Finite-valued definable relations make each output VF coordinate
algebraic over the VF field generated by the input and the original base. -/
theorem finite_relation_vf_coordinate_isAlgebraic
    (hcan : CanonicalStructure.IsCanonical (M := M)) {S : Set M}
    {n r m s : ℕ}
    {R : (rawMixedSpace (M := M) n r).Carrier → (rawMixedSpace m s).Carrier → Prop}
    (hR : (rawMixedSpace n r).RelationDefinable (rawMixedSpace m s) S R)
    (a : (rawMixedSpace (M := M) n r).Carrier)
    (b : (rawMixedSpace (M := M) m s).Carrier) (hab : R a b)
    (hf : {y | R a y}.Finite) (j : Fin m) :
    IsAlgebraic (tupleField (vfParameterField S) a.1) (b.1 j) := by
  let c : (rawMixedSpace (M := M) n r).domain :=
    ⟨mixedValues a, mixedValues_mem_domain a⟩
  let F := relationFibre hR a c (decode_mixedValues a)
  have hraw : RawClosure.AlgebraicOver (S ∪ Set.range (mixedValues a)) (b.1 j).val :=
    ⟨vfCoordinateSet F j, vfCoordinateSet_definable F j,
      vfCoordinateSet_finite F hf j, ⟨⟨b, hab⟩, rfl⟩⟩
  have h := algebraicAt_vf_parameterField _ (b.1 j)
    ((algebraicAt_iff_raw hcan _ .vf _).mpr ⟨hraw, (b.1 j).property⟩)
  rwa [vfParameterField_union_mixed] at h

end SpecialTransformations.Section4

