namespace SpecialTransformations.DefinableGeometry

variable {L : Language} {M : Type} [L.Structure M]
variable {P Q : Space L M} {S : Set M} {r : P.Carrier → Q.Carrier → Prop}

/-- Specialize the full definable relation at any real code of its first
argument. This construction makes no choice of representatives. -/
def relationFibre (hr : P.RelationDefinable Q S r)
    (a : P.Carrier) (c : P.domain) (hc : P.decode c = a) :
    DefSet Q (S ∪ Set.range c.val) where
  carrier := {b | r a b}
  definable := by
    let T := S ∪ Set.range c.val
    let F (z : Q.Index → M) : P.Index ⊕ Q.Index → M := Sum.elim c.val z
    have hF : T.DefinableMap L F := by
      intro i
      cases i with
      | inl i => exact L.definableFun_const Q.Index (Or.inr (Set.mem_range_self i))
      | inr i => exact Set.DefinableFun.proj L
    have h := (hr.mono P Q Set.subset_union_left).preimage_map hF
    change T.Definable L _
    convert h using 1
    ext z
    constructor
    · rintro ⟨hz, hrz⟩
      refine ⟨c.property, hz, ?_⟩
      change r (P.decode c) (Q.decode ⟨z, hz⟩)
      rwa [hc]
    · rintro ⟨hx, hz, hrz⟩
      refine ⟨hz, ?_⟩
      change r (P.decode c) (Q.decode ⟨z, hz⟩) at hrz
      change r a (Q.decode ⟨z, hz⟩)
      rwa [hc] at hrz

end SpecialTransformations.DefinableGeometry

open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
