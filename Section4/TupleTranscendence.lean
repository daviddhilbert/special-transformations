import Section3.SubfieldTrdeg

set_option backward.isDefEq.respectTransparency false
set_option linter.style.haveILetI false

/-!
# Transcendence degree of finite tuples

Small bridges to Mathlib's injective-map monotonicity and finite generator
bound. The base and generated fields are actual subfields of one ambient
field; algebraicity is never an additional dimension-comparison hypothesis.
-/

open Classical
open SpecialTransformations.Section3

noncomputable section

namespace SpecialTransformations.Section4

variable {K : Type} [Field K]

def tupleField (E : Subfield K) {n : ℕ} (a : Fin n → K) : Subfield K :=
  E ⊔ Subfield.closure (Set.range a)

theorem le_tupleField (E : Subfield K) {n : ℕ} (a : Fin n → K) :
    E ≤ tupleField E a := le_sup_left

theorem tuple_mem_tupleField (E : Subfield K) {n : ℕ} (a : Fin n → K) (j : Fin n) :
    a j ∈ tupleField E a :=
  (show Subfield.closure (Set.range a) ≤ tupleField E a from le_sup_right)
    (Subfield.subset_closure (Set.mem_range_self j))

theorem relativeTrdeg_mono (E F G : Subfield K) (hEF : E ≤ F) (hFG : F ≤ G) :
    relativeTrdeg E F hEF ≤ relativeTrdeg E G (hEF.trans hFG) := by
  letI := (Subfield.inclusion hEF).toAlgebra
  letI := (Subfield.inclusion (hEF.trans hFG)).toAlgebra
  let f : F →ₐ[E] G := { Subfield.inclusion hFG with commutes' := fun _ => rfl }
  exact trdeg_le_of_injective f
    (fun x y h => Subtype.ext (congrArg (fun z : G => z.val) h))

theorem tupleField_trdeg_le (E : Subfield K) {n : ℕ} (a : Fin n → K) :
    relativeTrdeg E (tupleField E a) (le_tupleField E a) ≤ (n : Cardinal) := by
  let F := tupleField E a
  letI := (Subfield.inclusion (le_tupleField E a)).toAlgebra
  let a' : Fin n → F := fun j => ⟨a j, tuple_mem_tupleField E a j⟩
  let T := IntermediateField.adjoin E (Set.range a')
  have hmap : F ≤ T.toSubfield.map F.subtype := by
    apply sup_le
    · intro x hx
      exact ⟨algebraMap E F ⟨x, hx⟩, T.algebraMap_mem _, rfl⟩
    · apply Subfield.closure_le.mpr
      rintro x ⟨j, rfl⟩
      exact ⟨a' j, IntermediateField.subset_adjoin E _ (Set.mem_range_self j), rfl⟩
  have ht : T = ⊤ := by
    apply top_le_iff.mp
    intro x _
    obtain ⟨y, hy, he⟩ := hmap x.property
    exact (Subtype.ext he : y = x) ▸ hy
  haveI : Algebra.IsAlgebraic (Algebra.adjoin E (Set.range a')) F := by
    rw [← IntermediateField.isAlgebraic_adjoin_iff_top]
    change Algebra.IsAlgebraic T F
    rw [ht]
    infer_instance
  change Algebra.trdeg E F ≤ (n : Cardinal)
  exact (Algebra.IsAlgebraic.trdeg_le_cardinalMk E (Set.range a')).trans
    (by simpa using (Cardinal.mk_range_le (f := a')))

/-- A tuple algebraic over the field generated by k elements has relative
transcendence degree at most k. No inclusion between the two tuple fields
is required. -/
theorem tupleField_trdeg_le_of_isAlgebraic (E : Subfield K) {n k : ℕ}
    (a : Fin n → K) (b : Fin k → K)
    (ha : ∀ j, IsAlgebraic (tupleField E b) (a j)) :
    relativeTrdeg E (tupleField E a) (le_tupleField E a) ≤ (k : Cardinal) := by
  let G := tupleField E b
  let H := (algebraicClosure G K).toSubfield
  have hGH : G ≤ H := by
    intro x hx
    exact mem_algebraicClosure_iff.mpr
      (show IsAlgebraic G x from isAlgebraic_algebraMap (⟨x, hx⟩ : G))
  have hEH : E ≤ H := (le_tupleField E b).trans hGH
  have hAH : tupleField E a ≤ H := by
    apply sup_le hEH
    exact Subfield.closure_le.mpr
      (by rintro x ⟨j, rfl⟩; exact mem_algebraicClosure_iff.mpr (ha j))
  have hmono := relativeTrdeg_mono E (tupleField E a) H (le_tupleField E a) hAH
  have heq := relativeTrdeg_eq_of_algebraic E G H (le_tupleField E b) hGH
    (fun _ hx => mem_algebraicClosure_iff.mp hx)
  exact (hmono.trans_eq heq.symm).trans (tupleField_trdeg_le E b)

end SpecialTransformations.Section4

end
