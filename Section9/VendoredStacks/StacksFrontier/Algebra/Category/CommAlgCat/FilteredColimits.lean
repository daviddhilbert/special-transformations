module

public import Mathlib.Algebra.Algebra.Subalgebra.Directed
public import Mathlib.Algebra.Category.CommAlgCat.Basic
public import Mathlib.CategoryTheory.Filtered.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Filtered colimits of commutative algebras

Let `R` be a commutative ring and let `F : I ⥤ CommAlgCat R` be a diagram of commutative
`R`-algebras with a colimit cocone `c`. This file records the concrete description of `c`
that the universal property forces: the legs `c.ι.app i` are jointly surjective, if `I` is
filtered and every transition map is surjective then every leg is surjective, and an element
of `F.obj i` dying in the colimit already dies at a finite stage. The last statement is what
lets an equation between elements of a filtered colimit be transported back to a stage of
the diagram.

## Main definitions

* `CommAlgCat.eventualKernel F i`: the ideal of elements of `F.obj i` killed by some
  transition map out of `i`.

## Main results

* `CommAlgCat.iSup_range_eq_top`: the legs of a colimit cocone are jointly surjective, i.e.
  the supremum of their ranges is the whole colimit.
* `CommAlgCat.directed_range`: over a filtered index category those ranges are directed.
* `CommAlgCat.exists_app_eq`: every element of a filtered colimit comes from some stage.
* `CommAlgCat.surjective_app`: for a filtered diagram whose transition maps are surjective,
  every leg of a colimit cocone is surjective.
* `CommAlgCat.eventualKernel_eq_ker`, `CommAlgCat.exists_map_eq_zero`,
  `CommAlgCat.exists_map_eq`: for a filtered diagram whose transition maps are surjective,
  an equation holding in the colimit already holds at a finite stage.

## Implementation notes

No statement here is about a *constructed* colimit, so none of them needs the index category
to be small: its objects live in an arbitrary universe `u₁` and its morphisms in an arbitrary
universe `u₂`, both unrelated to the universe `v` of the algebras. That generality is forced
rather than chosen — the intended use is a cocone asserted to be colimiting whose apex is
strictly smaller than the standard construction of the colimit, which exists only when the
index category is small.

Consequently every proof goes through the universal property rather than through a
description of the underlying set of the colimit. Joint surjectivity comes from corestricting
the legs to the subalgebra generated by their images: that is a second cocone, so the
universal property retracts the inclusion of that subalgebra. The finite-stage description of
the kernel is obtained the same way. `eventualKernel F i` is an ideal because `I` is filtered;
the quotient of `F.obj i` by it receives a map from each stage because the transition maps are
surjective and their kernels are contained in it; those maps form a cocone, so the universal
property produces a map from the colimit through which the quotient map factors.

The elements of `eventualKernel` are described by an existential over *morphisms* out of `i`
rather than over objects, since in a general filtered category it is the morphism, not the
target, that carries the information.
-/

@[expose] public section

universe v u u₁ u₂

open CategoryTheory CategoryTheory.Limits

namespace CommAlgCat

variable {R : Type u} [CommRing R] {I : Type u₁} [Category.{u₂} I]
  {F : I ⥤ CommAlgCat.{v} R} {c : Cocone F}

/-- Applying a composite transition map is applying the two maps in turn. -/
lemma map_comp_apply {i j k : I} (f : i ⟶ j) (g : j ⟶ k) (x : F.obj i) :
    F.map (f ≫ g) x = F.map g (F.map f x) := by
  rw [F.map_comp]; rfl

/-- A leg of a cocone absorbs the transition maps preceding it. -/
private lemma app_map_apply {i j : I} (f : i ⟶ j) (x : F.obj i) :
    c.ι.app j (F.map f x) = c.ι.app i x := by
  conv_rhs => rw [← c.w f]
  rfl

section JointlySurjective

/-- The legs of a colimit cocone of commutative algebras are jointly surjective: the
subalgebra generated by their images is the whole colimit. -/
theorem iSup_range_eq_top (hc : IsColimit c) :
    (⨆ i : I, ((c.ι.app i).hom : F.obj i →ₐ[R] c.pt).range) = (⊤ : Subalgebra R c.pt) := by
  set S : Subalgebra R c.pt := ⨆ i : I, ((c.ι.app i).hom : F.obj i →ₐ[R] c.pt).range with hS
  have hmem : ∀ (i : I) (x : F.obj i), c.ι.app i x ∈ S := by
    intro i x
    rw [hS]
    exact Algebra.mem_iSup_of_mem i ⟨x, rfl⟩
  let d : Cocone F :=
    { pt := CommAlgCat.of R S
      ι :=
        { app := fun i => CommAlgCat.ofHom ((c.ι.app i).hom.codRestrict S (hmem i))
          naturality := by
            intro i j f
            ext x
            exact Subtype.ext (app_map_apply f x) } }
  have hfac : hc.desc d ≫ CommAlgCat.ofHom S.val = 𝟙 c.pt := by
    refine hc.hom_ext fun i => ?_
    rw [Category.comp_id, ← Category.assoc, hc.fac d i]
    rfl
  refine eq_top_iff.2 fun x _ => ?_
  have hx : x = ((hc.desc d x : S) : c.pt) := by
    conv_lhs => rw [show x = (𝟙 c.pt) x from rfl, ← hfac]
    rfl
  exact hx ▸ (hc.desc d x).2

variable [IsFiltered I]

/-- The ranges of the legs of a cocone over a filtered diagram form a directed family. -/
theorem directed_range (c : Cocone F) :
    Directed ((· ≤ ·) : Subalgebra R c.pt → Subalgebra R c.pt → Prop)
      (fun i : I => ((c.ι.app i).hom : F.obj i →ₐ[R] c.pt).range) := by
  intro i j
  refine ⟨IsFiltered.max i j, ?_, ?_⟩
  · rintro _ ⟨x, rfl⟩
    exact ⟨F.map (IsFiltered.leftToMax i j) x, app_map_apply _ x⟩
  · rintro _ ⟨x, rfl⟩
    exact ⟨F.map (IsFiltered.rightToMax i j) x, app_map_apply _ x⟩

/-- Every element of a filtered colimit of commutative algebras comes from some stage. -/
theorem exists_app_eq (hc : IsColimit c) (x : c.pt) :
    ∃ (i : I) (y : F.obj i), c.ι.app i y = x := by
  have : Nonempty I := IsFiltered.nonempty
  have hx : x ∈ (⊤ : Subalgebra R c.pt) := trivial
  rw [← iSup_range_eq_top hc, ← SetLike.mem_coe,
    Subalgebra.coe_iSup_of_directed (directed_range c)] at hx
  obtain ⟨_, ⟨i, rfl⟩, y, hy⟩ := hx
  exact ⟨i, y, hy⟩

/-- If every transition map of a filtered diagram of commutative algebras is surjective,
then so is every leg of a colimit cocone. -/
theorem surjective_app (hc : IsColimit c)
    (hsurj : ∀ {i j : I} (f : i ⟶ j), Function.Surjective (F.map f)) (i : I) :
    Function.Surjective (c.ι.app i) := by
  intro x
  obtain ⟨k, y, hy⟩ := exists_app_eq hc x
  obtain ⟨z, hz⟩ := hsurj (IsFiltered.leftToMax i k) (F.map (IsFiltered.rightToMax i k) y)
  exact ⟨z, by rw [← app_map_apply (IsFiltered.leftToMax i k) z, hz, app_map_apply, hy]⟩

end JointlySurjective

section EventualKernel

variable [IsFiltered I]

/-- The elements of `F.obj i` killed by some transition map out of `i`. For a filtered
diagram this is an ideal, and for a colimit cocone with surjective transition maps it is the
kernel of the leg at `i`; see `CommAlgCat.eventualKernel_eq_ker`. -/
def eventualKernel (F : I ⥤ CommAlgCat.{v} R) (i : I) : Ideal (F.obj i) where
  carrier := {x | ∃ (j : I) (f : i ⟶ j), F.map f x = 0}
  zero_mem' := ⟨i, 𝟙 i, by simp⟩
  add_mem' := by
    rintro x y ⟨j, f, hf⟩ ⟨k, g, hg⟩
    refine ⟨IsFiltered.coeq (f ≫ IsFiltered.leftToMax j k) (g ≫ IsFiltered.rightToMax j k),
      (f ≫ IsFiltered.leftToMax j k) ≫
        IsFiltered.coeqHom (f ≫ IsFiltered.leftToMax j k) (g ≫ IsFiltered.rightToMax j k), ?_⟩
    have hx : F.map ((f ≫ IsFiltered.leftToMax j k) ≫
        IsFiltered.coeqHom (f ≫ IsFiltered.leftToMax j k)
          (g ≫ IsFiltered.rightToMax j k)) x = 0 := by
      rw [map_comp_apply, map_comp_apply, hf, map_zero, map_zero]
    have hy : F.map ((f ≫ IsFiltered.leftToMax j k) ≫
        IsFiltered.coeqHom (f ≫ IsFiltered.leftToMax j k)
          (g ≫ IsFiltered.rightToMax j k)) y = 0 := by
      rw [IsFiltered.coeq_condition (f ≫ IsFiltered.leftToMax j k)
        (g ≫ IsFiltered.rightToMax j k), map_comp_apply, map_comp_apply, hg, map_zero, map_zero]
    rw [map_add, hx, hy, add_zero]
  smul_mem' := by
    rintro r x ⟨j, f, hf⟩
    exact ⟨j, f, by rw [smul_eq_mul, map_mul, hf, mul_zero]⟩

/-- An element `x` of `F.obj i` lies in `eventualKernel F i` if and only if `F.map f x = 0` for
some morphism `f : i ⟶ j`. -/
lemma mem_eventualKernel_iff {i : I} {x : F.obj i} :
    x ∈ eventualKernel F i ↔ ∃ (j : I) (f : i ⟶ j), F.map f x = 0 := Iff.rfl

variable (hsurj : ∀ {i j : I} (f : i ⟶ j), Function.Surjective (F.map f))

private lemma ker_le_eventualKernel {i l : I} (u : i ⟶ l) :
    RingHom.ker (F.map u).hom ≤ eventualKernel F i :=
  fun _ hz => ⟨l, u, hz⟩

/-- The map to the quotient of `F.obj i` by `eventualKernel F i` induced by a later stage.
It is well defined because `F.map u` is surjective with kernel inside `eventualKernel F i`. -/
private noncomputable def quotientHom {i l : I} (u : i ⟶ l) :
    F.obj l →ₐ[R] (F.obj i ⧸ eventualKernel F i) :=
  (Ideal.Quotient.factorₐ R (ker_le_eventualKernel u)).comp
    (Ideal.quotientKerAlgEquivOfSurjective
      (f := (F.map u).hom) (hsurj u)).symm.toAlgHom

private lemma quotientHom_map {i l : I} (u : i ⟶ l) (z : F.obj i) :
    quotientHom hsurj u (F.map u z) = Ideal.Quotient.mk (eventualKernel F i) z := by
  show Ideal.Quotient.factorₐ R (ker_le_eventualKernel u)
      ((Ideal.quotientKerAlgEquivOfSurjective (f := (F.map u).hom) (hsurj u)).symm
        ((F.map u).hom z)) = _
  rw [Ideal.quotientKerAlgEquivOfSurjective_symm_apply]
  rfl

/-- `quotientHom` is compatible with the transition maps. -/
private lemma quotientHom_comp {i l m : I} (u : i ⟶ l) (w : l ⟶ m) (y : F.obj l) :
    quotientHom hsurj (u ≫ w) (F.map w y) = quotientHom hsurj u y := by
  obtain ⟨z, rfl⟩ := hsurj u y
  rw [← map_comp_apply, quotientHom_map, quotientHom_map]

private lemma quotientHom_push {i j l m : I} (u : i ⟶ l) (r : j ⟶ l) (t : l ⟶ m) (y : F.obj j) :
    quotientHom hsurj u (F.map r y) = quotientHom hsurj (u ≫ t) (F.map (r ≫ t) y) := by
  rw [map_comp_apply, quotientHom_comp]

/-- `quotientHom` does not depend on the chosen morphism out of `i`. -/
private lemma quotientHom_indep {i l : I} (u u' : i ⟶ l) :
    quotientHom hsurj u = quotientHom hsurj u' := by
  ext y
  obtain ⟨z, rfl⟩ := hsurj u y
  obtain ⟨z', hz'⟩ := hsurj u' (F.map u z)
  have h : F.map (u ≫ IsFiltered.coeqHom u u') (z - z') = 0 := by
    rw [map_sub, sub_eq_zero, map_comp_apply]
    conv_rhs => rw [IsFiltered.coeq_condition u u']
    rw [map_comp_apply, hz']
  rw [quotientHom_map, ← hz', quotientHom_map]
  exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem z z').2 ⟨_, _, h⟩

/-- The image in the quotient of `F.obj i` by `eventualKernel F i` of an element of any
stage `j` does not depend on how `i` and `j` are compared. -/
private lemma quotientHom_map_eq {i j l l' : I} (u : i ⟶ l) (r : j ⟶ l)
    (u' : i ⟶ l') (r' : j ⟶ l') (y : F.obj j) :
    quotientHom hsurj u (F.map r y) = quotientHom hsurj u' (F.map r' y) := by
  rw [quotientHom_push hsurj u r (IsFiltered.leftToMax l l'),
    quotientHom_push hsurj u' r' (IsFiltered.rightToMax l l'),
    quotientHom_indep hsurj (u' ≫ IsFiltered.rightToMax l l')
      (u ≫ IsFiltered.leftToMax l l'),
    quotientHom_push hsurj (u ≫ IsFiltered.leftToMax l l') (r ≫ IsFiltered.leftToMax l l')
      (IsFiltered.coeqHom (r ≫ IsFiltered.leftToMax l l') (r' ≫ IsFiltered.rightToMax l l')),
    quotientHom_push hsurj (u ≫ IsFiltered.leftToMax l l') (r' ≫ IsFiltered.rightToMax l l')
      (IsFiltered.coeqHom (r ≫ IsFiltered.leftToMax l l') (r' ≫ IsFiltered.rightToMax l l')),
    IsFiltered.coeq_condition]

/-- The cocone on `F` whose apex is the quotient of `F.obj i` by `eventualKernel F i`. -/
private noncomputable def quotientCocone (i : I) : Cocone F where
  pt := CommAlgCat.of R (F.obj i ⧸ eventualKernel F i)
  ι :=
    { app := fun j => CommAlgCat.ofHom
        ((quotientHom hsurj (IsFiltered.leftToMax i j)).comp
          (F.map (IsFiltered.rightToMax i j)).hom)
      naturality := by
        intro j j' g
        ext y
        change quotientHom hsurj (IsFiltered.leftToMax i j')
            (F.map (IsFiltered.rightToMax i j') (F.map g y)) =
          quotientHom hsurj (IsFiltered.leftToMax i j)
            (F.map (IsFiltered.rightToMax i j) y)
        rw [← map_comp_apply]
        exact quotientHom_map_eq hsurj _ _ _ _ y }

private lemma quotientCocone_app_self (i : I) (y : F.obj i) :
    (quotientCocone hsurj i).ι.app i y = Ideal.Quotient.mk (eventualKernel F i) y := by
  show quotientHom hsurj (IsFiltered.leftToMax i i)
      (F.map (IsFiltered.rightToMax i i) y) = _
  rw [quotientHom_map_eq hsurj (IsFiltered.leftToMax i i) (IsFiltered.rightToMax i i)
    (𝟙 i) (𝟙 i) y]
  exact quotientHom_map hsurj (𝟙 i) y

include hsurj in
/-- For a filtered diagram of commutative algebras with surjective transition maps, the
kernel of a leg of a colimit cocone is detected at a finite stage. -/
theorem eventualKernel_eq_ker (hc : IsColimit c) (i : I) :
    eventualKernel F i = RingHom.ker (c.ι.app i).hom := by
  refine le_antisymm (fun x hx => ?_) (fun x hx => ?_)
  · obtain ⟨j, f, hf⟩ := hx
    show c.ι.app i x = 0
    rw [← app_map_apply f x, hf, map_zero]
  · have h0 : (quotientCocone hsurj i).ι.app i x = 0 := by
      rw [← hc.fac (quotientCocone hsurj i) i]
      show hc.desc (quotientCocone hsurj i) (c.ι.app i x) = 0
      rw [show c.ι.app i x = 0 from hx, map_zero]
    rw [quotientCocone_app_self] at h0
    exact Ideal.Quotient.eq_zero_iff_mem.1 h0

include hsurj in
/-- An element of a stage of a filtered diagram of commutative algebras with surjective
transition maps which dies in the colimit is already killed by a transition map. -/
theorem exists_map_eq_zero (hc : IsColimit c) {i : I} {x : F.obj i} (hx : c.ι.app i x = 0) :
    ∃ (j : I) (f : i ⟶ j), F.map f x = 0 :=
  (eventualKernel_eq_ker hsurj hc i).ge hx

include hsurj in
/-- An equation between elements of a stage of a filtered diagram of commutative algebras
with surjective transition maps which holds in the colimit already holds at a finite
stage. -/
theorem exists_map_eq (hc : IsColimit c) {i : I} {x y : F.obj i}
    (hxy : c.ι.app i x = c.ι.app i y) :
    ∃ (j : I) (f : i ⟶ j), F.map f x = F.map f y := by
  obtain ⟨j, f, hf⟩ := exists_map_eq_zero hsurj hc (x := x - y) (by rw [map_sub, hxy, sub_self])
  exact ⟨j, f, by rwa [map_sub, sub_eq_zero] at hf⟩

end EventualKernel

end CommAlgCat

end
