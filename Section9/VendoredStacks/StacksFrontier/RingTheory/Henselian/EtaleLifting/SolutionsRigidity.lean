/-!
# Rigidity of solutions of an étale system over a henselian local ring

For an étale presentation `R[x_1, …, x_n]/(P_1, …, P_n)` over a local ring, two solutions over
`R` that agree modulo `m_R` are equal. This is the injectivity half of Stacks Tag 04GX.

## Main results

* `eq_of_sub_mem_maximalIdeal_of_etale`: solutions congruent modulo `m_R` are equal.
* `injOn_solutions_of_etale`: the coordinatewise map along a local homomorphism is injective on
  solutions.
* `eq_of_sub_mem_maximalIdeal_of_etale_map`: the congruence statement after base change.
-/

@[expose] public section

-- needed: the `rw`s in `span_range_sub_le_maximalIdeal_smul` match only when defeq unfolds
-- `MvPolynomial.aeval`/the Jacobian expansion past the default transparency
set_option backward.isDefEq.respectTransparency false in
open MvPolynomial in
/-- **Core estimate for étale rigidity.**
For an étale presentation `A = R[x]/(P)` over a local ring `R` and two solutions `r, r'` of
`P` over `R` that are congruent coordinatewise modulo `𝔪_R`, let `d i := r i - r' i`. Then
the ideal `𝔡` generated by the differences satisfies `𝔡 ≤ 𝔪_R • 𝔡`.

This is the uniqueness half of Stacks 04GG; no henselianness is needed. Classically one
argues with the Jacobian: because `A` is étale — standard smooth of relative dimension `0`,
with `n` equations in `n` variables — the Jacobian determinant `J = det(∂Pᵢ/∂xⱼ)` is a unit
in `A`, hence `M := (∂Pᵢ/∂xⱼ(r))` is an invertible matrix over `R` (Stacks 00U7/02GE), and
the second-order Taylor expansion of each `Pᵢ` at `r` along `d`,
  `0 = eval r' (Pᵢ) = eval r (Pᵢ) + Σⱼ (∂Pᵢ/∂xⱼ(r)) dⱼ + hᵢ(d)`,  with `hᵢ(d) ∈ 𝔡²`,
gives `M d = -h(d) ∈ (𝔡²)ⁿ`; invertibility of `M` then places `d` in `(𝔡²)ⁿ`
componentwise.

The proof below reaches the same conclusion without the Jacobian, from the square-zero
uniqueness clause of formal unramifiedness applied to `𝔡 · (R/𝔡²)`: each `d i` lies in `𝔡²`,
and `𝔡² ⊆ 𝔪_R • 𝔡` because `𝔡 ⊆ 𝔪_R`. -/
theorem span_range_sub_le_maximalIdeal_smul
    {R : Type*} [CommRing R] [IsLocalRing R]
    (n : ℕ) (P : Fin n → MvPolynomial (Fin n) R)
    [Algebra.Etale R (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range P))]
    (r r' : Fin n → R)
    (hr : ∀ i, MvPolynomial.eval r (P i) = 0)
    (hr' : ∀ i, MvPolynomial.eval r' (P i) = 0)
    (hcong : ∀ i, r i - r' i ∈ IsLocalRing.maximalIdeal R) :
    Ideal.span (Set.range (fun i => r i - r' i)) ≤
      IsLocalRing.maximalIdeal R • Ideal.span (Set.range (fun i => r i - r' i)) := by
  -- Étale ⇒ formally unramified; we use the square-zero uniqueness clause of
  -- formal unramifiedness (`FormallyUnramified.ext`) with the genuinely
  -- square-zero ideal 𝔡·(R/𝔡²) to deduce each difference d i lies in 𝔡²,
  -- then 𝔡 ⊆ 𝔡² ⊆ 𝔪·𝔡 (since 𝔡 ⊆ 𝔪). This bypasses the Jacobian entirely.
  classical
  set d : Fin n → R := fun i => r i - r' i with hd
  set 𝔡 : Ideal R := Ideal.span (Set.range d) with h𝔡
  -- 𝔡 ⊆ 𝔪.
  have h𝔡m : 𝔡 ≤ IsLocalRing.maximalIdeal R := by
    rw [h𝔡, Ideal.span_le]
    rintro x ⟨i, rfl⟩
    exact hcong i
  -- each d i ∈ 𝔡 (generators).
  have hdmem : ∀ i, d i ∈ 𝔡 := fun i => Ideal.subset_span ⟨i, rfl⟩
  -- KEY (square-zero formal unramifiedness): each d i ∈ 𝔡².
  have hdi_sq : ∀ i, d i ∈ 𝔡 ^ 2 := by
    set B := R ⧸ 𝔡 ^ 2 with hB
    set A := MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range P) with hA
    have aeval_algMap : ∀ (s : Fin n → R) (Q : MvPolynomial (Fin n) R),
        MvPolynomial.aeval (fun i => algebraMap R B (s i)) Q
          = algebraMap R B (MvPolynomial.eval s Q) := by
      intro s Q
      have : (algebraMap R B).comp (MvPolynomial.eval s)
          = (MvPolynomial.eval₂Hom (algebraMap R B) (fun i => algebraMap R B (s i))) := by
        apply MvPolynomial.ringHom_ext <;> simp
      rw [MvPolynomial.aeval_def]
      rw [show MvPolynomial.eval₂ (algebraMap R B) (fun i => algebraMap R B (s i)) Q
            = MvPolynomial.eval₂Hom (algebraMap R B) (fun i => algebraMap R B (s i)) Q from rfl]
      rw [← this]; rfl
    have hvanish : ∀ (s : Fin n → R), (∀ i, MvPolynomial.eval s (P i) = 0) →
        ∀ x ∈ Ideal.span (Set.range P),
          MvPolynomial.aeval (fun i => algebraMap R B (s i)) x = 0 := by
      intro s hs x hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · rintro y ⟨i, rfl⟩; rw [aeval_algMap, hs i, map_zero]
      · simp
      · intro a b _ _ ha hb; rw [map_add, ha, hb, add_zero]
      · intro a b _ hb; rw [smul_eq_mul, map_mul, hb, mul_zero]
    -- eval r q ≡ eval r' q mod 𝔡 (since r ≡ r' mod 𝔡 componentwise).
    have heval_cong : ∀ (q : MvPolynomial (Fin n) R),
        MvPolynomial.eval r q - MvPolynomial.eval r' q ∈ 𝔡 := by
      intro q
      have hfun : (fun i => Ideal.Quotient.mk 𝔡 (r i))
          = (fun i => Ideal.Quotient.mk 𝔡 (r' i)) := by
        funext i
        rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]; exact hdmem i
      have key : ∀ (s : Fin n → R), Ideal.Quotient.mk 𝔡 (MvPolynomial.eval s q)
          = MvPolynomial.aeval (fun i => Ideal.Quotient.mk 𝔡 (s i)) q := by
        intro s
        have h := DFunLike.congr_fun
          (MvPolynomial.ringHom_ext (f := (Ideal.Quotient.mk 𝔡).comp (MvPolynomial.eval s))
            (g := (MvPolynomial.aeval (R := R) (fun i => Ideal.Quotient.mk 𝔡 (s i))).toRingHom)
            (by intro a; simp [Ideal.Quotient.algebraMap_eq])
            (by intro i; simp)) q
        simpa using h
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, key r, key r', hfun, sub_self]
    -- the `R`-algebra map `A → B` determined by a solution `s`.
    have hlift : ∀ s : Fin n → R, (∀ i, MvPolynomial.eval s (P i) = 0) →
        ∃ g : A →ₐ[R] B, ∀ q, g (Ideal.Quotient.mk _ q) = algebraMap R B (MvPolynomial.eval s q) :=
      fun s hs => ⟨Ideal.Quotient.liftₐ _ (MvPolynomial.aeval (fun i => algebraMap R B (s i)))
        (hvanish s hs), fun q => by
          rw [Ideal.Quotient.liftₐ_apply, Ideal.Quotient.lift_mk]; exact aeval_algMap s q⟩
    obtain ⟨g₁, e1⟩ := hlift r hr
    obtain ⟨g₂, e2⟩ := hlift r' hr'
    set I : Ideal B := Ideal.map (algebraMap R B) 𝔡 with hI
    have hInil : IsNilpotent I := by
      refine ⟨2, ?_⟩; rw [hI, ← Ideal.map_pow]; exact Ideal.map_quotient_self _
    have hgeq : g₁ = g₂ := by
      apply Algebra.FormallyUnramified.ext I hInil
      intro x
      obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective x
      show Ideal.Quotient.mk I (g₁ (Ideal.Quotient.mk _ q))
        = Ideal.Quotient.mk I (g₂ (Ideal.Quotient.mk _ q))
      rw [e1, e2, ← sub_eq_zero, ← map_sub, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ (heval_cong q)
    intro i
    have heq : algebraMap R B (r i) = algebraMap R B (r' i) := by
      simpa [e1, e2] using DFunLike.congr_fun hgeq (Ideal.Quotient.mk _ (MvPolynomial.X i))
    rw [show algebraMap R B = Ideal.Quotient.mk (𝔡 ^ 2) from rfl] at heq
    rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem] at heq
    exact heq
  -- 𝔡 ⊆ 𝔡² ⊆ 𝔪·𝔡.
  have h1 : 𝔡 ≤ 𝔡 ^ 2 := by
    rw [h𝔡, Ideal.span_le]
    rintro x ⟨i, rfl⟩
    exact hdi_sq i
  have h2 : (𝔡 : Ideal R) ^ 2 ≤ IsLocalRing.maximalIdeal R • 𝔡 := by
    rw [pow_two, Ideal.mul_le]
    intro x hx y hy
    exact Submodule.smul_mem_smul (h𝔡m hx) hy
  exact le_trans h1 h2

open MvPolynomial in
/-- **Key uniqueness lemma (étale rigidity over a local ring).**
Two solutions `r, r'` of an étale presentation `P` over a local ring `R` that are
congruent coordinatewise modulo `𝔪_R` are equal. Reduces to
`span_range_sub_le_maximalIdeal_smul` followed by Nakayama's lemma. -/
theorem eq_of_sub_mem_maximalIdeal_of_etale
    {R : Type*} [CommRing R] [IsLocalRing R]
    (n : ℕ) (P : Fin n → MvPolynomial (Fin n) R)
    [Algebra.Etale R (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range P))]
    (r r' : Fin n → R)
    (hr : ∀ i, MvPolynomial.eval r (P i) = 0)
    (hr' : ∀ i, MvPolynomial.eval r' (P i) = 0)
    (hcong : ∀ i, r i - r' i ∈ IsLocalRing.maximalIdeal R) :
    r = r' := by
  set d : Fin n → R := fun i => r i - r' i with hd
  set 𝔡 : Ideal R := Ideal.span (Set.range d) with h𝔡
  -- It suffices to show 𝔡 = ⊥, since then every difference d i = 0.
  suffices h𝔡bot : 𝔡 = ⊥ by
    funext i
    have hmem : d i ∈ 𝔡 := by rw [h𝔡]; exact Ideal.subset_span ⟨i, rfl⟩
    rw [h𝔡bot, Ideal.mem_bot] at hmem
    have := sub_eq_zero.mp hmem
    simpa [hd] using this
  -- 𝔡 is finitely generated (spanned by the finite range of d).
  have hfg : 𝔡.FG := by
    rw [h𝔡, ← Set.image_univ]
    exact Submodule.fg_span (Set.Finite.image _ Set.finite_univ)
  -- JAC + TAYLOR core: 𝔡 ≤ 𝔪_R • 𝔡.
  have hquad : 𝔡 ≤ IsLocalRing.maximalIdeal R • 𝔡 :=
    span_range_sub_le_maximalIdeal_smul n P r r' hr hr' hcong
  -- Nakayama: a f.g. ideal 𝔡 with 𝔡 ≤ 𝔪 • 𝔡 over the local ring R is ⊥.
  have hjac_le : IsLocalRing.maximalIdeal R ≤ (⊥ : Ideal R).jacobson := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal R) bot_ne_top]
  exact Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ hfg hquad hjac_le

open MvPolynomial in
/-- **Injectivity half of Tag 04GX.**
The coordinatewise map `r ↦ (fun i => φ (r i))` is injective on the set of solutions of `P`
over `R`. If two `R`-solutions have the same image, then `φ` sends each difference
`r i - r' i` to `0`, so that difference cannot be a unit and therefore lies in `𝔪_R`; étale
rigidity (`eq_of_sub_mem_maximalIdeal_of_etale`) then forces `r = r'`. -/
theorem injOn_solutions_of_etale
    {R S : Type*} [CommRing R] [CommRing S]
    [HenselianLocalRing R] [HenselianLocalRing S]
    [IsSepClosed (IsLocalRing.ResidueField R)] [IsSepClosed (IsLocalRing.ResidueField S)]
    (φ : R →+* S)
    (n : ℕ) (P : Fin n → MvPolynomial (Fin n) R)
    [Algebra.Etale R (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range P))] :
    Set.InjOn (fun r : Fin n → R => (fun i => φ (r i) : Fin n → S))
      {r : Fin n → R | ∀ i, MvPolynomial.eval r (P i) = 0} := by
  -- DECOMPOSITION: (L1) φ local ⇒ r ≡ r' mod 𝔪_R coordinatewise; then the étale
  -- rigidity lemma `eq_of_sub_mem_maximalIdeal_of_etale` (JAC + TAYLOR + Nakayama).
  intro r hr r' hr' heq
  have hpt : ∀ i, φ (r i) = φ (r' i) := fun i => congrFun heq i
  -- (L1): each r i - r' i is a non-unit (φ sends it to 0), hence lies in 𝔪_R.
  have hcong : ∀ i, r i - r' i ∈ IsLocalRing.maximalIdeal R := by
    intro i
    have h0 : φ (r i - r' i) = 0 := by rw [map_sub, hpt i, sub_self]
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hunit : IsUnit (φ (r i - r' i)) := hu.map φ
    rw [h0] at hunit
    exact not_isUnit_zero hunit
  exact eq_of_sub_mem_maximalIdeal_of_etale n P r r' hr hr' hcong

open MvPolynomial TensorProduct in
/-- Base-change of a polynomial: `algebraTensorAlgEquiv` carries `1 ⊗ p`
(`includeRight p`) to the coefficientwise image `map (algebraMap R S) p`. -/
theorem algebraTensorAlgEquiv_includeRight {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (n : ℕ) (p : MvPolynomial (Fin n) R) :
    (MvPolynomial.algebraTensorAlgEquiv R S) (Algebra.TensorProduct.includeRight p)
      = MvPolynomial.map (algebraMap R S) p := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp []
  | mul_X p i hp => simp []

open MvPolynomial TensorProduct in
/-- The ideal of the base-changed presentation `span (range (map (algebraMap R S) ∘ P))`
equals the image, under `algebraTensorAlgEquiv`, of `span (range P)` pushed forward by
`includeRight`. This identifies the base-changed presentation ring with `S ⊗[R] (R-presentation)`.
-/
theorem span_range_map_eq_baseChange_span_range {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (n : ℕ) (P : Fin n → MvPolynomial (Fin n) R) :
    Ideal.span (Set.range (fun i => MvPolynomial.map (algebraMap R S) (P i))) =
    Ideal.map ((MvPolynomial.algebraTensorAlgEquiv R S (σ := Fin n)) :
        (S ⊗[R] MvPolynomial (Fin n) R) →+* MvPolynomial (Fin n) S)
      (Ideal.map ((Algebra.TensorProduct.includeRight :
        MvPolynomial (Fin n) R →ₐ[R] S ⊗[R] MvPolynomial (Fin n) R) :
        MvPolynomial (Fin n) R →+* S ⊗[R] MvPolynomial (Fin n) R) (Ideal.span (Set.range P))) := by
  rw [Ideal.map_map, Ideal.map_span]
  apply congrArg
  ext y
  simp only [Set.mem_range]
  refine ⟨?_, ?_⟩
  · rintro ⟨i, rfl⟩
    exact ⟨P i, ⟨i, rfl⟩, by simp⟩
  · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, by simp⟩

open MvPolynomial TensorProduct in
/-- **Étale descends along base change of the presentation.**
If the `R`-presentation `MvPolynomial (Fin n) R ⧸ span (range P)` is étale over `R`, then the
base-changed `S`-presentation
`MvPolynomial (Fin n) S ⧸ span (range (map (algebraMap R S) ∘ P))` is étale over `S`.
Proof: `Algebra.Etale.baseChange` makes `S ⊗[R] (R-presentation)` étale over `S`, and an
explicit `AlgEquiv` (built from `tensorQuotientEquiv`, `algebraTensorAlgEquiv` and
`Ideal.quotientEquivAlg` via `span_range_map_eq_baseChange_span_range`) identifies it with the
`S`-presentation; transport étaleness with `Algebra.Etale.of_equiv`. -/
theorem etale_baseChange_presentation {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (n : ℕ) (P : Fin n → MvPolynomial (Fin n) R)
    [Algebra.Etale R (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range P))] :
    Algebra.Etale S (MvPolynomial (Fin n) S ⧸
      Ideal.span (Set.range (fun i => MvPolynomial.map (algebraMap R S) (P i)))) := by
  have : Algebra.Etale S (S ⊗[R] (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range P))) :=
    Algebra.Etale.baseChange R _ S
  let e1 := Algebra.TensorProduct.tensorQuotientEquiv (R := R) S (MvPolynomial (Fin n) R) S
              (Ideal.span (Set.range P))
  let f := MvPolynomial.algebraTensorAlgEquiv R S (σ := Fin n)
  let e2 := Ideal.quotientEquivAlg
              (Ideal.map ((Algebra.TensorProduct.includeRight :
                MvPolynomial (Fin n) R →ₐ[R] S ⊗[R] MvPolynomial (Fin n) R))
                (Ideal.span (Set.range P)))
              (Ideal.span (Set.range (fun i => MvPolynomial.map (algebraMap R S) (P i))))
              f (span_range_map_eq_baseChange_span_range n P)
  exact Algebra.Etale.of_equiv (e1.trans e2)

open MvPolynomial in
/-- **Uniqueness over `S`.**
Two `S`-solutions of `map φ P` that are congruent coordinatewise modulo `𝔪_S` are equal.
This is `eq_of_sub_mem_maximalIdeal_of_etale` applied over `S`: the base-changed presentation
`MvPolynomial (Fin n) S ⧸ span (range (map φ ∘ P))` is étale over `S` by
`etale_baseChange_presentation`, and étale rigidity over the local ring `S` then forces
equality. -/
theorem eq_of_sub_mem_maximalIdeal_of_etale_map
    {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
    (φ : R →+* S) [IsLocalHom φ]
    (n : ℕ) (P : Fin n → MvPolynomial (Fin n) R)
    [Algebra.Etale R (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range P))]
    (s s' : Fin n → S)
    (hs : ∀ i, MvPolynomial.eval s (MvPolynomial.map φ (P i)) = 0)
    (hs' : ∀ i, MvPolynomial.eval s' (MvPolynomial.map φ (P i)) = 0)
    (hcong : ∀ i, s i - s' i ∈ IsLocalRing.maximalIdeal S) :
    s = s' := by
  -- Give `S` the `R`-algebra structure induced by the local hom `φ`, so that
  -- `algebraMap R S = φ` definitionally.
  let : Algebra R S := φ.toAlgebra
  -- The base-changed presentation `MvPolynomial (Fin n) S ⧸ span (range (map φ ∘ P))` is
  -- étale over `S`, via `etale_baseChange_presentation` (Algebra.Etale.baseChange + base-change
  -- iso).
  have : Algebra.Etale S (MvPolynomial (Fin n) S ⧸
      Ideal.span (Set.range (fun i => MvPolynomial.map (algebraMap R S) (P i)))) :=
    etale_baseChange_presentation n P
  -- `algebraMap R S = φ`, so `map (algebraMap R S) (P i) = map φ (P i)`.
  have hae : (algebraMap R S) = φ := rfl
  -- Apply the étale rigidity lemma `eq_of_sub_mem_maximalIdeal_of_etale` over the local ring `S`.
  exact eq_of_sub_mem_maximalIdeal_of_etale (R := S) n
    (fun i => MvPolynomial.map (algebraMap R S) (P i)) s s'
    (by intro i; rw [hae]; exact hs i)
    (by intro i; rw [hae]; exact hs' i)
    hcong

end
