import Section9.RVJacobianDerivations
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-! A coordinate derivation is bounded on a Gauss field generated by
unit variables. The bound is also the input to the integral reduction
of derivations on the lifted graph. -/

open MvPolynomial

namespace SpecialTransformations.Section9

variable {E K G ι : Type*} [Field E] [Field K] [Algebra E K]
variable [LinearOrderedCommGroupWithZero G]

/-- The coefficient lower bound on a Gauss evaluation, expressed in
multiplicative valuation order. -/
def IsGaussEvaluation (v : Valuation K G) (x : ι → K) : Prop :=
  ∀ (P : MvPolynomial ι E) d, d ∈ P.support →
    v (algebraMap E K (P.coeff d)) ≤ v (aeval x P)

private theorem value_natCast_le_one (v : Valuation K G) (n : ℕ) : v (n : K) ≤ 1 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Nat.cast_succ]
    exact v.map_add_le ih (by rw [map_one])

/-- Coordinate differentiation of a polynomial cannot increase its
Gauss size. -/
theorem value_pderiv_le_of_gauss (v : Valuation K G) (x : ι → K)
    (hx : ∀ i, v (x i) ≤ 1) (hGauss : IsGaussEvaluation (E := E) v x)
    (i : ι) (P : MvPolynomial ι E) :
    v (aeval x (pderiv i P)) ≤ v (aeval x P) := by
  classical
  have he : aeval x (pderiv i P) =
      ∑ d ∈ P.support, aeval x (pderiv i (monomial d (P.coeff d))) := by
    conv_lhs => rw [P.as_sum]
    rw [map_sum, map_sum]
  rw [he]
  apply v.map_sum_le
  intro d hd
  let s := d - Finsupp.single i 1
  have hs : v (s.prod fun j p => x j ^ p) ≤ 1 := by
    rw [Finsupp.prod, map_prod]
    apply Finset.prod_le_one₀ (fun _ _ => zero_le)
    intro j _
    rw [map_pow]
    exact pow_le_one₀ zero_le (hx j)
  rw [pderiv_monomial, aeval_monomial, map_mul, map_mul, map_mul, map_natCast]
  exact (mul_le_of_le_one_right zero_le hs).trans
    ((mul_le_of_le_one_right zero_le (value_natCast_le_one v (d i))).trans (hGauss P d hd))

/-- The derivative bound passes through quotients of evaluated
polynomials, giving integrality on the Gauss subfield. -/
theorem value_derivation_le_of_mem_gaussField [Fintype ι] [DecidableEq ι] (v : Valuation K G)
    (x : ι → K) (hx : ∀ i, v (x i) ≤ 1) (hGauss : IsGaussEvaluation (E := E) v x)
    (i : ι) (D : Derivation E K K) (hD : ∀ j, D (x j) = if i = j then 1 else 0)
    (z : K) (hz : z ∈ IntermediateField.adjoin E (Set.range x)) :
    v (D z) ≤ v z := by
  classical
  have hPoly (P : MvPolynomial ι E) : v (D (aeval x P)) ≤ v (aeval x P) := by
    have h := derivation_aeval_eq_sum D x P
    rw [h]
    have he : (∑ j, aeval x (pderiv j P) * D (x j)) = aeval x (pderiv i P) := by
      rw [Finset.sum_eq_single i]
      · simp [hD]
      · intro j _ hj
        simp [hD, Ne.symm hj]
      · simp
    rw [he]
    exact value_pderiv_le_of_gauss v x hx hGauss i P
  obtain ⟨P, Q, rfl⟩ := (IntermediateField.mem_adjoin_range_iff E x z).mp hz
  let p := aeval x P
  let q := aeval x Q
  change v (D (p / q)) ≤ v (p / q)
  by_cases hq : q = 0
  · rw [hq, div_zero, map_zero]
  have he : D (p / q) = (D p - (p / q) * D q) / q := by
    have h := D.leibniz (p / q) q
    rw [div_mul_cancel₀ _ hq, smul_eq_mul, smul_eq_mul] at h
    apply (eq_div_iff hq).mpr
    linear_combination h.symm
  rw [he, map_div₀, map_div₀]
  have hval : v (D p - (p / q) * D q) ≤ v p := by
    apply (v.map_sub _ _).trans
    apply max_le (hPoly P)
    rw [map_mul, map_div₀]
    apply (mul_le_mul_of_nonneg_left (hPoly Q) zero_le).trans
    rw [div_mul_cancel₀ _ (v.ne_zero_iff.mpr hq)]
  exact div_le_div_of_nonneg_right hval zero_le

/-- Under Gauss evaluation with unit coordinates, the value of a
polynomial is the value of one of its coefficients, including zero
when the polynomial is zero. -/
theorem exists_same_value_of_gaussPolynomial (v : Valuation K G) (x : ι → K)
    (hx : ∀ i, v (x i) ≤ 1) (hGauss : IsGaussEvaluation (E := E) v x)
    (P : MvPolynomial ι E) :
    ∃ c : E, v (aeval x P) = v (algebraMap E K c) := by
  classical
  by_cases hP : P = 0
  · exact ⟨0, by simp [hP]⟩
  obtain ⟨d, hd, hmax⟩ := Finset.exists_max_image P.support
    (fun d => v (algebraMap E K (P.coeff d)))
    (Finset.nonempty_iff_ne_empty.mpr (fun h => hP (support_eq_empty.mp h)))
  refine ⟨P.coeff d, le_antisymm ?_ (hGauss P d hd)⟩
  have he : aeval x P = ∑ e ∈ P.support, aeval x (monomial e (P.coeff e)) := by
    conv_lhs => rw [P.as_sum]
    rw [map_sum]
  rw [he]
  apply v.map_sum_le
  intro e he
  rw [aeval_monomial, map_mul]
  have hprod : v (e.prod fun i m => x i ^ m) ≤ 1 := by
    rw [Finsupp.prod, map_prod]
    apply Finset.prod_le_one₀ (fun _ _ => zero_le)
    intro i _
    rw [map_pow]
    exact pow_le_one₀ zero_le (hx i)
  exact (mul_le_of_le_one_right zero_le hprod).trans (hmax e he)

/-- Adjoining coordinates with Gauss evaluation contributes no new
values to the coefficient field. -/
theorem exists_same_value_of_mem_gaussField (v : Valuation K G) (x : ι → K)
    (hx : ∀ i, v (x i) ≤ 1) (hGauss : IsGaussEvaluation (E := E) v x)
    (z : K) (hz : z ∈ IntermediateField.adjoin E (Set.range x)) :
    ∃ c : E, v z = v (algebraMap E K c) := by
  obtain ⟨P, Q, rfl⟩ := (IntermediateField.mem_adjoin_range_iff E x z).mp hz
  obtain ⟨a, ha⟩ := exists_same_value_of_gaussPolynomial v x hx hGauss P
  obtain ⟨b, hb⟩ := exists_same_value_of_gaussPolynomial v x hx hGauss Q
  exact ⟨a / b, by rw [map_div₀, ha, hb, map_div₀, map_div₀]⟩

end SpecialTransformations.Section9
