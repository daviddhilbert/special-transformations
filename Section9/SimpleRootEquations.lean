set_option backward.isDefEq.respectTransparency false

/-!
# Simple polynomial equations over the original coefficient field

In characteristic zero, a coordinate algebraic over the field generated by
the inputs satisfies an equation whose partial derivative in that coordinate
is nonzero. Clearing denominators uses their values at the given input.
-/

namespace SpecialTransformations.Section9

open MvPolynomial

theorem exists_polynomial_clearDenominators
    {A F K : Type*} [CommRing A] [Field F] [Field K]
    (φ : A →+* K) (ψ : F →+* K)
    (h : ∀ c : F, ∃ a b : A, φ b ≠ 0 ∧ φ a = ψ c * φ b)
    (p : Polynomial F) :
    ∃ q : Polynomial A, ∃ b : A,
      φ b ≠ 0 ∧ q.map φ = Polynomial.C (φ b) * p.map ψ := by
  classical
  choose a b hb hab using fun i : ℕ => h (p.coeff i)
  let d := ∏ i ∈ p.support, b i
  let q := ∑ i ∈ p.support,
    Polynomial.monomial i (a i * ∏ j ∈ p.support.erase i, b j)
  have hd : φ d ≠ 0 := by
    rw [show d = _ from rfl, map_prod]
    exact Finset.prod_ne_zero_iff.mpr fun i _ => hb i
  refine ⟨q, d, hd, ?_⟩
  have hp := p.sum_monomial_eq
  rw [Polynomial.sum_def] at hp
  conv_rhs => rw [← hp]
  simp only [q, Polynomial.map_sum, Polynomial.map_monomial, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Polynomial.C_mul_monomial, map_mul, hab i, mul_assoc, ← map_mul,
    Finset.mul_prod_erase _ _ hi, mul_comm]

/-- A simple univariate equation with coefficients polynomial in the input
coordinates. Its specialization is a nonzero scalar times a minimal
polynomial. -/
theorem exists_specialized_simpleRoot
    {E K ι : Type*} [Field E] [Field K] [Algebra E K] [CharZero K]
    (x : ι → K) (y : K) (hy : IsAlgebraic (IntermediateField.adjoin E (Set.range x)) y) :
    ∃ q : Polynomial (MvPolynomial ι E),
      (q.map (aeval x).toRingHom).eval y = 0 ∧
        (q.map (aeval x).toRingHom).derivative.eval y ≠ 0 := by
  classical
  let F := IntermediateField.adjoin E (Set.range x)
  let p := minpoly F y
  have hcoeff (c : F) :
      ∃ a b : MvPolynomial ι E, aeval x b ≠ 0 ∧
        aeval x a = algebraMap F K c * aeval x b := by
    by_cases hc : algebraMap F K c = 0
    · exact ⟨0, 1, by simp, by simp [hc]⟩
    obtain ⟨a, b, hab⟩ :=
      (IntermediateField.mem_adjoin_range_iff E x (algebraMap F K c)).mp c.property
    have hb : aeval x b ≠ 0 := by
      intro he
      exact hc (by rw [hab, he, div_zero])
    exact ⟨a, b, hb, ((div_eq_iff hb).mp hab.symm)⟩
  obtain ⟨q, b, hb, hq⟩ :=
    exists_polynomial_clearDenominators (aeval (R := E) x).toRingHom (algebraMap F K) hcoeff p
  have hp : Polynomial.aeval y p = 0 := minpoly.aeval F y
  have hsep : p.Separable := (minpoly.irreducible hy.isIntegral).separable
  have hderiv := hsep.aeval_derivative_ne_zero hp
  refine ⟨q, ?_, ?_⟩
  · rw [hq, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_map,
      ← Polynomial.aeval_def, hp, mul_zero]
  · rw [hq, Polynomial.derivative_C_mul, Polynomial.derivative_map,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_map, ← Polynomial.aeval_def]
    exact mul_ne_zero hb hderiv

section OutputVariable

variable {E K ι : Type*} [Field E] [Field K] [Algebra E K]

noncomputable def putOutputVariable (q : Polynomial (MvPolynomial ι E)) :
    MvPolynomial (ι ⊕ Unit) E :=
  q.eval₂ (rename Sum.inl).toRingHom (X (Sum.inr ()))

theorem aeval_putOutputVariable (x : ι → K) (y : K)
    (q : Polynomial (MvPolynomial ι E)) :
    aeval (Sum.elim x (fun _ => y)) (putOutputVariable q) =
      (q.map (aeval x).toRingHom).eval y := by
  induction q using Polynomial.induction_on' with
  | add p q hp hq =>
      simpa only [putOutputVariable, Polynomial.eval₂_add, map_add, Polynomial.map_add, Polynomial.eval_add]
        using congrArg₂ (· + ·) hp hq
  | monomial i a =>
      simp [putOutputVariable, Polynomial.eval₂_monomial, Polynomial.eval_monomial,
        aeval_rename, Function.comp_def]

theorem aeval_pderiv_putOutputVariable (x : ι → K) (y : K)
    (q : Polynomial (MvPolynomial ι E)) :
    aeval (Sum.elim x (fun _ => y)) (pderiv (Sum.inr ()) (putOutputVariable q)) =
      (q.map (aeval x).toRingHom).derivative.eval y := by
  classical
  induction q using Polynomial.induction_on' with
  | add p q hp hq =>
      simpa only [putOutputVariable, Polynomial.eval₂_add, map_add, Polynomial.map_add,
        Polynomial.derivative_add, Polynomial.eval_add]
        using congrArg₂ (· + ·) hp hq
  | monomial i a =>
      have hz := Section7.pderiv_rename_eq_zero_of_notMem_range
        (Sum.inl : ι → ι ⊕ Unit) (i := Sum.inr ()) (by simp) a
      simp [putOutputVariable, Polynomial.eval₂_monomial, Polynomial.eval_monomial,
        Polynomial.derivative_monomial, hz,
        aeval_rename, Function.comp_def, mul_assoc]

/-- An algebraic output coordinate has a polynomial equation over the
original base whose output partial derivative is nonzero at the point. -/
theorem exists_simpleRoot_equation [CharZero K]
    (x : ι → K) (y : K) (hy : IsAlgebraic (IntermediateField.adjoin E (Set.range x)) y) :
    ∃ P : MvPolynomial (ι ⊕ Unit) E,
      aeval (Sum.elim x (fun _ => y)) P = 0 ∧
      aeval (Sum.elim x (fun _ => y)) (pderiv (Sum.inr ()) P) ≠ 0 := by
  obtain ⟨q, hq, hq'⟩ := exists_specialized_simpleRoot x y hy
  exact ⟨putOutputVariable q, (aeval_putOutputVariable x y q).trans hq,
    fun h => hq' ((aeval_pderiv_putOutputVariable x y q).symm.trans h)⟩

end OutputVariable

open FirstOrder FirstOrder.Language
open Milestone0 Milestone0.LRV Milestone0.Transfer
open Section3 Section4 DefinableGeometry

/-- The same construction over the section's generated VF field. -/
theorem exists_simpleRoot_equation_of_tupleField
    {K : Type} [Field K] [CharZero K] (E : Subfield K)
    {n : ℕ} (x : Fin n → K) (y : K) (hy : IsAlgebraic (tupleField E x) y) :
    ∃ P : MvPolynomial (Fin n ⊕ Unit) E,
      aeval (Sum.elim x (fun _ => y)) P = 0 ∧
      aeval (Sum.elim x (fun _ => y)) (pderiv (Sum.inr ()) P) ≠ 0 := by
  apply exists_simpleRoot_equation
  change IsAlgebraic (IntermediateField.adjoin E (Set.range x)).toSubfield y
  exact Eq.mp (congrArg (fun F : Subfield K => IsAlgebraic F y) (tupleField_eq_adjoin E x)) hy

/-- Apply the simple-root construction to a coordinate of a definable map
in the standing pure characteristic-zero model. -/
theorem exists_mapCoordinate_simpleRoot_equation
    {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF] [CharZero (VFType (M := M))]
    (hc : CanonicalStructure.IsCanonical (M := M)) {S : Set M} {n r m s : ℕ}
    {A : DefSet (rawMixedSpace (M := M) n r) S}
    {B : DefSet (rawMixedSpace (M := M) m s) S} (f : Map A B) (a : A) (j : Fin m) :
    ∃ P : MvPolynomial (Fin n ⊕ Unit) (vfParameterField S),
      aeval (Sum.elim a.val.1 (fun _ => (f a).val.1 j)) P = 0 ∧
      aeval (Sum.elim a.val.1 (fun _ => (f a).val.1 j)) (pderiv (Sum.inr ()) P) ≠ 0 :=
  exists_simpleRoot_equation_of_tupleField _ _ _ (map_output_vf_coordinate_isAlgebraic hc f a j)

end SpecialTransformations.Section9
