import Section9.DerivationExtension
import Mathlib.RingTheory.AlgebraicIndependent.Adjoin
import Mathlib.Algebra.MvPolynomial.PDeriv

/-! Coordinate derivations on the field generated by independent
coordinates. Mathlib identifies that field with a fraction field. -/

set_option backward.isDefEq.respectTransparency false

namespace SpecialTransformations.Section9

open MvPolynomial

/-- The coordinate derivations of a purely transcendental extension. -/
theorem exists_coordinate_derivation
    {E K ι : Type*} [Field E] [Field K] [Algebra E K] [DecidableEq ι]
    (x : ι → K) (hx : AlgebraicIndependent E x) (i : ι) :
    let F := IntermediateField.adjoin E (Set.range x)
    ∃ D : Derivation E F F, ∀ j : ι,
      D ⟨x j, IntermediateField.subset_adjoin E _ (Set.mem_range_self j)⟩ =
        if i = j then 1 else 0 := by
  let A := MvPolynomial ι E
  let T := FractionRing A
  let F := IntermediateField.adjoin E (Set.range x)
  let g : T ≃ₐ[E] F := hx.aevalEquivField
  let d : Derivation E A T := (Algebra.linearMap A T).compDer (pderiv i)
  letI : Algebra.FormallyEtale A T := Algebra.FormallyEtale.of_isLocalization
    (Rₘ := T) (nonZeroDivisors A)
  obtain ⟨D, hD⟩ := exists_derivation_formallyEtale d
  let D' : Derivation E F F :=
    { toLinearMap := g.toLinearMap.comp (D.toLinearMap.comp g.symm.toLinearMap)
      map_one_eq_zero' := by simp
      leibniz' := by
        intro a b
        change g (D (g.symm (a * b))) = a • g (D (g.symm b)) + b • g (D (g.symm a))
        rw [map_mul, D.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
          g.apply_symm_apply, g.apply_symm_apply, smul_eq_mul, smul_eq_mul] }
  refine ⟨D', fun j => ?_⟩
  have hg : g (algebraMap A T (X j)) =
      (⟨x j, IntermediateField.subset_adjoin E _ (Set.mem_range_self j)⟩ : F) := by
    apply Subtype.ext
    rw [show (g (algebraMap A T (X j))).val = aeval x (X j) from
      hx.aevalEquivField_algebraMap_apply_coe (X j)]
    exact aeval_X x j
  rw [← hg]
  change g (D (g.symm (g (algebraMap A T (X j))))) = _
  rw [g.symm_apply_apply, hD]
  change g (algebraMap A T (pderiv i (X j))) = _
  by_cases h : i = j
  · subst j
    simp
  · simp [h, pderiv_X_of_ne (Ne.symm h)]

end SpecialTransformations.Section9
