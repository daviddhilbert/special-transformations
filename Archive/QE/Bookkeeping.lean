import M5L34_36
import HullAudit

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0
open SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Milestone0.Transfer
open SpecialTransformations.Milestone0.RVCalc
open SpecialTransformations.Milestone0.Transc

namespace SpecialTransformations.Milestone0.Bookkeeping

variable {M : Type} [LRV.Structure M] [hM : M ⊨ Axioms.ACVF]

/-! ## 1. The two generator forms of Claim (⋆) -/

/-- **The `ℕ`-monomial span of `RV(S)` and `ε`.**  `y` is `Cls`-equal to `s · ε^j` with `s` an
`RV`-element of `S` and `j : ℕ`: the encoding's reading of the monomials of `⟨RV(Ŝ), rv(e)⟩`, at
the `Γ`-class level at which the route consumes Claim (⋆) (`Cls` is `RV/Kˣ`-equality). -/
def RVNatSpanCls (S : LRV.Substructure M) (ε y : M) : Prop :=
  ∃ (j : ℕ) (s : M), s ∈ S ∧ iRV s ∧ Cls y (iRVMul (rvpow ε j) s)

/-- **`RV(⟨Ŝ,e⟩) ⊆ ⟨RV(Ŝ), rv(e)⟩`** at the class level, for an extension `S ≤ T`: every
`RV`-element of `T` is the class of a monomial `s · ε^j`. -/
def RVGenCover (S T : LRV.Substructure M) (ε : M) : Prop :=
  ∀ y : M, y ∈ T → iRV y → RVNatSpanCls S ε y

/-- **The group span of `RV(S)` and `ε`**, through a chosen inverse witness `d` (`ε · d = 1` in
`RV`): `y` is `Cls`-equal to `s · ε^a · d^b` with `a b : ℕ`.  This is the paper's
`⟨RV(Ŝ), rv(e)⟩` as a *group*, written with the two generators `ε` and `d` because the encoding
has no inverse symbol: exponents of either sign are `ε^a · d^b`. -/
def RVIntSpanCls (S : LRV.Substructure M) (ε d y : M) : Prop :=
  ∃ (a b : ℕ) (s : M), s ∈ S ∧ iRV s ∧
    Cls y (iRVMul (iRVMul (rvpow ε a) (rvpow d b)) s)

/-- **`RV∖{0}(S)` is a group**: every `RV`-element of `S` has an `RV`-inverse in `S`.  This is the
paper's WLOG for substructures (`qe.tex:489`); in the frozen encoding it is a *hypothesis*, since
`S` is closed under the function symbol `rvMul` only, not under the choice witness `iRVInv`. -/
def RVInvClosedOn (S : LRV.Substructure M) : Prop :=
  ∀ t : M, t ∈ S → iRV t → t ≠ iRVZero →
    ∃ d : M, d ∈ S ∧ iRV d ∧ iRVMul t d = iRVOne

/-! ## 2. The closure of `S` under the monomial span

`S` contains every `RV`-power of a class it contains (`M5L.rvpow_mem_sub`) and is closed under
`rvMul`; the two lemmas below turn that into membership in `S` for the monomials of §1, and
`M5L.mem_of_cls_mem` upgrades `Cls`-equality of `RV`-elements to membership once `S` contains all
units (`Assembly.KEqTop`, the `K(Ŝ) = K(M)` half of `Assembly.Standing`). -/

/-- Powers of an `RV`-element of `S` stay in `S` (`S` is closed under `rvOne` and `rvMul`).  This is
the general form of `M5L.rvpow_mem_sub`, which is stated for `ε = iRv e`. -/
theorem rvpow_mem_of_mem {S : LRV.Substructure M} {ε : M} (_hε : iRV ε) (hεS : ε ∈ S) (j : ℕ) :
    rvpow ε j ∈ S := by
  induction j with
  | zero => exact M5L.rvOne_mem_sub S
  | succ k ih =>
    show iRVMul (rvpow ε k) ε ∈ S
    exact M5L.rvMul_mem_sub S ih hεS

/-- `ε^j · s` is an `RV`-element of `S` when `ε, s ∈ S ∩ RV`. -/
theorem rvPow_mul_mem {S : LRV.Substructure M} {ε s : M} (hε : iRV ε) (hεS : ε ∈ S)
    (hs : s ∈ S) (hsrv : iRV s) (j : ℕ) :
    iRVMul (rvpow ε j) s ∈ S ∧ iRV (iRVMul (rvpow ε j) s) :=
  ⟨M5L.rvMul_mem_sub S (rvpow_mem_of_mem hε hεS j) hs,
    rv_mul_mem hM (iRV_rvpow hM hε j) hsrv⟩

/-- **`⟨RV(Ŝ), rv(e)⟩ ⊆ RV(S)`, `ℕ`-form.**  Every class in the monomial span of `RV(S)` and `ε`
is the class of an element of `S` — the first inclusion of the paper's Claim (⋆). -/
theorem rvNatSpanCls_mem {S : LRV.Substructure M} (hK : Assembly.KEqTop S) {ε y : M}
    (hε : iRV ε) (hεS : ε ∈ S) (hy : iRV y) (h : RVNatSpanCls S ε y) : y ∈ S := by
  obtain ⟨j, s, hsS, hsrv, hcls⟩ := h
  obtain ⟨hmem, hrv⟩ := rvPow_mul_mem (M := M) (S := S) hε hεS hsS hsrv j
  exact M5L.mem_of_cls_mem hM hK hy hrv hcls hmem

/-- **`⟨RV(Ŝ), rv(e)⟩ ⊆ RV(S)`, group form.**  Every class in the group span of `RV(S)` and
`ε`, `d` is the class of an element of `S`, whenever both generators are in `S` — the paper's
Claim (⋆) with the group `⟨RV(Ŝ), rv(e)⟩` of `qe.tex:606` in place of the monoid. -/
theorem rvIntSpanCls_mem {S : LRV.Substructure M} (hK : Assembly.KEqTop S) {ε d y : M}
    (hε : iRV ε) (hd : iRV d) (hεS : ε ∈ S) (hdS : d ∈ S) (hy : iRV y)
    (h : RVIntSpanCls S ε d y) : y ∈ S := by
  obtain ⟨a, b, s, hsS, hsrv, hcls⟩ := h
  have hmem : iRVMul (iRVMul (rvpow ε a) (rvpow d b)) s ∈ S :=
    M5L.rvMul_mem_sub S
      (M5L.rvMul_mem_sub S (rvpow_mem_of_mem hε hεS a) (rvpow_mem_of_mem hd hdS b)) hsS
  have hrv : iRV (iRVMul (iRVMul (rvpow ε a) (rvpow d b)) s) :=
    rv_mul_mem hM (rv_mul_mem hM (iRV_rvpow hM hε a) (iRV_rvpow hM hd b)) hsrv
  exact M5L.mem_of_cls_mem hM hK hy hrv hcls hmem

/-- **The `ℤ`-form and the `ℕ`-form of the generator statement coincide** as soon as the inverse
witness of `ε` lies in `S`: a negative exponent only ever names an element of `S` that the
`ℕ`-form reaches with exponent `0`.  This is `qe.tex:489`'s "`RV^×(S)` is a group" at work —
the reason the paper may write the group `⟨RV(Ŝ), rv(e)⟩` where the encoding has only monomials. -/
theorem rvGenCover_iff_rvIntCover {S T : LRV.Substructure M} {ε d : M} (hε : iRV ε) (hd : iRV d)
    (hεS : ε ∈ S) (hdS : d ∈ S) :
    (∀ y : M, y ∈ T → iRV y → RVIntSpanCls S ε d y) ↔ RVGenCover S T ε := by
  constructor
  · intro h y hyT hyrv
    obtain ⟨a, b, s, hsS, hsrv, hcls⟩ := h y hyT hyrv
    have hmem : iRVMul (iRVMul (rvpow ε a) (rvpow d b)) s ∈ S :=
      M5L.rvMul_mem_sub S
        (M5L.rvMul_mem_sub S (rvpow_mem_of_mem hε hεS a) (rvpow_mem_of_mem hd hdS b)) hsS
    have hrv : iRV (iRVMul (iRVMul (rvpow ε a) (rvpow d b)) s) :=
      rv_mul_mem hM (rv_mul_mem hM (iRV_rvpow hM hε a) (iRV_rvpow hM hd b)) hsrv
    refine ⟨0, iRVMul (iRVMul (rvpow ε a) (rvpow d b)) s, hmem, hrv, ?_⟩
    show Cls y (iRVMul iRVOne (iRVMul (iRVMul (rvpow ε a) (rvpow d b)) s))
    rw [rv_mul_one_any hM hrv]
    exact hcls
  · intro h y hyT hyrv
    obtain ⟨j, s, hsS, hsrv, hcls⟩ := h y hyT hyrv
    refine ⟨j, 0, s, hsS, hsrv, ?_⟩
    show Cls y (iRVMul (iRVMul (rvpow ε j) iRVOne) s)
    rw [rv_mul_one_any_right hM (iRV_rvpow hM hε j)]
    exact hcls

/-! ## 2b. The named form is not a strengthening of the class form

`M5L.ResidualClasses S T` is "every class of `T` is a class of an element of `S`".  At the slot's
hypothesis `iRv m ∈ S` the two forms below are equivalent, so §1 does not strengthen Claim (⋆). -/

/-- **The named form gives the class form** (take the monomial apart with `rvMul`-closure). -/
theorem residualClasses_of_rvGenCover {S T : LRV.Substructure M} {ε : M} (hε : iRV ε)
    (hεS : ε ∈ S) (h : RVGenCover S T ε) : M5L.ResidualClasses S T := by
  intro y hyT hyrv
  obtain ⟨j, s, hsS, hsrv, hcls⟩ := h y hyT hyrv
  obtain ⟨hmem, hrv⟩ := rvPow_mul_mem (M := M) (S := S) hε hεS hsS hsrv j
  exact ⟨iRVMul (rvpow ε j) s, hmem, hrv, hcls⟩

/-- **The class form gives the named form** (`j = 0`, i.e. `ε^0 = 1`). -/
theorem rvGenCover_of_residualClasses {S T : LRV.Substructure M} {ε : M} (_hε : iRV ε)
    (_hεS : ε ∈ S) (h : M5L.ResidualClasses S T) : RVGenCover S T ε := by
  intro y hyT hyrv
  obtain ⟨s, hsS, hsrv, hcls⟩ := h y hyT hyrv
  refine ⟨0, s, hsS, hsrv, ?_⟩
  show Cls y (iRVMul iRVOne s)
  rwa [rv_mul_one_any hM hsrv]

/-- **Claim (⋆) is the same statement in both readings**: at the slot's hypothesis `rv(e) ∈ RV(S)`
the class form `M5L.ResidualClasses` and the named-generator form `RVGenCover S T (rv e)` are
equivalent. -/
theorem rvGenCover_iff_residualClasses {S T : LRV.Substructure M} {ε : M} (hε : iRV ε)
    (hεS : ε ∈ S) : RVGenCover S T ε ↔ M5L.ResidualClasses S T :=
  ⟨residualClasses_of_rvGenCover hε hεS, rvGenCover_of_residualClasses hε hεS⟩

/-! ## 3. The `Γ`-side

`GammaDiv.GammaEqQ S T` is `Γ(T) ⊆ Γ(S)` in quotient form.  Two consequences are recorded:
`HullAudit.gammaSub` — the subgroup of `Γ(M)` generated by the classes of `S`, i.e. the encoding's
`Γ(Ŝ)` — is equal for `S` and `T` (the paper's `Γ(⟨Ŝ,e⟩) = Γ(Ŝ)` as an equality of groups), and the
ledger's representative form `M5Ledger.GammaEq` holds. -/

/-- The image form of `GammaDiv.GammaEqQ`: `Γ(T) ⊆ Γ(S)` as subsets of `Γ(M)`. -/
theorem gammaImage_subset_of_gammaEqQ {S T : LRV.Substructure M} (h : GammaDiv.GammaEqQ S T) :
    GammaDiv.GammaImage (M := M) T ⊆ GammaDiv.GammaImage (M := M) S := by
  rintro q ⟨t, ht, hrv, ht0, rfl⟩
  obtain ⟨s, hs, hsrv, hs0, heq⟩ := h t ht hrv ht0
  exact ⟨s, hs, hsrv, hs0, heq⟩

/-- Conversely, a pointwise-subset statement *is* `GammaEqQ`. -/
theorem gammaEqQ_of_gammaImage_subset {S T : LRV.Substructure M}
    (h : GammaDiv.GammaImage (M := M) T ⊆ GammaDiv.GammaImage (M := M) S) :
    GammaDiv.GammaEqQ S T := by
  intro t ht hrv ht0
  obtain ⟨s, hs, hsrv, hs0, heq⟩ := h ⟨t, ht, hrv, ht0, rfl⟩
  exact ⟨s, hs, hsrv, hs0, heq⟩

/-- **`Γ(⟨Ŝ,e⟩) = Γ(Ŝ)` as an equality of subgroups of `Γ(M)`.**  `HullAudit.gammaSub` is the
subgroup generated by the value classes of `S`; it is the paper's `Γ(Ŝ)` when `RV(S)` is generated
by `rv(VF(S))` (`Assembly.IsVFGen S` with `RVInvClosedOn S`), and an upper bound in general.  With
that reading the paper's equality is `gammaSub T = gammaSub S`, and its content is `GammaEqQ S T`
plus monotonicity. -/
theorem gammaSub_eq_of_gammaEqQ {S T : LRV.Substructure M} (hST : S ≤ T)
    (h : GammaDiv.GammaEqQ S T) :
    HullAudit.gammaSub (M := M) T = HullAudit.gammaSub (M := M) S := by
  refine le_antisymm ?_ (HullAudit.gammaSub_mono hST)
  refine AddSubgroup.closure_mono ?_
  rintro x ⟨q, hq, rfl⟩
  exact ⟨q, gammaImage_subset_of_gammaEqQ h hq, rfl⟩

/-- **The class form of Claim (⋆) is exactly `Γ(T) ⊆ Γ(S)`.**  `M5L.ResidualClasses` needs no
unit-closure hypothesis: it already names the representative in `S`. -/
theorem gammaEqQ_of_residualClasses {S T : LRV.Substructure M}
    (h : M5L.ResidualClasses S T) : GammaDiv.GammaEqQ S T := by
  intro t ht hrv ht0
  obtain ⟨s, hsS, hsrv, hcls⟩ := h t ht hrv
  have hs0 : s ≠ iRVZero := fun hs => ht0 (by
    rw [hs] at hcls
    exact le_infty_eq hM hrv hcls.2)
  refine ⟨s, hsS, hsrv, hs0, ?_⟩
  rw [GammaGroup.gammaMk_eq_iff_le]
  exact hcls

/-- **The ledger's first `Γ`-conjunct** (`M5Ledger.GammaEq`, representative form) from the class
form of Claim (⋆). -/
theorem gammaEq_of_residualClasses {S T : LRV.Substructure M}
    (h : M5L.ResidualClasses S T) : M5Ledger.GammaEq S T :=
  (GammaDiv.gammaEq_iff_gammaMk S T).mpr (gammaEqQ_of_residualClasses h)

/-- **The ledger's hull clamp** (`M5Ledger.GammaHullInitial`) from the class form of Claim (⋆):
the `n = 1` case, so the bookkeeping half is at least as strong as the `Γ`-side of
`DivisibilityStep`. -/
theorem gammaHullInitial_of_residualClasses {S T : LRV.Substructure M}
    (h : M5L.ResidualClasses S T) : M5Ledger.GammaHullInitial S T :=
  GammaDiv.gammaHullInitial_of_gammaEq (gammaEq_of_residualClasses h)

/-- **In the separated case the divisible-hull clamp is vacuous.**  `HullAudit.divisibilityStep_pins_hull`
says that `DivisibilityStep`'s two `Γ`-conjuncts pin `gammaSub T` to be `divHull (gammaSub S)`.
If the extension does not change the value group (`GammaEqQ S T`) and `Γ(S)` is divisible
(`Assembly.GammaDivisible S`, half of `Standing S`), then `gammaSub T` *is* that hull already —
`divHull` of a root-closed subgroup is the subgroup itself.  So in the separated branch Claim (⋆)
delivers the paper's `Γ(S*) =` divisible hull of `Γ(S)` for free, and the hull work of
`DivisibilityStep` is only needed for the new-`rv` branch (`M5.OneStepRVNew`). -/
theorem divHull_gammaSub_of_gammaEqQ {S T : LRV.Substructure M} (hST : S ≤ T)
    (hdivS : Assembly.GammaDivisible S) (h : GammaDiv.GammaEqQ S T) :
    Ultramath.M2.divHull (HullAudit.gammaSub (M := M) S) = HullAudit.gammaSub (M := M) T := by
  rw [gammaSub_eq_of_gammaEqQ hST h]
  refine le_antisymm ?_ (Ultramath.M2.le_divHull _)
  exact Ultramath.M2.divHull_le le_rfl (HullAudit.rootClosed_gammaSub_of_gammaDivisible hdivS)

/-- The same with the hull clamp's own output, so the two `Γ`-conjuncts of `DivisibilityStep` are
seen to coincide in the separated branch. -/
theorem gammaHullInitial_and_pins_hull_of_gammaEqQ {S T : LRV.Substructure M} (hST : S ≤ T)
    (hS : Assembly.Standing S) (hdivT : Assembly.GammaDivisible T) (h : GammaDiv.GammaEqQ S T) :
    M5Ledger.GammaHullInitial S T ∧
      HullAudit.gammaSub (M := M) T = Ultramath.M2.divHull (HullAudit.gammaSub (M := M) S) :=
  ⟨GammaDiv.gammaHullInitial_of_gammaEq ((GammaDiv.gammaEq_iff_gammaMk S T).mpr h),
    (divHull_gammaSub_of_gammaEqQ hST hS.2 h).symm ▸ rfl⟩

/-! ## 3b. The paper's WLOG (`qe.tex:489`), machine-checked

"For a substructure `S` ... we always assume that, without loss of generality, `VF(S)` is a field
and `RV^×(S)` is a group."  In the tree the first is `M5L.VFInvClosedOn S` and the second is
`RVInvClosedOn S`; the implication between them needs `Assembly.IsVFGen S` (every `RV`-element of
`S` is `rv` of a `VF`-element of `S`, up to `rv 0`), which is Remark 3.1's VF-generatedness at the
extension (`Assembly.IsVFGen T` is already a hypothesis of `M5L.ResidualClasses_of_VFGen`) but is
*not* a theorem about arbitrary substructures. -/

/-- **The paper's WLOG, machine-checked.**  If `VF(S)` is a field and `S` is `VF`-generated, then
`RV∖{0}(S)` is a group: for `t = rv x` with `x ∈ S`, the field inverse of `x` has its `rv`-class in
`S`, and `rv(x · x⁻¹) = rv 1`. -/
theorem rvInvClosedOn_of_VFInvClosedOn {S : LRV.Substructure M} (hgen : Assembly.IsVFGen S)
    (hfinv : M5L.VFInvClosedOn S) : RVInvClosedOn S := by
  intro t htS hrv ht0
  rcases hgen t htS hrv with ⟨x, hxS, hxvf, hxr⟩ | hz
  · have hx0 : x ≠ iVFZero := fun h => ht0 (by rw [← hxr, h]; exact rv_zero_eq hM)
    obtain ⟨y, hyvf, hyS, hxy⟩ := hfinv x hxvf (by rw [hxr]; exact htS) hx0
    refine ⟨iRv y, hyS, rv_mem hM hyvf, ?_⟩
    rw [← hxr, ← rv_mul_hom_of_model hM hxvf hyvf, hxy, rv_one hM]
  · exact absurd hz ht0

/-- **The exact gap of the converse.**  `RV`-inverse-closure alone recovers, for `x ∈ S ∩ VF^×`,
only a `y ∈ S ∩ VF` with `v(x·y) = 0` (equivalently `iUnits (rv (x·y))`, i.e. `x·y ∈ O ∖ m`), not
`x·y = 1`.  The missing content is exactly the passage from `rv(x·y) = rv 1` to `x·y = 1`, which
is `VF`-level — an element of `1 + m` — and is why `M5L.VFInvClosedOn` is a hypothesis of the
separated slot and not a consequence of `Standing`. -/
theorem exists_unit_product_of_rvInvClosedOn {S : LRV.Substructure M} (hgen : Assembly.IsVFGen S)
    (h : RVInvClosedOn S) {x : M} (hxS : x ∈ S) (hxvf : iVF x) (hx0 : x ≠ iVFZero) :
    ∃ y : M, y ∈ S ∧ iVF y ∧ iUnits (iRv (iVFMul x y)) := by
  have hxrv : iRV (iRv x) := rv_mem hM hxvf
  have hxrv0 : iRv x ≠ iRVZero := fun hz => hx0 (vf_eq_zero_of_rv_eq_zero hM hxvf hz)
  obtain ⟨d, hdS, hdrv, hdt⟩ := h (iRv x) (M5L.rv_mem_sub S hxS) hxrv hxrv0
  rcases hgen d hdS hdrv with ⟨y, hyS, hyvf, hyr⟩ | hz
  · refine ⟨y, hyS, hyvf, ?_⟩
    have h1 : iRv (iVFMul x y) = iRVOne := by
      rw [rv_mul_hom_of_model hM hxvf hyvf, hyr]
      exact hdt
    rw [h1]
    exact (units_iff_le_one hM (rv_one_mem hM) (rv_one_ne_zero hM)).mpr
      ⟨le_refl_rv hM (rv_one_mem hM), le_refl_rv hM (rv_one_mem hM)⟩
  · exact absurd hz (fun hz0 => rv_one_ne_zero hM (by
      rw [hz0, rv_mul_zero_right_of_model hM hxrv] at hdt
      exact hdt.symm))

/-! ## 4. The assembled bookkeeping half and the stress tests -/

/-- **The bookkeeping half of Lemma 3.4, assembled at a fixed pair.**  At the paper's hypotheses —
the separation hypothesis `vv(e^k) ∉ Γ(Ŝ)` (`M5L.Separated`), `rv(e) ∈ RV(S)`, and the two
structural facts the paper has for free (`Assembly.IsVFGen T` from Remark 3.1, `QuotExpansions` from
`qe.tex:645`) — the three `Γ`/`RV` conclusions hold, with **no** henselianity, irreducibility,
root-lift or embedding:

* `Γ(T) = Γ(S)`: `GammaEqQ S T` and the subgroup equality `gammaSub T = gammaSub S`;
* `RV(T) ⊆ RV(S)`: `ResidualClasses S T`, in both the class form and the named-monomial form
  `RVGenCover S T (rv e)`, together with the paper's `RV∖{0}(S)`-is-a-group conclusion.

The only unproved input is the *representation* of the extension (`IsVFGen`, `QuotExpansions`,
`VFInvClosedOn`), which is exactly what `M5L.ResidualClasses_of_VFGen` isolates. -/
theorem bookkeeping_half {S T : LRV.Substructure M} {e : M} (hST : S ≤ T)
    (hS : Assembly.Standing S) (hfinv : M5L.VFInvClosedOn S) (he : iVF e)
    (he0 : e ≠ iVFZero) (heS : iRv e ∈ S) (hsep : M5L.Separated S e)
    (hgen : Assembly.IsVFGen T) (hquot : M5L.QuotExpansions S T e) :
    Assembly.Standing T ∧ GammaDiv.GammaEqQ S T ∧
      HullAudit.gammaSub (M := M) T = HullAudit.gammaSub (M := M) S ∧
      RVGenCover S T (iRv e) ∧ M5L.ResidualClasses S T := by
  have hres : M5L.ResidualClasses S T :=
    M5L.ResidualClasses_of_VFGen hM hS.1 hfinv he he0 heS hsep hgen hquot
  have hstand : Assembly.Standing T :=
    M5L.standing_of_paper_hypotheses hM hST hS hfinv he he0 heS hsep hgen hquot
  have hgamma : GammaDiv.GammaEqQ S T := gammaEqQ_of_residualClasses hres
  exact ⟨hstand, hgamma, gammaSub_eq_of_gammaEqQ hST hgamma,
    (rvGenCover_iff_residualClasses (rv_mem hM he) heS).mpr hres, hres⟩

/-! **In the separated branch the paper's WLOG cannot be recovered from `VF`-generatedness.**
`rvInvClosedOn_of_VFInvClosedOn` derives "`RV∖{0}(S)` is a group" from `Assembly.IsVFGen S` and
`M5L.VFInvClosedOn S`, but the separated branch *refutes* `IsVFGen S`
(`not_separated_of_isVFGen`), so the group form of Claim (⋆) (`rvIntSpanCls_mem`) has to carry
`RVInvClosedOn S` as an extra hypothesis there — and by `root_closed_not_neg_closed` that is not a
consequence of Γ-divisibility either.  This is why `bookkeeping_half` concludes the `ℕ`-monomial
form `RVGenCover` (which needs no inverses) rather than the group form, and why no variant of
`bookkeeping_half` with `IsVFGen S` is stated: its hypotheses would be inconsistent (see
`separated_hypotheses_inconsistent` in §4.iii″). -/

/-- **The residue-field half is invisible to `Cls`**: every unit (`Kˣ`) is `Cls`-equal to `1`.
This is why `K(⟨Ŝ,e⟩) = K(Ŝ)(rv e)` never enters the `Γ`-class bookkeeping above: `Cls` is `Γ`-equality
and `Γ = RV/Kˣ`.  It is needed only at the `RV`-element level (`f*(rv e) = f(rv e)`, p3). -/
theorem cls_one_of_iUnits {c : M} (hc : iUnits c) : Cls c iRVOne := by
  have hrv : iRV c := Jm2.iRV_of_inK (Or.inl hc)
  have h0 : c ≠ iRVZero := GammaGroup.units_ne_zero hc
  obtain ⟨h1, h2⟩ := (units_iff_le_one hM hrv h0).mp hc
  exact ⟨h2, h1⟩

/-! ### 4.i Non-vacuity of the WLOG hypotheses -/

/-- `RV(⊤)` is `VF`-generated: it is `rv` of `VF(⊤)` on the nose (`Axioms.rvSurj`, through
`Assembly.RVeqRvVF_of_model`). -/
theorem isVFGen_top : Assembly.IsVFGen (⊤ : LRV.Substructure M) := by
  intro x _ hxRV
  rcases Assembly.RVeqRvVF_of_model (M := M) x hxRV with ⟨y, hyvf, hyr⟩ | hz
  · exact Or.inl ⟨y, trivial, hyvf, hyr⟩
  · exact Or.inr hz

/-- `VF(⊤)` is a field: every nonzero element has a multiplicative inverse (the axiom
`vf_mul_inv_or_zero`). -/
theorem VFInvClosedOn_top : M5L.VFInvClosedOn (⊤ : LRV.Substructure M) := by
  intro x hx _ hx0
  obtain h0 | ⟨y, hyvf, hxy⟩ := vf_mul_inv_or_zero hM hx
  · exact absurd h0 hx0
  · exact ⟨y, hyvf, trivial, hxy⟩

/-- `RV∖{0}(⊤)` is a group, from the two hypotheses of §3b at `S = ⊤`. -/
theorem RVInvClosedOn_top : RVInvClosedOn (⊤ : LRV.Substructure M) :=
  rvInvClosedOn_of_VFInvClosedOn isVFGen_top VFInvClosedOn_top

/-! ### 4.ii The conclusions at the degenerate point -/

/-- The named form is satisfiable at the trivial extension: every class of `⊤` is `ε^0 · y`. -/
theorem rvGenCover_top (ε : M) (hε : iRV ε) :
    RVGenCover (⊤ : LRV.Substructure M) (⊤ : LRV.Substructure M) ε := by
  intro y _ hyrv
  refine ⟨0, y, trivial, hyrv, ?_⟩
  show Cls y (iRVMul iRVOne y)
  rw [rv_mul_one_any hM hyrv]
  exact cls_refl hM hyrv

/-- The class form at the trivial extension `S = T` (it does not ask for new elements). -/
theorem residualClasses_self (S : LRV.Substructure M) : M5L.ResidualClasses S S :=
  fun _ hy hyrv => ⟨_, hy, hyrv, cls_refl hM hyrv⟩

/-- `Γ(S) = Γ(S)` in the subgroup form — the paper's `Γ(⟨Ŝ,e⟩) = Γ(Ŝ)` at the degenerate case, as
`gammaSub_eq_of_gammaEqQ` reads it. -/
theorem gammaSub_eq_self (S : LRV.Substructure M) :
    HullAudit.gammaSub (M := M) S = HullAudit.gammaSub (M := M) S :=
  rfl

/-! ### 4.iii The separation hypothesis is a genuine restriction -/

/-- **Stress test: `Separated ⊤ e` is false.**  `M5L.Separated S e` says that no power
`(rv e)^k · x` (`k > 0`, `x ∈ RV(S)`) has the class of an element of `S` — at `S = ⊤` the witness
`x = 1`, `y = e` refutes it.  So the separation hypothesis is not a tautology at the top. -/
theorem not_separated_top {e : M} (he : iVF e) (he0 : e ≠ iVFZero) :
    ¬ M5L.Separated (⊤ : LRV.Substructure M) e := by
  intro h
  have hmem : ∀ x : M, x ∈ (⊤ : LRV.Substructure M) := fun _ => trivial
  have heRV : iRV (iRv e) := rv_mem hM he
  have hcls : Cls (iRVMul (rvpow (iRv e) 1) (iRv (iVFOne (M := M)))) (iRv e) := by
    have h1 : rvpow (iRv e) 1 = iRv e := by
      show iRVMul (rvpow (iRv e) 0) (iRv e) = iRv e
      rw [show rvpow (iRv e) 0 = iRVOne from rfl, rv_mul_one_any hM heRV]
    rw [h1, rv_one hM, rv_mul_one_any_right hM heRV]
    exact cls_refl hM heRV
  exact h 1 (by norm_num) (iVFOne (M := M)) e (vf_one_mem hM) he (hmem _) (hmem _)
    (RVCalc.vf_zero_ne_one hM).symm he0 hcls

/-! ### 4.iii′ The unit case: `M5L.Separated` is *false* for Lemma 3.4's actual data

Lemma 3.4 assumes `e ∈ U(M)`, i.e. `iUnits (rv e)`: then `vv(e^k) = 0 = vv(1) ∈ Γ(Ŝ)` for every
`k > 0`, so the separation hypothesis `M5L.Separated` — which is the hypothesis of the tree's
leading-term computation (`M5L.rvPoly_mem_of_separated`) — is **refuted** by the witnesses
`k = 1`, `x = y = 1`.  Consequently `bookkeeping_half` above is the bookkeeping of the *separated*
route (Lemmas 3.5/3.6-style value computations) and does **not** cover Lemma 3.4; in the unit case
the class-level bookkeeping reduces to the single conjunct `M5L.ResidualClasses S T`
(`unit_bookkeeping_reduction`), which the merged tree cannot supply because
`M5L.ResidualClasses_of_VFGen` needs `Separated`.  This cross-checks m1's board finding
(`smw2mluv7/m1/Case34Slot.lean`, `not_separated_of_units`) from the bookkeeping side. -/

/-- `iVFOne` lies in every substructure (it is the constant symbol `Fn.vfOne`). -/
theorem vfOne_mem_sub (S : LRV.Substructure M) : iVFOne (M := M) ∈ S :=
  S.fun_mem Fn.vfOne (fun i => i.elim0) (fun i => i.elim0)

/-- **A unit is never separated.**  If `e` is a unit of the valuation ring (`iUnits (rv e)`), then
`(rv e)^k · 1` has the class of `1`, so `M5L.Separated S e` fails at `k = 1`, `x = y = 1`. -/
theorem not_separated_of_iUnits {S : LRV.Substructure M} {e : M} (he : iVF e)
    (hu : iUnits (iRv e)) : ¬ M5L.Separated S e := by
  intro h
  have hrv : iRV (iRv e) := rv_mem hM he
  have h0 : iRv e ≠ iRVZero := GammaGroup.units_ne_zero hu
  have hcls : Cls (iRv e) iRVOne := by
    obtain ⟨h1, h2⟩ := (units_iff_le_one hM hrv h0).mp hu
    exact ⟨h2, h1⟩
  have h1e : rvpow (iRv e) 1 = iRv e := by
    show iRVMul (rvpow (iRv e) 0) (iRv e) = iRv e
    rw [show rvpow (iRv e) 0 = iRVOne from rfl, rv_mul_one_any hM hrv]
  have h' := h 1 (by norm_num) (iVFOne (M := M)) (iVFOne (M := M)) (vf_one_mem hM) (vf_one_mem hM)
    (vfOne_mem_sub S) (vfOne_mem_sub S) (RVCalc.vf_zero_ne_one hM).symm
    (RVCalc.vf_zero_ne_one hM).symm
  apply h'
  rw [h1e, rv_one hM, rv_mul_one_any_right hM hrv]
  exact hcls

/-- In the unit case the slot's hypothesis `rv(e) ∈ RV(S)` is **automatic**: a unit's class is in
`S` as soon as `S` contains all units (`Assembly.KEqTop`, the `K(Ŝ) = K(M)` half of `Standing`). -/
theorem iRv_mem_of_iUnits {S : LRV.Substructure M} (hK : Assembly.KEqTop S) {e : M}
    (hu : iUnits (iRv e)) : iRv e ∈ S :=
  hK (iRv e) hu

/-- **The unit case's bookkeeping, reduced.**  With `e` a unit and the class-level conclusion
`M5L.ResidualClasses S T` supplied, *everything* else in the bookkeeping half follows — with no
`M5L.Separated`, no `QuotExpansions`, no henselianity:

* `Standing T` (`M5L.standing_of_ClassControl`);
* `Γ(T) = Γ(S)`: `GammaEqQ S T` and `gammaSub T = gammaSub S`;
* `RV(T) ⊆ ⟨RV(Ŝ), rv(e)⟩`: `RVGenCover S T (rv e)` — and since `rv(e) ∈ S` is automatic here
  (`iRv_mem_of_iUnits`), the monomial span is *inside* `S` (`rvNatSpanCls_mem`).

So in the unit case the whole bookkeeping is exactly `ResidualClasses S T`; see
`UnitCaseGammaObligation` below for that conjunct as a named obligation. -/
theorem unit_bookkeeping_reduction {S T : LRV.Substructure M} {e : M} (hST : S ≤ T)
    (hS : Assembly.Standing S) (he : iVF e) (hu : iUnits (iRv e))
    (hres : M5L.ResidualClasses S T) :
    Assembly.Standing T ∧ GammaDiv.GammaEqQ S T ∧
      HullAudit.gammaSub (M := M) T = HullAudit.gammaSub (M := M) S ∧
      RVGenCover S T (iRv e) := by
  have hgamma : GammaDiv.GammaEqQ S T := gammaEqQ_of_residualClasses hres
  exact ⟨M5L.standing_of_ClassControl hST hS hres, hgamma,
    gammaSub_eq_of_gammaEqQ hST hgamma,
    (rvGenCover_iff_residualClasses (rv_mem hM he) (iRv_mem_of_iUnits hS.1 hu)).mpr hres⟩

/-- **The unit case's `Γ`-obligation.**  This is `M5L.ResidualClasses_of_VFGen` with the
separation hypothesis `M5L.Separated S e` replaced by the unit hypothesis `iUnits (rv e)` — the
hypothesis Lemma 3.4 actually has.  It is *not* proved and not assumed anywhere above, and it is
*not* claimed to follow from the tree's hypotheses: the paper derives it from the fundamental
inequality together with the residue-field equality `K(⟨Ŝ,e⟩) = K(Ŝ)(rv e)` (`qe.tex:624-632`),
and the leading-term route of `M5L.ResidualClasses_of_VFGen` cannot apply because `Separated` is
false here (`not_separated_of_iUnits`).

The paper's *irreducibility* hypothesis is essential and is **not** part of this statement: a unit
`e` that is merely algebraic over `S` can still move the value group (over `ℂ((t))` take
`e = 1 + t^{1/2}`, integral of degree `2` with reducible reduction `(X-1)²`, and
`v(e - 1) = 1/2 ∉ ℤ = Γ(ℂ((t)))`), so without it the statement is false.  Producing the paper's
3.4 data (`F` monic over `O(Ŝ)`, `F̄` irreducible, `e` a unit root, `VF(S)` henselian) and
deriving this obligation is p1/p3's half; here it is recorded as the exact remaining conjunct, and
`unit_bookkeeping_of_residual` shows it is enough. -/
def UnitCaseGammaObligation : Prop :=
  ∀ (S T : LRV.Substructure M) (e : M), Assembly.Standing (M := M) S →
    M5L.VFInvClosedOn (M := M) S → iVF e → iUnits (iRv e) →
      Assembly.IsVFGen (M := M) T → M5L.QuotExpansions (M := M) S T e →
        M5L.ResidualClasses (M := M) S T

/-- The obligation is exactly what the unit case owes: it gives `Standing T` and the `Γ`/`RV`
bookkeeping through `unit_bookkeeping_reduction`. -/
theorem unit_bookkeeping_of_residual (h : UnitCaseGammaObligation (M := M)) {S T : LRV.Substructure M} {e : M}
    (hST : S ≤ T) (hS : Assembly.Standing S) (hfinv : M5L.VFInvClosedOn S) (he : iVF e)
    (hu : iUnits (iRv e)) (hgen : Assembly.IsVFGen T) (hquot : M5L.QuotExpansions S T e) :
    Assembly.Standing T ∧ GammaDiv.GammaEqQ S T ∧
      HullAudit.gammaSub (M := M) T = HullAudit.gammaSub (M := M) S ∧
      RVGenCover S T (iRv e) :=
  unit_bookkeeping_reduction hST hS he hu (h S T e hS hfinv he hu hgen hquot)

/-! ### 4.iii″ `Separated` needs a *non*-`VF`-generated `S`

The class `rv(e) ∈ RV(S)` is itself an `RV`-element of `S`; if `S` is `VF`-generated
(`Assembly.IsVFGen S`) it is `rv(x)` of some `VF`-element `x ∈ S`, and then the witness
`k = 1`, `x' = 1`, `y = x` of `M5L.Separated S e` is a class equality of `rv(e)` with itself.
So `M5L.Separated S e` can hold **only** for substructures whose `RV`-part is strictly bigger than
`rv(VF(S))`: the paper's `Ŝ = ⟨VF(S)⟩` can never be the base of the separated branch.  (This is the
structural reason behind m1's `f1`: Lemma 3.4's unit `e` is one instance; the fact below is the
general form.) -/

/-- **`Separated` is impossible over a `VF`-generated `S`.**  Given `e ≠ 0` with `rv(e) ∈ RV(S)`
and `Assembly.IsVFGen S`, the `RV`-preimage `x ∈ S ∩ VF` of `rv(e)` refutes the separation
condition at `k = 1`, `x' = 1`, `y = x`. -/
theorem not_separated_of_isVFGen {S : LRV.Substructure M} {e : M} (hsep : M5L.Separated S e)
    (hgen : Assembly.IsVFGen S) (he : iVF e) (he0 : e ≠ iVFZero) (heS : iRv e ∈ S) : False := by
  have hrv : iRV (iRv e) := rv_mem hM he
  have hrv0 : iRv e ≠ iRVZero := fun h => he0 (vf_eq_zero_of_rv_eq_zero hM he h)
  have h1 : rvpow (iRv e) 1 = iRv e := by
    show iRVMul (rvpow (iRv e) 0) (iRv e) = iRv e
    rw [show rvpow (iRv e) 0 = iRVOne from rfl, rv_mul_one_any hM hrv]
  rcases hgen (iRv e) heS hrv with ⟨y, hyS, hyvf, hyr⟩ | hz
  · have hy0 : y ≠ iVFZero := fun h => hrv0 (by rw [← hyr, h]; exact rv_zero_eq hM)
    have hbad := hsep 1 (by norm_num) (iVFOne (M := M)) y (vf_one_mem hM) hyvf
      (vfOne_mem_sub S) hyS (RVCalc.vf_zero_ne_one hM).symm hy0
    apply hbad
    rw [h1, rv_one hM, rv_mul_one_any_right hM hrv, hyr]
    exact cls_refl hM hrv
  · exact hrv0 hz

/-- **Consequence for the slot**: over a `VF`-generated base, no element with `rv(m) ∈ RV(S)` is
separated (unless it is `0`, where the separated condition is vacuous in the `rv`-direction).
So the separated branch of `M4Cases.Cases` is inhabited only by bases whose `RV`-part has classes
with no `VF`-representative in `S`. -/
theorem not_separated_of_isVFGen_of_ne {S : LRV.Substructure M} {e : M}
    (hgen : Assembly.IsVFGen S) (he : iVF e) (he0 : e ≠ iVFZero) (heS : iRv e ∈ S) :
    ¬ M5L.Separated S e :=
  fun hsep => not_separated_of_isVFGen hsep hgen he he0 heS

/-- The same statement in `→ False` form, for use where the slot hypotheses are assembled. -/
theorem separated_hypotheses_inconsistent {S : LRV.Substructure M} {e : M}
    (hgen : Assembly.IsVFGen S) (he : iVF e) (he0 : e ≠ iVFZero) (heS : iRv e ∈ S) :
    M5L.Separated S e → False :=
  not_separated_of_isVFGen_of_ne hgen he he0 heS

/-! ### 4.iv Abstract sharpness: divisibility does not give inverses -/

/-- **Stress test (abstract).**  In `ℚ`, the submonoid `{q | 0 ≤ q}` is closed under division by
every positive `n` — the abstract content of `Assembly.GammaDivisible` (`∀ t ∈ Γ(S), n ≥ 1, ∃ u ∈
Γ(S), uⁿ = t`) — and yet is *not* closed under negation.  So `RVInvClosedOn` (the paper's WLOG,
`qe.tex:489`) is a hypothesis genuinely independent of `Γ`-divisibility: chains of roots do not give
inverses.  This is the abstract form of the tree's remark that `Γ(S)` is only a submonoid of
`Γ(M)`. -/
theorem root_closed_not_neg_closed :
    (∀ x : ℚ, 0 ≤ x → ∀ n : ℕ, 0 < n → ∃ y : ℚ, 0 ≤ y ∧ n • y = x) ∧
      ¬ (∀ x : ℚ, 0 ≤ x → ∃ y : ℚ, 0 ≤ y ∧ x + y = 0) := by
  constructor
  · intro x hx n hn
    refine ⟨x / n, div_nonneg hx n.cast_nonneg, ?_⟩
    rw [nsmul_eq_mul]
    field_simp
  · intro h
    obtain ⟨y, hy, hy1⟩ := h 1 (by norm_num)
    linarith

end SpecialTransformations.Milestone0.Bookkeeping

