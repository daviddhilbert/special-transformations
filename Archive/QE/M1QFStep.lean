/-
  Swarm `smw1ukwfb`, member m1, direction d7.

  **The quantifier-free transport half of the one-element extension.**

  The frozen route (`QE/PaperRoute.lean`) is

      ShoenfieldTestSize -> PrepStepSize -> OneStepSizeFree -> HasQE Axioms.ACVF,

  and the case lemmas of Yin, §3.1 (Lemmas 3.4/3.5/3.6) owe an *extension of the monomorphism*
  plus the paper's Claim (⋆).  The extension half splits into two independent jobs that the tree
  keeps separate:

  * choose the image `n` of the new element in `N`, which is the paper's `d` with
    `rv(d) = f(rv(e))` (`QE/Lemma32_root_lifting.lean`, `QE/M6Wire.lean`), and
  * turn `m ↦ n` into an `LRV`-embedding of the substructure generated by `S` and `m`.

  This file supplies the second job, and pins down exactly what the first owes.

  ## What is proved

  * `AtomicAgree S f a xs` — every *atomic* `L`-formula is true at `(a; S)` in `M` iff it is true
    at `(xs; f(S))` in `N`.  This is the form in which the paper's Claim (⋆) lands: equalities of
    `VF`-terms (via `rv`-classes) and the four relations `memVF`, `memRV`, `Kˣ`, `≤`.
  * `exists_embedding_closure_of_atomic` — atomic agreement yields an `LRV`-embedding of
    `closure(S ∪ range a)` into `N` extending `f` and sending `a` to `xs`.  (This is
    `QESat.exists_embedding_closure` of `QE/Semantics_saturation.lean` with the hypothesis weakened
    from *all* formulas to atomic ones; the existing proof only ever uses the two atomic cases,
    `t₁.bdEqual t₂` and `R.boundedFormula t`, so the weakening is free.)
  * `realize_qf_agree_of_atomic` — atomic agreement gives agreement of every quantifier-free
    formula, so the credit can be spent in either vocabulary.
  * `StepObligation` / `oneStepVFP_of_stepObligation` — the exact pair of things a case lemma owes
    at one element: (i) an atomic match `m ↦ n`, and (ii) the paper's Claim (⋆) in the form
    `RV(⟨S,m⟩) ⊆ S`, which discharges `Standing T` through `standing_of_RV_le`.  Nothing else.
  * `atomicAgree_of_embedding` / `atomicAgree_of_embedding_closure` — the converse: any extension
    of `f` at `a ↦ xs` produces the atomic match, so `AtomicAgree` is exactly the data an
    extension needs (and `Frozen.stepAtomic_of_oneStepVFP` shows `OneStepVFP` forces it).
  * `atomicAgree_of_mem` — the obligation is not a restatement of its conclusion: for an element
    already in `S`, the atomic match is `f` itself.
  * `Frozen.oneStepVFP_of_global_extension` / `Frozen.oneStepVFP_self_subtype` — non-vacuity:
    Proposition 3.9 at the pair implies the one-step, so the one-step has solutions at the
    identity pair of every model of `ACVF`.

  Imports: `Assembly_frozen` and `Standing` (both compiled in `.scratch2/sec3`), i.e. nothing
  private to this directory.

  ## Residual (not proved here, deliberately)

  Producing the atomic match `m ↦ n` for a *new* element is the mathematics of Lemmas 3.4–3.6
  (the Newton-polygon / residue computation); it is not implied by `Axioms.ACVF`.  Two caveats
  are recorded in the final section: (a) the frozen encoding's symbols are constrained by the
  axioms only on well-sorted inputs, so `AtomicAgree` must be met for *ill-sorted* terms too,
  which no value computation supplies; (b) for `rv(m) ∉ S`, `Standing T` forces the whole
  divisible hull of `Γ(S) + ℤ·v(m)` into `T` (compare `QE/M5OneStep.lean`).

  No `sorry`, no `axiom`, no `native_decide`.
-/
import Assembly_frozen
import Standing

open FirstOrder FirstOrder.Language
open FirstOrder.Language.Structure
open scoped FirstOrder

namespace SpecialTransformations
namespace Milestone0
namespace M1QF

universe u v w w' u₁

/-! ## 1. Atomic agreement and its packaging -/

section Generic

variable {L : FirstOrder.Language.{u, v}} {M : Type w} {N : Type w'}
variable [L.Structure M] [L.Structure N]
variable {α : Type u₁}

/-- **Atomic agreement**: the tuple `a` over the substructure `S` and the tuple `xs` over `f '' S`
satisfy the same atomic formulas.  Equalities of terms and the relation symbols are the only
atomic data of a first-order language, so this is the exact hypothesis the packing lemma needs. -/
def AtomicAgree (S : L.Substructure M) (f : S ↪[L] N) (a : α → M) (xs : α → N) : Prop :=
  (∀ t₁ t₂ : L.Term (S ⊕ α),
      (t₁.realize (Sum.elim (fun s : S => (s : M)) a)
          = t₂.realize (Sum.elim (fun s : S => (s : M)) a)
        ↔ t₁.realize (Sum.elim (fun s : S => f s) xs)
          = t₂.realize (Sum.elim (fun s : S => f s) xs)))
    ∧ (∀ {k : ℕ} (r : L.Relations k) (ts : Fin k → L.Term (S ⊕ α)),
      (RelMap r (fun i => (ts i).realize (Sum.elim (fun s : S => (s : M)) a))
        ↔ RelMap r (fun i => (ts i).realize (Sum.elim (fun s : S => f s) xs))))

/-- **Packaging of the one-element step, quantifier-free form.**  Suppose `f : S ↪[L] N` is
matched at the tuple `a : α → M` by `xs : α → N` at the level of *atomic* formulas.  Then `f`
extends to an embedding of the substructure generated by `S` and `a` into `N`, sending `a` to
`xs`.  The map is the term evaluation `t ↦ t.realize (f, xs)`, which descends to the substructure
because atomic agreement is exactly the well-definedness and relation condition. -/
theorem exists_embedding_closure_of_atomic (S : L.Substructure M) (f : S ↪[L] N)
    (a : α → M) (xs : α → N) (h : AtomicAgree S f a xs) :
    ∃ g : (↥(Substructure.closure L ((↑S : Set M) ∪ Set.range a))) ↪[L] N,
      (∀ s : S, g ⟨s, Substructure.subset_closure (Or.inl s.2)⟩ = f s) ∧
      (∀ i, g ⟨a i, Substructure.subset_closure (Or.inr ⟨i, rfl⟩)⟩ = xs i) := by
  classical
  set C : L.Substructure M := Substructure.closure L ((↑S : Set M) ∪ Set.range a) with hC
  set u : S ⊕ α → M := Sum.elim (fun s : S => (s : M)) a with hu
  set u' : S ⊕ α → N := Sum.elim (fun s : S => f s) xs with hu'
  -- every value of a term over the generating tuple is in `C`
  have mem_term : ∀ t : L.Term (S ⊕ α), t.realize u ∈ C := by
    intro t
    induction t with
    | var w =>
        have hw : u w ∈ (↑S : Set M) ∪ Set.range a := by
          rcases w with s | i
          · exact Or.inl s.2
          · exact Or.inr ⟨i, rfl⟩
        exact Substructure.subset_closure hw
    | func F ts ih => exact C.fun_mem F (fun i => (ts i).realize u) ih
  -- conversely, every element of `C` is the value of a term
  have hgen : (↑S : Set M) ∪ Set.range a ⊆ {x | ∃ t : L.Term (S ⊕ α), t.realize u = x} := by
    rintro y (hy | ⟨i, hi⟩)
    · exact ⟨Term.var (Sum.inl ⟨y, hy⟩), rfl⟩
    · exact ⟨Term.var (Sum.inr i), by show u (Sum.inr i) = y; rw [hu]; exact hi⟩
  have hclos : ∀ {m : ℕ} (F : L.Functions m) (x : Fin m → M),
      (∀ i, x i ∈ {y | ∃ t : L.Term (S ⊕ α), t.realize u = y}) →
      funMap F x ∈ {y | ∃ t : L.Term (S ⊕ α), t.realize u = y} := by
    intro m F x ih
    choose t ht using ih
    exact ⟨Term.func F t, by simp only [Term.realize]; rw [funext ht]⟩
  have exists_term : ∀ x ∈ C, ∃ t : L.Term (S ⊕ α), t.realize u = x := by
    intro x hx
    have hle : C ≤ (⟨{y | ∃ t : L.Term (S ⊕ α), t.realize u = y},
        fun F x ih => hclos F x ih⟩ : L.Substructure M) := by
      rw [hC]
      exact Substructure.closure_le.2 hgen
    exact hle hx
  -- equalities of terms transfer from `u` to `u'`  (this is the only use of the hypothesis)
  have term_eq_iff : ∀ t₁ t₂ : L.Term (S ⊕ α),
      (t₁.realize u = t₂.realize u ↔ t₁.realize u' = t₂.realize u') := by
    intro t₁ t₂
    exact h.1 t₁ t₂
  -- the candidate map
  set G : (↥C) → N := fun x => (Classical.choose (exists_term x.1 x.2)).realize u' with hG
  have G_eq : ∀ (t : L.Term (S ⊕ α)), G ⟨t.realize u, mem_term t⟩ = t.realize u' := by
    intro t
    have hspec := Classical.choose_spec (exists_term (t.realize u) (mem_term t))
    exact (term_eq_iff _ t).1 hspec
  have G_inj : Function.Injective G := by
    intro x y hxy
    obtain ⟨tx, htx⟩ := exists_term x.1 x.2
    obtain ⟨ty, hty⟩ := exists_term y.1 y.2
    have hx' : G x = tx.realize u' := by
      conv_lhs => rw [show x = ⟨tx.realize u, mem_term tx⟩ from Subtype.ext htx.symm]
      exact G_eq tx
    have hy' : G y = ty.realize u' := by
      conv_lhs => rw [show y = ⟨ty.realize u, mem_term ty⟩ from Subtype.ext hty.symm]
      exact G_eq ty
    have h1 : tx.realize u = ty.realize u :=
      (term_eq_iff tx ty).2 (by rw [← hx', ← hy']; exact hxy)
    exact Subtype.ext (by rw [← htx, ← hty]; exact h1)
  have G_fun : ∀ {m : ℕ} (F : L.Functions m) (x : Fin m → ↥C),
      G (funMap F x) = funMap F (fun i => G (x i)) := by
    intro m F x
    choose t ht using fun i => exists_term (x i).1 (x i).2
    have hcoe : (funMap F x : ↥C) = ⟨(Term.func F t).realize u, mem_term _⟩ := by
      refine Subtype.ext ?_
      show funMap F (fun i => ((x i : ↥C) : M)) = funMap F (fun i => (t i).realize u)
      rw [funext fun i => (ht i).symm]
    rw [hcoe, G_eq]
    simp only [Term.realize]
    congr 1
    funext i
    rw [show x i = (⟨Term.realize u (t i), mem_term (t i)⟩ : ↥C) from Subtype.ext (ht i).symm]
    exact (G_eq (t i)).symm
  have G_rel : ∀ {m : ℕ} (R : L.Relations m) (x : Fin m → ↥C),
      RelMap R (G ∘ x) ↔ RelMap R x := by
    intro m R x
    choose t ht using fun i => exists_term (x i).1 (x i).2
    have h1 : RelMap R x ↔ RelMap R (fun i => (t i).realize u) := by
      rw [show x = (fun i => (⟨(t i).realize u, mem_term (t i)⟩ : ↥C)) from
        funext fun i => Subtype.ext (Subtype.ext_iff.1 rfl ▸ (ht i).symm)]
      exact Iff.rfl
    have h2 : RelMap R (fun i => (t i).realize u')
        ↔ RelMap R (fun i => (t i).realize u) := by
      exact (h.2 R t).symm
    have h3 : RelMap R (G ∘ x) ↔ RelMap R (fun i => (t i).realize u') := by
      have hfun : (G ∘ x) = (fun i => (t i).realize u') := by
        funext i
        simp only [Function.comp_apply]
        rw [show x i = (⟨(t i).realize u, mem_term (t i)⟩ : ↥C) from
          Subtype.ext (by simpa using (ht i).symm)]
        exact G_eq (t i)
      rw [hfun]
    exact h3.trans (h2.trans h1.symm)
  have G_incl : ∀ s : S, G ⟨s, Substructure.subset_closure (Or.inl s.2)⟩ = f s := by
    intro s
    have h1 : (⟨s, Substructure.subset_closure (Or.inl s.2)⟩ : ↥C)
        = ⟨(Term.var (Sum.inl s)).realize u, mem_term _⟩ := by
      refine Subtype.ext ?_
      show (s : M) = u (Sum.inl s)
      rw [hu]; rfl
    rw [h1, G_eq]
    show u' (Sum.inl s) = f s
    rw [hu']; rfl
  have G_a : ∀ i, G ⟨a i, Substructure.subset_closure (Or.inr ⟨i, rfl⟩)⟩ = xs i := by
    intro i
    have h1 : (⟨a i, Substructure.subset_closure (Or.inr ⟨i, rfl⟩)⟩ : ↥C)
        = ⟨(Term.var (Sum.inr i)).realize u, mem_term _⟩ := by
      refine Subtype.ext ?_
      show a i = u (Sum.inr i)
      rw [hu]; rfl
    rw [h1, G_eq]
    show u' (Sum.inr i) = xs i
    rw [hu']; rfl
  exact ⟨⟨⟨G, G_inj⟩, fun {m} F x => G_fun F x, fun {m} R x => G_rel R x⟩, G_incl, G_a⟩

/-- **Atomic agreement gives agreement of every quantifier-free formula** — so the packing lemma
can be applied with the credit stated in either vocabulary. -/
theorem realize_qf_agree_of_atomic (S : L.Substructure M) (f : S ↪[L] N) {n : ℕ}
    {a : Fin n → M} {xs : Fin n → N} (h : AtomicAgree S f a xs)
    {φ : L.BoundedFormula S n} (hφ : φ.IsQF) :
    (φ.Realize (fun s : S => (s : M)) a ↔ φ.Realize (fun s : S => f s) xs) := by
  induction hφ with
  | falsum => exact Iff.rfl
  | of_isAtomic hA =>
    cases hA with
    | equal t₁ t₂ => exact h.1 t₁ t₂
    | rel r ts =>
      have hh := h.2 r ts
      simpa only [BoundedFormula.realize_rel] using hh
  | imp _ _ ih1 ih2 => simp only [BoundedFormula.realize_imp, ih1, ih2]

end Generic

/-! ## 1b. The converse: an embedding of the closure *is* atomic agreement

Together with `exists_embedding_closure_of_atomic` this says that the atomic match is not an
artificially strong hypothesis: a case lemma may produce its extension in either form. -/

section Converse

variable {L : FirstOrder.Language.{u, v}} {M : Type w} {N : Type w'}
variable [L.Structure M] [L.Structure N]
variable {α : Type u₁}

/-- **An embedding of a substructure `T ⊇ S ∪ range a`, extending `f` and sending `a` to `xs`,
gives atomic agreement.**  So `AtomicAgree` is not an artificially strong hypothesis: it is exactly
the data any extension `(f, a ↦ xs)` supplies, whatever `T` is taken to be. -/
theorem atomicAgree_of_embedding (S : L.Substructure M) (f : S ↪[L] N) (a : α → M)
    (xs : α → N) (T : L.Substructure M) (g : T ↪[L] N)
    (hST : ∀ x : M, x ∈ S → x ∈ T) (ha : ∀ i, a i ∈ T)
    (hagree : ∀ x : S, g ⟨(x : M), hST x.1 x.2⟩ = f x)
    (hnew : ∀ i, g ⟨a i, ha i⟩ = xs i) :
    AtomicAgree S f a xs := by
  classical
  set V : S ⊕ α → ↥T :=
    Sum.elim (fun s : S => ⟨(s : M), hST s.1 s.2⟩) (fun i => ⟨a i, ha i⟩) with hV
  have keyM : ∀ t : L.Term (S ⊕ α),
      (t.realize V).1 = t.realize (Sum.elim (fun s : S => (s : M)) a) := by
    intro t
    induction t with
    | var w => rcases w with s | i <;> rfl
    | func F ts ih =>
      show funMap F (fun i => ((ts i).realize V).1)
        = funMap F (fun i => (ts i).realize (Sum.elim (fun s : S => (s : M)) a))
      rw [funext fun i => ih i]
  have keyN : ∀ t : L.Term (S ⊕ α),
      g (t.realize V) = t.realize (Sum.elim (fun s : S => f s) xs) := by
    intro t
    rw [← HomClass.realize_term]
    congr 1
    funext w
    rcases w with s | i
    · exact hagree s
    · exact hnew i
  constructor
  · intro t₁ t₂
    constructor
    · intro h
      have h2 : t₁.realize V = t₂.realize V := Subtype.ext (by rw [keyM t₁, keyM t₂]; exact h)
      rw [← keyN t₁, ← keyN t₂, h2]
    · intro h
      have h2 : t₁.realize V = t₂.realize V := by
        have h3 : g (t₁.realize V) = g (t₂.realize V) := by rw [keyN t₁, keyN t₂]; exact h
        exact (EmbeddingLike.apply_eq_iff_eq g).1 h3
      rw [← keyM t₁, ← keyM t₂, h2]
  · intro k r ts
    have hX : (fun i => (ts i).realize (Sum.elim (fun s : S => (s : M)) a))
        = (fun i => ((ts i).realize V).1) := by
      funext i; exact (keyM (ts i)).symm
    have hY : (fun i => (ts i).realize (Sum.elim (fun s : S => f s) xs))
        = (fun i => g ((ts i).realize V)) := by
      funext i; exact (keyN (ts i)).symm
    rw [hX, hY]
    exact (StrongHomClass.map_rel g r (fun i => (ts i).realize V)).symm

/-- The closure version: an embedding of `closure(S ∪ range a)` extending `f` and sending `a`
to `xs` gives atomic agreement. -/
theorem atomicAgree_of_embedding_closure (S : L.Substructure M) (f : S ↪[L] N)
    (a : α → M) (xs : α → N)
    (g : (↥(Substructure.closure L ((↑S : Set M) ∪ Set.range a))) ↪[L] N)
    (hincl : ∀ s : S, g ⟨s, Substructure.subset_closure (Or.inl s.2)⟩ = f s)
    (hnew : ∀ i, g ⟨a i, Substructure.subset_closure (Or.inr ⟨i, rfl⟩)⟩ = xs i) :
    AtomicAgree S f a xs :=
  atomicAgree_of_embedding S f a xs _ g
    (fun _ hx => Substructure.subset_closure (Or.inl hx))
    (fun i => Substructure.subset_closure (Or.inr ⟨i, rfl⟩)) hincl hnew

end Converse

/-! ## 2. Consistency of the hypothesis: an element already in `S`

The atomic match required by `StepObligation` below is `f` itself when the new element lies in
`S`.  This shows the obligation is a genuine statement about the new element and not a
restatement of `OneStepVFP`'s conclusion. -/

section InS

variable {L : FirstOrder.Language.{u, v}} {M : Type w} {N : Type w'}
variable [L.Structure M] [L.Structure N]
variable {α : Type u₁}

/-- The `S`-valued assignment extending `v : α → S`. -/
def sadd (S : L.Substructure M) (v : α → S) : S ⊕ α → S := Sum.elim (fun s : S => s) v

/-- Realizing a term at an `S`-valued assignment is the coercion of the `S`-valued realization. -/
theorem realize_coe (S : L.Substructure M) (v : α → S) (t : L.Term (S ⊕ α)) :
    ((t.realize (sadd S v) : S) : M) = t.realize (fun w => ((sadd S v w : S) : M)) := by
  induction t with
  | var w => rfl
  | func F ts ih =>
    show funMap F (fun i => (((ts i).realize (sadd S v) : S) : M))
      = funMap F (fun i => (ts i).realize (fun w => ((sadd S v w : S) : M)))
    rw [funext fun i => ih i]

/-- Realizing a term at an `S`-valued assignment stays in `S`. -/
theorem realize_mem (S : L.Substructure M) (v : α → S) (t : L.Term (S ⊕ α)) :
    t.realize (fun w => ((sadd S v w : S) : M)) ∈ S := by
  rw [← realize_coe S v t]
  exact (t.realize (sadd S v)).2

/-- **The atomic match for an element of `S`.**  Both sides are the embedding `f` applied to the
`S`-valued realization of the term, so all atomic formulas agree; in particular the obligation
`StepObligation` below is satisfiable, and is not a restatement of its own conclusion. -/
theorem atomicAgree_of_mem (S : L.Substructure M) (f : S ↪[L] N) {m : M} (hm : m ∈ S) :
    AtomicAgree S f (fun _ : Unit => m) (fun _ => f ⟨m, hm⟩) := by
  set v : Unit → S := fun _ => ⟨m, hm⟩ with hv
  have keyM : ∀ t : L.Term (S ⊕ Unit),
      t.realize (Sum.elim (fun s : S => (s : M)) (fun _ => m))
        = ((t.realize (sadd S v) : S) : M) := by
    intro t
    rw [realize_coe S v t]
    congr 1
    funext w
    rcases w with s | u
    · rfl
    · rfl
  have keyN : ∀ t : L.Term (S ⊕ Unit),
      t.realize (Sum.elim (fun s : S => f s) (fun _ => f ⟨m, hm⟩))
        = f (t.realize (sadd S v)) := by
    intro t
    rw [← HomClass.realize_term]
    congr 1
    funext w
    rcases w with s | u
    · rfl
    · rfl
  constructor
  · intro t₁ t₂
    rw [keyM t₁, keyM t₂, keyN t₁, keyN t₂, EmbeddingLike.apply_eq_iff_eq]
    exact Subtype.ext_iff.symm
  · intro k r ts
    have hM : RelMap r (fun i => (ts i).realize (Sum.elim (fun s : S => (s : M))
        (fun _ => m))) ↔ RelMap r (fun i => (ts i).realize (sadd S v)) := by
      have : (fun i => (ts i).realize (Sum.elim (fun s : S => (s : M)) (fun _ => m)))
          = (fun i => (((ts i).realize (sadd S v) : S) : M)) := by
        funext i; exact keyM (ts i)
      rw [this]
      exact Iff.rfl
    have hN : RelMap r (fun i => (ts i).realize (Sum.elim (fun s : S => f s)
        (fun _ => f ⟨m, hm⟩))) ↔ RelMap r (fun i => f ((ts i).realize (sadd S v))) := by
      have : (fun i => (ts i).realize (Sum.elim (fun s : S => f s) (fun _ => f ⟨m, hm⟩)))
          = (fun i => f ((ts i).realize (sadd S v))) := by
        funext i; exact keyN (ts i)
      rw [this]
    rw [hM, hN]
    exact (StrongHomClass.map_rel f r (fun i => (ts i).realize (sadd S v))).symm

end InS

/-! ## 3. The frozen one-step obligation -/

namespace Frozen

open SpecialTransformations.Milestone0.Assembly

variable {M N : Type} [LRV.Structure M] [LRV.Structure N]
variable [M ⊨ Axioms.ACVF] [N ⊨ Axioms.ACVF]

/-- `KEqTop` is monotone: a bigger substructure still contains every unit. -/
theorem KEqTop_mono {S T : LRV.Substructure M} (hST : S ≤ T) (hS : KEqTop S) : KEqTop T :=
  fun x hx => hST (hS x hx)

/-- **Claim (⋆) preserves `Standing`.**  If every `RV`-element of `T` already lies in `S`, then
`Standing S` gives `Standing T`: the units are in `S ⊆ T`, and the divisibility witnesses for
`t ∈ RV(T)` may be taken in `S` because `t` itself is in `S`.
(This is `M5.standing_of_RV_le` of `QE/M5OneStep.lean`, reproved here so that this file depends
only on the frozen `Assembly`.) -/
theorem standing_of_RV_le {S T : LRV.Substructure M} (hST : S ≤ T) (hS : Standing S)
    (hRV : ∀ y : M, y ∈ T → iRV y → y ∈ S) : Standing T := by
  obtain ⟨hK, hDiv⟩ := hS
  refine ⟨KEqTop_mono hST hK, ?_⟩
  intro t htT hRVt ht0 n hn
  obtain ⟨u, c, huS, huRV, hu0, hcS, hcU, hpow⟩ := hDiv t (hRV t htT hRVt) hRVt ht0 n hn
  exact ⟨u, c, hST huS, huRV, hu0, hST hcS, hcU, hpow⟩

/-- **The pair of obligations a case lemma owes at one element.**

1. an *atomic match*: some `n ∈ N` satisfies, over `f '' S`, exactly the atomic formulas that `m`
   satisfies over `S` (this is what the paper's `d` with `rv(d) = f(rv(e))` supplies, via the
   Newton-polygon computation of `rv` of the terms in `m`);
2. the paper's Claim (⋆) in the frozen form `RV(⟨S,m⟩) ⊆ S`.

The substructure is the one generated by `S` and `m`, so obligation 2 is exactly the hypothesis of
`standing_of_RV_le` at that `T`. -/
def StepObligation (S : LRV.Substructure M) (f : S ↪[LRV] N) (m : M) : Prop :=
  ∃ n : N, AtomicAgree S f (fun _ : Unit => m) (fun _ => n) ∧
    ∀ y : M, y ∈ Substructure.closure LRV ((S : Set M) ∪ Set.range (fun _ : Unit => m)) →
      iRV y → y ∈ S

/-- One step of Claim (⋆) gives one step of `OneStepVFP`. -/
theorem oneStepVFP_of_obligation
    (h : ∀ (S : LRV.Substructure M) (f : S ↪[LRV] N), Standing S → ∀ m : M, iVF m →
      StepObligation S f m) :
    OneStepVFP (M := M) (N := N) := by
  intro S f hS m hm
  obtain ⟨n, hagree, hRV⟩ := h S f hS m hm
  obtain ⟨g, hincl, hnew⟩ := exists_embedding_closure_of_atomic S f
    (fun _ : Unit => m) (fun _ => n) hagree
  refine ⟨Substructure.closure LRV ((S : Set M) ∪ Set.range (fun _ : Unit => m)), g,
    fun x hx => Substructure.subset_closure (Or.inl hx), ?_, ?_, ?_⟩
  · intro x
    exact hincl x
  · exact Substructure.subset_closure (Or.inr ⟨(), rfl⟩)
  · exact standing_of_RV_le (fun x hx => Substructure.subset_closure (Or.inl hx)) hS hRV

/-- **`OneStepVFP` from the obligation, uniformly.**  This is the form in which a case lemma
should be stated: `OneStepSizeFree` follows once `StepObligation` is proved at every pair. -/
theorem oneStepVFP_uniform
    (h : ∀ (M N : Type) [LRV.Structure M] [LRV.Structure N] [M ⊨ Axioms.ACVF]
      [N ⊨ Axioms.ACVF], ∀ (S : LRV.Substructure M) (f : S ↪[LRV] N), Standing S →
      ∀ m : M, iVF m → StepObligation S f m) :
    ∀ (M N : Type) [LRV.Structure M] [LRV.Structure N] [M ⊨ Axioms.ACVF]
      [N ⊨ Axioms.ACVF], OneStepVFP (M := M) (N := N) :=
  fun M N _ _ _ _ => oneStepVFP_of_obligation (h M N)

/-- The obligation at an element of `S`, where the atomic match is `f` and the `RV`-control is
`RV(S) ⊆ S`: the obligation is satisfiable, so `oneStepVFP_of_obligation` is not vacuous. -/
theorem stepObligation_of_mem (S : LRV.Substructure M) (f : S ↪[LRV] N) {m : M} (hm : m ∈ S) :
    StepObligation S f m := by
  refine ⟨f ⟨m, hm⟩, atomicAgree_of_mem S f hm, ?_⟩
  intro y hy _
  -- `m` is already in `S`, so the closure is `S` itself
  have hcl : Substructure.closure LRV ((S : Set M) ∪ Set.range (fun _ : Unit => m)) = S := by
    refine le_antisymm ?_ ?_
    · refine Substructure.closure_le.2 ?_
      rintro y (hy | ⟨u, huy⟩)
      · exact hy
      · rw [← huy]; exact hm
    · intro x hx
      exact Substructure.subset_closure (Or.inl hx)
  rw [hcl] at hy
  exact hy

/-- **`OneStepVFP` forces the atomic match.**  Whatever `T` and `g` a case lemma produces, the
value of the new element is an atomic match over `f '' S` for the whole substructure generated by
`S` and `m` — ill-sorted terms included, since the closure contains their values and `g` is
defined on them.  Hence the first clause of `StepObligation` is not an artefact of the packaging:
no weaker data can drive `OneStepVFP`.  (The second clause, `RV`-control, is the paper's Claim
(⋆); it is *sufficient* for `Standing T` by `standing_of_RV_le`, not necessary.) -/
theorem stepAtomic_of_oneStepVFP (h : OneStepVFP (M := M) (N := N)) :
    ∀ (S : LRV.Substructure M) (f : S ↪[LRV] N), Standing S → ∀ m : M, iVF m →
      ∃ n : N, AtomicAgree S f (fun _ : Unit => m) (fun _ => n) := by
  intro S f hS m hm
  obtain ⟨T, g, hST, hagree, hmT, _hStand⟩ := h S f hS m hm
  exact ⟨g ⟨m, hmT⟩, atomicAgree_of_embedding S f (fun _ : Unit => m) (fun _ => g ⟨m, hmT⟩) T g
    (fun _ hx => hST hx) (fun _ => hmT) hagree (fun _ => rfl)⟩

/-- **The one-step is weaker than Proposition 3.9.**  If the global extension property of
Proposition 3.9 holds at the pair, then `OneStepVFP` holds there outright: take `T = ⊤`, whose
`Standing` is `StandingTree.standing_top`.  So the frozen decomposition
`PrepStepSize → OneStepSizeFree → Prop39Size` loses nothing at the one-step, and `OneStepVFP` is
not vacuous. -/
theorem oneStepVFP_of_global_extension
    (hglob : ∀ (S : LRV.Substructure M) (f : S ↪[LRV] N), ∃ g : M ↪[LRV] N,
      ∀ x : S, g (x : M) = f x) :
    OneStepVFP (M := M) (N := N) := by
  intro S f _hS m _hm
  obtain ⟨g, hg⟩ := hglob S f
  exact ⟨⊤, g.domRestrict ⊤, fun _ _ => trivial, fun x => hg x, trivial,
    StandingTree.standing_top⟩

/-- **The one-step is non-vacuous at the identity pair**: for a `Standing` substructure `S` and any
`VF`-element, the canonical embedding `S ↪ M` extends to `M` itself, so the frozen `OneStepVFP`
has a solution at `(M, M, S.subtype)` in every model of `ACVF`. -/
theorem oneStepVFP_self_subtype (S : LRV.Substructure M) (hS : Standing S) (m : M) (hm : iVF m) :
    ∃ (T : LRV.Substructure M) (g : T ↪[LRV] M) (hST : S ≤ T),
      (∀ x : S, g ⟨(x : M), hST x.2⟩ = x) ∧ m ∈ T ∧ Standing T := by
  refine ⟨⊤, (Embedding.refl LRV M).domRestrict ⊤, fun _ _ => trivial, fun x => ?_,
    trivial, StandingTree.standing_top⟩
  rfl

end Frozen

