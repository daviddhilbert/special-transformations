import Mathlib.RingTheory.Localization.FractionRing

/-! An injective ring map extends to the subfield generated by the original
ring image. The construction uses Mathlib's fraction-field universal property. -/

namespace SubfieldExtension

variable {R K L : Type*} [CommRing R] [IsDomain R] [Field K] [Field L]

def generator (r : R →+* K) (x : R) : Subfield.closure (Set.range r) :=
  ⟨r x, Subfield.subset_closure ⟨x, rfl⟩⟩

noncomputable def fractionLift (r : R →+* K) (hr : Function.Injective r) :
    FractionRing R →+* K := IsFractionRing.lift hr

theorem fractionLift_range (r : R →+* K) (hr : Function.Injective r) :
    (fractionLift r hr).fieldRange = Subfield.closure (Set.range r) := by
  simpa only [fractionLift, RingHom.coe_range] using
    (IsFractionRing.lift_fieldRange (K := FractionRing R) hr)

/-- The abstract fraction field is precisely the concrete subfield generated by
the image of the original ring. -/
noncomputable def fractionEquiv (r : R →+* K) (hr : Function.Injective r) :
    FractionRing R ≃+* Subfield.closure (Set.range r) :=
  (fractionLift r hr).rangeRestrictFieldEquiv.trans
    (RingEquiv.subfieldCongr (fractionLift_range r hr))

@[simp] theorem fractionEquiv_coe (r : R →+* K) (hr : Function.Injective r)
    (z : FractionRing R) :
    ((fractionEquiv r hr z : Subfield.closure (Set.range r)) : K) = fractionLift r hr z := by
  change ((fractionLift r hr).rangeRestrictFieldEquiv z : K) = fractionLift r hr z
  exact RingHom.rangeRestrictFieldEquiv_apply_coe _ z

@[simp] theorem fractionEquiv_algebraMap (r : R →+* K) (hr : Function.Injective r)
    (x : R) : fractionEquiv r hr (algebraMap R (FractionRing R) x) = generator r x := by
  apply Subtype.ext
  rw [fractionEquiv_coe]
  exact IsFractionRing.lift_algebraMap hr x

theorem generator_div_surjective (r : R →+* K) (hr : Function.Injective r)
    (z : Subfield.closure (Set.range r)) :
    ∃ x y : R, y ≠ 0 ∧ generator r x / generator r y = z := by
  obtain ⟨x, y, hy, hxy⟩ :=
    IsFractionRing.div_surjective R ((fractionEquiv r hr).symm z)
  refine ⟨x, y, mem_nonZeroDivisors_iff_ne_zero.mp hy, ?_⟩
  have he := congrArg (fractionEquiv r hr) hxy
  simpa only [map_div₀, fractionEquiv_algebraMap, RingEquiv.apply_symm_apply] using he

/-- Extend `σ` to the field generated by an injective realization `r` of its
domain. No closure of the original ring under field inversion is assumed. -/
noncomputable def extend (r : R →+* K) (hr : Function.Injective r)
    (σ : R →+* L) (hσ : Function.Injective σ) :
    Subfield.closure (Set.range r) →+* L :=
  (fractionLift σ hσ).comp (fractionEquiv r hr).symm.toRingHom

@[simp] theorem extend_generator (r : R →+* K) (hr : Function.Injective r)
    (σ : R →+* L) (hσ : Function.Injective σ) (x : R) :
    extend r hr σ hσ (generator r x) = σ x := by
  change fractionLift σ hσ ((fractionEquiv r hr).symm (generator r x)) = σ x
  rw [← fractionEquiv_algebraMap r hr x, RingEquiv.symm_apply_apply]
  exact IsFractionRing.lift_algebraMap hσ x

theorem extend_injective (r : R →+* K) (hr : Function.Injective r)
    (σ : R →+* L) (hσ : Function.Injective σ) :
    Function.Injective (extend r hr σ hσ) := (extend r hr σ hσ).injective

@[simp] theorem extend_generator_div (r : R →+* K) (hr : Function.Injective r)
    (σ : R →+* L) (hσ : Function.Injective σ) (x y : R) :
    extend r hr σ hσ (generator r x / generator r y) = σ x / σ y := by
  rw [map_div₀, extend_generator, extend_generator]

theorem exists_extension (r : R →+* K) (hr : Function.Injective r)
    (σ : R →+* L) (hσ : Function.Injective σ) :
    ∃ τ : Subfield.closure (Set.range r) →+* L,
      Function.Injective τ ∧ ∀ x : R, τ (generator r x) = σ x :=
  ⟨extend r hr σ hσ, extend_injective r hr σ hσ, extend_generator r hr σ hσ⟩

theorem extension_unique (r : R →+* K) (hr : Function.Injective r)
    (σ : R →+* L) (hσ : Function.Injective σ)
    (τ : Subfield.closure (Set.range r) →+* L)
    (hτ : ∀ x : R, τ (generator r x) = σ x) : τ = extend r hr σ hσ := by
  ext z
  obtain ⟨x, y, _, rfl⟩ := generator_div_surjective r hr z
  rw [map_div₀, map_div₀, hτ x, hτ y, extend_generator, extend_generator]

end SubfieldExtension

#print axioms SubfieldExtension.fractionEquiv_algebraMap
#print axioms SubfieldExtension.extend_generator
#print axioms SubfieldExtension.exists_extension
#print axioms SubfieldExtension.extension_unique
