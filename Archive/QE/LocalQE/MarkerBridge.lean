import CanonicalTheory
import CanonicalQF

set_option backward.isDefEq.respectTransparency false

/-! The generic model-theoretic criterion and its ACVF extension interface.

The book result is an explicit hypothesis. Saturation below means realization
of finitely satisfiable types over small parameter sets. It does not include
extension of an arbitrary embedding. The extension interface is an explicit
hypothesis of this module's bridge and is proved downstream in `Theorem23`.
-/

open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0
open SpecialTransformations.Milestone0.LRV

namespace MarkerBridge

/-- One-variable partial types with parameters indexed by `A`. -/
abbrev TypeOver (L : Language) (A : Type) : Type :=
  Set (L.Formula (A ⊕ Unit))

/-- Every finite subset has a simultaneous realization in the target model. -/
def FinSat {L : Language} {N : Type} [L.Structure N] {A : Type}
    (g : A → N) (p : TypeOver L A) : Prop :=
  ∀ p₀ : TypeOver L A, p₀.Finite → p₀ ⊆ p →
    ∃ b : N, ∀ φ ∈ p₀, φ.Realize (Sum.elim g (fun _ => b))

/-- Ordinary `κ`-saturation, using arbitrary small parameter sets and all
one-variable partial types. The parameter map may repeat elements. -/
def SatAt (L : Language) (N : Type) [L.Structure N] (κ : Cardinal) : Prop :=
  ∀ (A : Type) (g : A → N), Cardinal.mk A < κ →
    ∀ p : TypeOver L A, FinSat g p →
      ∃ b : N, ∀ φ ∈ p, φ.Realize (Sum.elim g (fun _ => b))

/-- Full-language QE, with a single formula witness uniform over all models
and assignments. This definition has no sorted-fragment restriction. -/
def FullQE {L : Language} (T : L.Theory) : Prop :=
  ∀ (α : Type) (n : ℕ) (φ : L.BoundedFormula α n),
    ∃ ψ : L.BoundedFormula α n, ψ.IsQF ∧
      ∀ (M : Type) [L.Structure M], M ⊨ T →
        ∀ (v : α → M) (xs : Fin n → M),
          (φ.Realize v xs ↔ ψ.Realize v xs)

/-- The genuine extension obligation in the saturated-model QE test. It is
not a consequence of saturation alone: finite satisfiability of the pushed
types must be supplied by the mathematics of the theory. -/
def SaturatedEmbeddingExtension {L : Language} (T : L.Theory) : Prop :=
  ∀ (M N : Type) [L.Structure M] [L.Structure N],
    M ⊨ T → N ⊨ T → SatAt L N (Order.succ (Cardinal.mk M)) →
      ∀ (S : L.Substructure M) (f : S ↪[L] N),
        ∃ g : M ↪[L] N, ∀ x : S, g x = f x

/-- **Authorized quotation:** Marker, *Model Theory: An Introduction* (2002),
Proposition 4.3.28, printed page 148, QE direction of the equivalence.

For a language with a constant, extension into sufficiently saturated models
characterizes QE. This is its substructure formulation: the book permits
partial embeddings on arbitrary subsets; a quantifier-free partial embedding
extends uniquely to the substructure generated by its domain, by evaluating
terms. Thus the extension test can be stated on substructures.

The formulation is generic in the language and theory. In particular, no
valued-field extension assertion or ACVF QE statement is part of the quote.
Source: https://ebooks.karbust.me/Mathematics/David%20Marker%20-%20Model%20Theory%20(2002)%20%5B978-0-387-22734-4%5D.pdf
-/
def MarkerProposition4328 : Prop :=
  ∀ (L : Language), Nonempty (L.Functions 0) →
    ∀ T : L.Theory, SaturatedEmbeddingExtension T → FullQE T

/-- The theory-specific extension interface, proved downstream in `Theorem23`.
Its models satisfy the author-corrected ACVF axioms, including named RV
inversion, and the explicit first-order canonical totalizations. -/
abbrev CanonicalExtension : Prop :=
  SaturatedEmbeddingExtension CanonicalTheory.CanonicalACVF

theorem fullQE_of_marker_and_extension
    (hMarker : MarkerProposition4328) (hExt : CanonicalExtension) :
    FullQE CanonicalTheory.CanonicalACVF := by
  exact hMarker LRV ⟨Fn.vfZero⟩ CanonicalTheory.CanonicalACVF hExt

/-- Restrict full QE to sorted inputs and canonical models. Sorting the output
formula is handled separately by `CanonicalQF`. -/
theorem rawCanonicalQE_of_fullQE
    (h : FullQE CanonicalTheory.CanonicalACVF) :
    CanonicalStructure.HasRawQEOnCanonical Axioms.ACVF := by
  intro α sα n sn φ hφ
  obtain ⟨ψ, hq, heq⟩ := h α n φ
  refine ⟨ψ, hq, ?_⟩
  intro M sM hM hc v xs hv hx
  exact heq M (CanonicalTheory.model_CanonicalACVF_iff.mpr ⟨hM, hc⟩) v xs

/-- The bridge to the well-sorted QE target in the author-corrected language.
Only the generic book criterion is quoted here. `hExt` is supplied by the
paper-specific extension proof in `Theorem23`; this module keeps it explicit. -/
theorem qe_of_marker_and_extension
    (hMarker : MarkerProposition4328) (hExt : CanonicalExtension) :
    HasQE Axioms.ACVF := by
  exact CanonicalStructure.hasQE_of_raw_canonical
    (rawCanonicalQE_of_fullQE (fullQE_of_marker_and_extension hMarker hExt))

end MarkerBridge

#print axioms MarkerBridge.fullQE_of_marker_and_extension
#print axioms MarkerBridge.rawCanonicalQE_of_fullQE
#print axioms MarkerBridge.qe_of_marker_and_extension
