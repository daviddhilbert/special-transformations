import VFValued
import SubfieldExtension

/-! Pass from the VF ring of an arbitrary language substructure to its generated
field, and extend the VF part of a language embedding to that field. -/

open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0
open SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Milestone0.Transfer
open scoped FirstOrder

namespace SubstructureField

variable {M N : Type} [LRV.Structure M] [LRV.Structure N]
  [hM : M ⊨ Axioms.ACVF] [hN : N ⊨ Axioms.ACVF]

theorem vfZero_mem (S : LRV.Substructure M) : (iVFZero : M) ∈ S :=
  S.fun_mem Fn.vfZero (fun i : Fin 0 => i.elim0) (fun i => i.elim0)

theorem vfOne_mem (S : LRV.Substructure M) : (iVFOne : M) ∈ S :=
  S.fun_mem Fn.vfOne (fun i : Fin 0 => i.elim0) (fun i => i.elim0)

/-- The VF elements lying in the language substructure form a ring. The
definition makes no assertion that their field inverses also lie in it. -/
def vfRing (S : LRV.Substructure M) : Subring (VFType (M := M)) where
  carrier := {x | x.1 ∈ S}
  zero_mem' := vfZero_mem S
  one_mem' := vfOne_mem S
  add_mem' := by
    intro x y hx hy
    change x.1 ∈ S at hx
    change y.1 ∈ S at hy
    exact S.fun_mem Fn.vfAdd ![x.1, y.1] (by
      intro i; fin_cases i <;> simp [hx, hy])
  neg_mem' := by
    intro x hx
    exact S.fun_mem Fn.vfNeg ![x.1] (by
      intro i; fin_cases i; simpa using hx)
  mul_mem' := by
    intro x y hx hy
    change x.1 ∈ S at hx
    change y.1 ∈ S at hy
    exact S.fun_mem Fn.vfMul ![x.1, y.1] (by
      intro i; fin_cases i <;> simp [hx, hy])

private theorem singleton_eta {X : Type} (x : X) :
    (fun _ : Fin 1 => x) = ![x] := by
  funext i
  fin_cases i
  rfl

theorem vf_map (S : LRV.Substructure M) (f : S ↪[LRV] N)
    (x : S) (hx : iVF (x : M)) : iVF (f x) := by
  have hx' : Structure.RelMap (L := LRV) Rel.memVF (fun _ : Fin 1 => x) := by
    change Structure.RelMap (L := LRV) Rel.memVF (fun _ : Fin 1 => (x : M))
    rw [singleton_eta]
    exact hx
  have h := (f.map_rel Rel.memVF (fun _ : Fin 1 => x)).mpr hx'
  change Structure.RelMap (L := LRV) Rel.memVF ![f x]
  rw [← singleton_eta]
  exact h

/-- A tuple presentation that makes the induced substructure operations
definitionally equal to the ambient operations. -/
theorem map_function (S : LRV.Substructure M) (f : S ↪[LRV] N)
    {k : ℕ} (g : Fn k) (xs : Fin k → M) (hs : ∀ i, xs i ∈ S) :
    f ⟨Structure.funMap (L := LRV) g xs, S.fun_mem g xs hs⟩ =
      Structure.funMap (L := LRV) g (fun i => f ⟨xs i, hs i⟩) :=
  f.map_fun g (fun i => ⟨xs i, hs i⟩)

def ringMap (S : LRV.Substructure M) (f : S ↪[LRV] N) :
    vfRing S →+* VFType (M := N) where
  toFun x := ⟨f ⟨x.1.1, x.2⟩, vf_map S f ⟨x.1.1, x.2⟩ x.1.2⟩
  map_zero' := by
    apply Subtype.ext
    have h := map_function S f Fn.vfZero (fun i : Fin 0 => i.elim0) (fun i => i.elim0)
    apply h.trans
    change Structure.funMap (L := LRV) Fn.vfZero _ =
      Structure.funMap (L := LRV) Fn.vfZero (fun i => i.elim0)
    congr 1
    funext i
    exact i.elim0
  map_one' := by
    apply Subtype.ext
    have h := map_function S f Fn.vfOne (fun i : Fin 0 => i.elim0) (fun i => i.elim0)
    apply h.trans
    change Structure.funMap (L := LRV) Fn.vfOne _ =
      Structure.funMap (L := LRV) Fn.vfOne (fun i => i.elim0)
    congr 1
    funext i
    exact i.elim0
  map_add' x y := by
    apply Subtype.ext
    have h := map_function S f Fn.vfAdd ![x.1.1, y.1.1] (by
      intro i; fin_cases i
      · exact x.2
      · exact y.2)
    apply h.trans
    change Structure.funMap (L := LRV) Fn.vfAdd _ =
      Structure.funMap (L := LRV) Fn.vfAdd ![f ⟨x.1.1, x.2⟩, f ⟨y.1.1, y.2⟩]
    congr 1
    funext i
    fin_cases i <;> rfl
  map_mul' x y := by
    apply Subtype.ext
    have h := map_function S f Fn.vfMul ![x.1.1, y.1.1] (by
      intro i; fin_cases i
      · exact x.2
      · exact y.2)
    apply h.trans
    change Structure.funMap (L := LRV) Fn.vfMul _ =
      Structure.funMap (L := LRV) Fn.vfMul ![f ⟨x.1.1, x.2⟩, f ⟨y.1.1, y.2⟩]
    congr 1
    funext i
    fin_cases i <;> rfl

theorem ringMap_injective (S : LRV.Substructure M) (f : S ↪[LRV] N) :
    Function.Injective (ringMap S f) := by
  intro x y h
  have hval : f ⟨x.1.1, x.2⟩ = f ⟨y.1.1, y.2⟩ :=
    congrArg (fun z : VFType (M := N) => z.1) h
  have hS : (⟨x.1.1, x.2⟩ : S) = ⟨y.1.1, y.2⟩ := f.injective hval
  have hxy : x.1.1 = y.1.1 := congrArg (fun z : S => (z : M)) hS
  exact Subtype.ext (Subtype.ext hxy)

/-- The honest VF field frame generated by the original substructure ring. -/
noncomputable def generatedField (S : LRV.Substructure M) : Subfield (VFType (M := M)) :=
  Subfield.closure (Set.range (vfRing S).subtype)

noncomputable def fieldMap (S : LRV.Substructure M) (f : S ↪[LRV] N) :
    generatedField S →+* VFType (M := N) :=
  SubfieldExtension.extend (vfRing S).subtype Subtype.coe_injective
    (ringMap S f) (ringMap_injective S f)

theorem fieldMap_injective (S : LRV.Substructure M) (f : S ↪[LRV] N) :
    Function.Injective (fieldMap S f) := (fieldMap S f).injective

@[simp] theorem fieldMap_generator (S : LRV.Substructure M) (f : S ↪[LRV] N)
    (x : vfRing S) :
    fieldMap S f (SubfieldExtension.generator (vfRing S).subtype x) = ringMap S f x :=
  SubfieldExtension.extend_generator _ _ _ _ _

/-- Agreement on every VF element of the original language substructure. -/
theorem fieldMap_agrees (S : LRV.Substructure M) (f : S ↪[LRV] N)
    (x : S) (hx : iVF (x : M)) :
    (fieldMap S f
      (SubfieldExtension.generator (vfRing S).subtype ⟨⟨(x : M), hx⟩, x.2⟩)).1 = f x :=
  congrArg Subtype.val (fieldMap_generator S f ⟨⟨(x : M), hx⟩, x.2⟩)

end SubstructureField

#print axioms SubstructureField.ringMap
#print axioms SubstructureField.ringMap_injective
#print axioms SubstructureField.fieldMap
#print axioms SubstructureField.fieldMap_agrees
