/-
# Stress tests for the residue-induction gap

## 1. The inclusion-only algebraic principle is FALSE

The mathematical engine of `ResidueInduction.lean` is:

  *inclusion* (`ker φ_M ≤ ker φ_N`, i.e. the polynomial relations among the units of `S` survive
  under `f`),
  *reflection* (`ker φ_N ≤ ker φ_M`, available because `f` is *injective*),
  so that the quotient by `ker φ_M` embeds in **both** `K(M)` and `K(N)` and its fraction field can be
  mapped to both.

Dropping reflection (the "tempting stronger form": quantifier-free *preservation* of the polynomial
type suffices) makes the statement false, and the failure is characteristic: the domain and the
codomain may then have different characteristics.  The counterexample is
`K = ℚ`, `L = ZMod 2`, `ι = Unit`, `u = v = 1`: every integer polynomial relation holding at `1` in
`ℚ` holds at `1` in `ZMod 2` (the relation is over `ℤ`, and `ℚ` has characteristic zero), yet no
subfield of `ℚ` admits a ring homomorphism to `ZMod 2`.

This is the honest reason the theorem in `ResidueInduction.lean` is stated for `S ↪[LRV] N` and not
for `S →[LRV] N`: injectivity is load-bearing, and it is also what forces the characteristics of
`K(M)` and `K(N)` to agree.

## 2. The gap closed is strictly weaker than `ACFExtends`

`ResidueInduced` only asks for a map on the subfield *generated by the units of `S`*; the total map
`K(M) →+* K(N)` is `M5Ledger.ACFExtends`, which is exactly the `⊤`-strengthening and needs the
saturation quote.  Machine-checked below.
-/
import ResidueInduction
import Mathlib

set_option autoImplicit false

open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0
open SpecialTransformations.Milestone0.StandingField

namespace M4Residue

/-! ### The counterexample -/

/-- Evaluation of an integer polynomial at the constant tuple `1` factors through `ℤ`, in any
commutative ring: the coefficient map is `Int.castRingHom`. -/
theorem eval_one_cast (R : Type) [CommRing R] :
    MvPolynomial.eval₂Hom (Int.castRingHom R) (fun _ : Unit => (1 : R)) =
      (Int.castRingHom R).comp
        (MvPolynomial.eval₂Hom (Int.castRingHom ℤ) (fun _ : Unit => (1 : ℤ))) := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simp
  · intro i
    cases i
    simp [MvPolynomial.eval₂Hom_X']

/-- **The inclusion-only principle is false.**  The statement below is the natural "quantifier-free
preservation" form of the algebraic step used in `ResidueInduction.lean`, with the reflection half
(`ker φ_N ≤ ker φ_M`, i.e. injectivity of `f`) removed. -/
theorem inclusion_only_is_false :
    ¬ (∀ (ι : Type) (K L : Type) [Field K] [Field L] (u : ι → K) (v : ι → L),
        (∀ p : MvPolynomial ι ℤ, MvPolynomial.eval₂Hom (Int.castRingHom K) u p = 0 →
          MvPolynomial.eval₂Hom (Int.castRingHom L) v p = 0) →
        ∃ (K' : Subfield K) (j : ↥K' →+* L), ∀ i, ∃ h : u i ∈ K', (j ⟨u i, h⟩ : L) = v i) := by
  intro H
  have hstep : ∀ p : MvPolynomial Unit ℤ,
      MvPolynomial.eval₂Hom (Int.castRingHom ℚ) (fun _ => (1 : ℚ)) p = 0 →
        MvPolynomial.eval₂Hom (Int.castRingHom (ZMod 2)) (fun _ => (1 : ZMod 2)) p = 0 := by
    intro p hp
    have hp' : (((MvPolynomial.eval₂Hom (Int.castRingHom ℤ) (fun _ => (1 : ℤ))) p : ℤ) : ℚ)
        = 0 := by
      rw [eval_one_cast ℚ, RingHom.comp_apply] at hp
      exact hp
    have hk : (MvPolynomial.eval₂Hom (Int.castRingHom ℤ) (fun _ => (1 : ℤ))) p = 0 := by
      apply Int.cast_injective (α := ℚ)
      rw [hp']
      simp
    rw [eval_one_cast (ZMod 2), RingHom.comp_apply, hk, map_zero]
  obtain ⟨K', j, hj⟩ := H Unit ℚ (ZMod 2) (fun _ => (1 : ℚ)) (fun _ => (1 : ZMod 2)) hstep
  obtain ⟨hmem, hval⟩ := hj ()
  have htwo : (2 : ↥K') ≠ 0 := by
    intro h
    have h2 : ((2 : ↥K') : ℚ) = ((0 : ↥K') : ℚ) := congrArg Subtype.val h
    have h3 : ((2 : ↥K') : ℚ) = (2 : ℚ) := map_ofNat (Subfield.subtype K') 2
    have h4 : ((0 : ↥K') : ℚ) = (0 : ℚ) := map_zero (Subfield.subtype K')
    rw [h3, h4] at h2
    norm_num at h2
  have hzj : j (2 : ↥K') = 0 := by
    rw [map_ofNat]
    exact ZMod.natCast_self 2
  have hz : (2 : ↥K') = 0 := by
    have hinj : Function.Injective j := RingHom.injective j
    exact hinj (by rw [hzj, map_zero])
  exact htwo hz

/-! ### The gap closed is not `ACFExtends` -/

section Strictness

variable {M N : Type} [LRV.Structure M] [LRV.Structure N]
  [hM : M ⊨ Axioms.ACVF] [hN : N ⊨ Axioms.ACVF]

/-- The `⊤`-form of `ResidueInduced` — a *total* map `K(M) →+* K(N)` agreeing with `f` on the units
of `S` — is exactly `M5Ledger.ACFExtends`, the ledger input whose discharge needs the saturation
quote.  So the theorem of `ResidueInduction.lean` does not supersede `acfExtends_of_universal`;
what it removes is the extra hypothesis `ResidueInduced` that file had to assume. -/
theorem acfExtends_of_top_version
    (h : ∀ (S : LRV.Substructure M) (f : S ↪[LRV] N),
      ∃ γ : KOf M →+* KOf N,
        ∀ (x : S) (hx : iUnits (x : M)), (γ ⟨(x : M), Or.inl hx⟩ : KOf N).1 = f x) :
    M5Ledger.ACFExtends (M := M) (N := N) :=
  fun S f => h S f

end Strictness

end M4Residue

#print axioms M4Residue.inclusion_only_is_false
#print axioms M4Residue.acfExtends_of_top_version
