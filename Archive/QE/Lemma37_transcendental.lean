    (K' := constSubfield) (RingEquiv.refl ↥constSubfield) (fun a => rfl) hX0 hX10
    (by rw [hX1, hX]) hord htrans htrans' hr
  have hleft : (Polynomial.aeval RatFunc.X) (Polynomial.X + 1 : Polynomial ↥constSubfield) =
      (RatFunc.X + 1 : RatFunc ℚ) := by simp
  have hmapid : (Polynomial.X + 1 : Polynomial ↥constSubfield).map
      (RingEquiv.refl ↥constSubfield : ↥constSubfield →+* ↥constSubfield) =
      (Polynomial.X + 1 : Polynomial ↥constSubfield) := by simp
