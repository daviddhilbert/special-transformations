module

/-
# Yin §8: the valuation topology as a `TopologicalSpace`, and Lemma `fun:almost:cont`

Part 2 of 2 (imports `Sec8AlmostCont.lean`).  There, the paper's phrase *"continuous with respect to
the valuation topology"* is rendered in the paper's own `go(ā, γ)`-ε-δ language; here that language is
connected to Mathlib's topology and the lemma is proved.

* `vfTop n` — the valuation topology on `VF^n` (`Tup M n 0`), the topology whose neighbourhood filter
  at `x` is generated by the open polydiscs `go(x, r̄)`;
* `nhds_vfTop` — the polydiscs are a neighbourhood base (`goNhds x` is exactly `𝓝 x`);
* `continuousAt_iff_goContAt`, `isClosed_iff_isClosedVF` — the `ε`-δ notions of `Sec8AlmostCont.lean`
  are Mathlib's `ContinuousAt` and `IsClosed`;
* `ClosureDefinable`, `ClosureDim` — the two closure facts of the paper's proof (`paper.tex:1869`,
  `1874`), as `Prop`-valued hypotheses;
* `fun_almost_cont` — **Lemma `fun:almost:cont` (`paper.tex:1864`), proved** from §3--§8 hypotheses
  (`FullDimOpenPoly`, `DimUnion`, `RegAway`, `ClosureDefinable`, `ClosureDim`, `BallFactsTop`, plus the
  definability of the discontinuous set), with the conclusion literally
  `∃ A, Definable S A ∧ IsClosed A ∧ dimVF S A < n ∧ ContinuousOn f Aᶜ`.  The dimension drop is
  `dimVF_discSet_lt` (`Sec8AlmostCont.lean`); the continuity on the complement is
  `continuousOn_compl_of_discSet_subset`, which is the paper's *"So it is enough to show that
  `dim_VF(Ā) < n`"*;
* `fun_almost_cont_ae` — the same in the paper's "almost everywhere" terminology (`paper.tex:1806`);
* `fun_almost_cont_conclusion_const` — the conclusion is satisfiable (`A = ∅` for a constant `f`).

The two extra ball facts on top of `BallFacts` (`BallFactsTop`: an admissible radius exists, and a
polydisc is open) are `Prop`-valued hypotheses, not axioms.
-/
public import Sec8AlmostCont

@[expose] public section

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open FirstOrder FirstOrder.Language
open Filter
open SpecialTransformations.Milestone0 (SP)

namespace SpecialTransformations.Milestone0
open LRV

namespace Sec8

open Sec4Dim

variable {M : Type*} [LRV.Structure M]

/-! ## The extra ball facts a topology needs -/

/-- `BallFacts` together with the two further elementary facts about the ball vocabulary that the
valuation topology needs: *there is an admissible radius* (`rv 1 ≠ 0`, so the index type of radii is
nonempty) and *open polydiscs are open* (each point of `go(a, r̄)` has an open polydisc around it
inside `go(a, r̄)`, the ultrametric inequality).  Both hold in every model of `ACVF`. -/
def BallFactsTop (M : Type*) [LRV.Structure M] : Prop :=
  BallFacts M ∧
  (∃ γ : M, iRV γ ∧ γ ≠ iRVZero) ∧
  (∀ {n : ℕ} (a : Tup M n 0) (r : Fin n → M), AdmRadius r → ∀ x : Tup M n 0,
    x ∈ goBox a r → ∃ s : Fin n → M, AdmRadius s ∧ goBox x s ⊆ goBox a r)

/-- The neighbourhood filter of `x` given by the open polydiscs around `x`. -/
def goNhds {n : ℕ} (x : Tup M n 0) : Filter (Tup M n 0) :=
  ⨅ r : {r : Fin n → M // AdmRadius r}, 𝓟 (goBox x r.1)

/-- **The valuation topology on `VF^n`**: the topology whose neighbourhood filter at `x` is generated
by the open polydiscs `go(x, r̄)` around `x`. -/
@[instance_reducible]
def vfTop (n : ℕ) : TopologicalSpace (Tup M n 0) :=
  TopologicalSpace.mkOfNhds (fun x => goNhds x)

attribute [local instance] vfTop

/-- There is at least one admissible radius (`rv 1`). -/
theorem nonempty_admRadius (hbt : BallFactsTop M) (n : ℕ) :
    Nonempty {r : Fin n → M // AdmRadius r} := by
  obtain ⟨-, ⟨γ, h1, h2⟩, -⟩ := hbt
  exact ⟨⟨fun _ => γ, fun _ => h1, fun _ => h2⟩⟩

/-- The open polydiscs around `x` are downward directed under inclusion, so they form a filter
basis. -/
theorem directed_goBox (hbt : BallFactsTop M) {n : ℕ} (x : Tup M n 0) :
    Directed (· ≥ ·) (fun r : {r : Fin n → M // AdmRadius r} => goBox x r.1) := by
  intro i j
  obtain ⟨t, ht, hsub⟩ := hbt.1.2.2.1 x i.1 j.1 i.2 j.2
  exact ⟨⟨t, ht⟩, fun y hy => (hsub hy).1, fun y hy => (hsub hy).2⟩

/-- **The open polydiscs around `x` form a basis of its neighbourhood filter.** -/
theorem hasBasis_goNhds (hbt : BallFactsTop M) {n : ℕ} (x : Tup M n 0) :
    (goNhds x).HasBasis (fun _ : {r : Fin n → M // AdmRadius r} => True)
      (fun r => goBox x r.1) := by
  haveI := nonempty_admRadius hbt n
  exact Filter.hasBasis_iInf_principal (directed_goBox hbt x)

/-- A set is a neighbourhood of `x` exactly when it contains an open polydisc around `x`. -/
theorem mem_goNhds_iff (hbt : BallFactsTop M) {n : ℕ} (x : Tup M n 0) {B : Set (Tup M n 0)} :
    B ∈ goNhds x ↔ ∃ r : Fin n → M, AdmRadius r ∧ goBox x r ⊆ B := by
  rw [(hasBasis_goNhds hbt x).mem_iff]
  constructor
  · rintro ⟨⟨r, hr⟩, -, hsub⟩
    exact ⟨r, hr, hsub⟩
  · rintro ⟨r, hr, hsub⟩
    exact ⟨⟨r, hr⟩, trivial, hsub⟩

/-- **The neighbourhood filter of `vfTop` is the filter of open polydiscs**: the polydiscs really do
form a neighbourhood base of the valuation topology. -/
theorem nhds_vfTop (hbt : BallFactsTop M) {n : ℕ} (x : Tup M n 0) :
    nhds x = goNhds x := by
  refine TopologicalSpace.nhds_mkOfNhds_of_hasBasis
    (n := fun y => goNhds y) (ι := fun _ => {r : Fin n → M // AdmRadius r})
    (p := fun _ _ => True) (s := fun y r => goBox y r.1) ?_ ?_ ?_ x
  · intro a
    exact hasBasis_goNhds hbt a
  · intro a i _
    exact mem_goBox_self hbt.1 a i.2
  · intro a i _
    rw [(hasBasis_goNhds hbt a).eventually_iff]
    exact ⟨i, trivial, fun y hy => (mem_goNhds_iff hbt y).mpr (hbt.2.2 a i.1 i.2 y hy)⟩

/-! ## Continuity and closedness in the valuation topology -/

/-- **The paper's `ε`-`δ` continuity is Mathlib's continuity** in the valuation topology. -/
theorem continuousAt_iff_goContAt (hbt : BallFactsTop M) {n m : ℕ} {f : Tup M n 0 → Tup M m 0}
    {x : Tup M n 0} : ContinuousAt f x ↔ GoContAt f x := by
  haveI := nonempty_admRadius hbt n
  haveI := nonempty_admRadius hbt m
  show Tendsto f (nhds x) (nhds (f x)) ↔ GoContAt f x
  rw [nhds_vfTop hbt x, nhds_vfTop hbt (f x),
    (hasBasis_goNhds hbt x).tendsto_iff (hasBasis_goNhds hbt (f x))]
  constructor
  · intro h r hr
    obtain ⟨s, -, hsub⟩ := h ⟨r, hr⟩ trivial
    exact ⟨s, s.2, hsub⟩
  · rintro h ⟨r, hr⟩ -
    obtain ⟨s, hs, hsub⟩ := h r hr
    exact ⟨⟨s, hs⟩, trivial, hsub⟩

/-- **`IsClosedVF` is Mathlib's `IsClosed`** in the valuation topology. -/
theorem isClosed_iff_isClosedVF (hbt : BallFactsTop M) {n : ℕ} {A : Set (Tup M n 0)} :
    IsClosed A ↔ IsClosedVF A := by
  have hmem : ∀ (B : Set (Tup M n 0)) (x : Tup M n 0),
      B ∈ nhds x ↔ ∃ r : Fin n → M, AdmRadius r ∧ goBox x r ⊆ B := by
    intro B x
    rw [nhds_vfTop hbt x]
    exact mem_goNhds_iff hbt x
  rw [← isOpen_compl_iff, isOpen_iff_mem_nhds]
  constructor
  · intro h x hx
    obtain ⟨r, hr, hsub⟩ := (hmem Aᶜ x).mp (h x hx)
    exact ⟨r, hr, fun y hy => hsub hy⟩
  · intro h x hx
    obtain ⟨r, hr, hsub⟩ := h x hx
    exact (hmem Aᶜ x).mpr ⟨r, hr, fun y hy => hsub y hy⟩

/-- Points of continuity are continuous in the valuation topology. -/
theorem continuousAt_of_notMem_discSet (hbt : BallFactsTop M) {n m : ℕ}
    {f : Tup M n 0 → Tup M m 0} {x : Tup M n 0} (hx : x ∉ DiscSet f) :
    ContinuousAt f x := by
  rw [continuousAt_iff_goContAt hbt, goContAt_iff_paper hbt.1]
  by_contra h
  exact hx h

/-- **The paper's step again** (`paper.tex:1876`), now in Mathlib's topology: if the discontinuity
set is contained in `A` then `f` is `ContinuousOn` the complement of `A`. -/
theorem continuousOn_compl_of_discSet_subset (hbt : BallFactsTop M) {n m : ℕ}
    {f : Tup M n 0 → Tup M m 0} {A : Set (Tup M n 0)} (h : DiscSet f ⊆ A) :
    ContinuousOn f Aᶜ := by
  intro x hx
  exact (continuousAt_of_notMem_discSet hbt (fun hc => hx (h hc))).continuousWithinAt

/-! ## Lemma `fun:almost:cont` in Mathlib's topology -/

/-- **The topological closure of a definable set is definable** (`paper.tex:1869`: *"Let `Ā` be the
topological closure of `A`, which is definable"*).  A consequence of `C`-minimality
(`Milestone0/Encoding.lean`'s `IsCMinimalWS`) and QE: the closure of a Boolean combination of balls
adds only finitely many centres. -/
def ClosureDefinable (S : SP M) : Prop :=
  ∀ {n : ℕ} (A : Set (Tup M n 0)), Definable S A → Definable S (closure A)

/-- **The closure does not raise the `VF`-dimension** — the paper's *"which, by Lemma
`full:dim:open:poly`, is equivalent to showing that `dim_VF(A) < n`"* (`paper.tex:1874`): for a
definable `A ⊆ VF^n`, `dim_VF(Ā) ≤ dim_VF(A)`.  (In a `C`-minimal structure the closure of a Boolean
combination of balls adds only finitely many centres, hence only `VF`-dimension `0`.) -/
def ClosureDim (S : SP M) : Prop :=
  ∀ {n : ℕ} (A : Set (Tup M n 0)), Definable S A → dimVF S (closure A) ≤ dimVF S A

/-- **Lemma `fun:almost:cont`** (`paper.tex:1864`), verbatim: *"Let `f : VF^n → VF^m` be a definable
function.  Then there is a definable closed subset `A ⊆ VF^n` with `dim_VF(A) < n` such that
`f ↾ (VF^n ∖ A)` is continuous with respect to the valuation topology."*

`A` is the topological closure of the set of discontinuous points of `f`: every point outside it is a
point of continuity (`continuousOn_compl_of_discSet_subset`), and the dimension drop
`dim_VF(Ā) < n` is `dimVF_discSet_lt` (the paper's second paragraph: `VF:fun:reg:away` and
`full:dim:open:poly` contradicting `dim_VF = n`) followed by `ClosureDim`.

`hn : 1 ≤ n` is the paper's tacit assumption: for `n = 0` the conclusion is empty, since
`dim_VF ≥ 0`.  The hypotheses are §3--§8 content, named with the paper's sentences: `FullDimOpenPoly`
(Lemma `full:dim:open:poly`), `DimUnion` (§4 subadditivity), `RegAway` (Lemma `VF:fun:reg:away`),
`ClosureDefinable` and `ClosureDim` (the closure step, `paper.tex:1869` and `1874`), `hD` (the
discontinuous set is definable), `BallFactsTop` (the ball vocabulary), and `hfun` (`f` definable). -/
theorem fun_almost_cont (S : SP M) {n m : ℕ} (hn : 1 ≤ n) (f : Tup M n 0 → Tup M m 0)
    (hbt : BallFactsTop M) (hfun : DefinableFun S Set.univ f)
    (hD : Definable S (DiscSet f)) (hclos : ClosureDefinable S) (hcldim : ClosureDim S)
    (hdimu : DimUnion S) (hfdop : FullDimOpenPoly S) (hreg : RegAway S f) :
    ∃ A : Set (Tup M n 0), Definable S A ∧ IsClosed A ∧ dimVF S A < n ∧
      ContinuousOn f Aᶜ := by
  have hdim : dimVF S (DiscSet f) < n :=
    dimVF_discSet_lt S f hbt.1 hdimu hfdop hreg hD
  exact ⟨closure (DiscSet f), hclos _ hD, isClosed_closure,
    lt_of_le_of_lt (hcldim _ hD) hdim, continuousOn_compl_of_discSet_subset hbt subset_closure⟩

/-- Lemma `fun:almost:cont` in the paper's "almost everywhere" terminology (`paper.tex:1806`): a
definable `f : VF^n → VF^m` is continuous at almost every point of `VF^n`. -/
theorem fun_almost_cont_ae (S : SP M) {n m : ℕ} (hn : 1 ≤ n) (f : Tup M n 0 → Tup M m 0)
    (hbt : BallFactsTop M) (hfun : DefinableFun S Set.univ f)
    (hD : Definable S (DiscSet f)) (hclos : ClosureDefinable S) (hcldim : ClosureDim S)
    (hdimu : DimUnion S) (hfdop : FullDimOpenPoly S) (hreg : RegAway S f) :
    AlmostEverywhere S n (fun x => GoContAt f x) := by
  obtain ⟨A, hA, hAcl, hAdim, hcont⟩ :=
    fun_almost_cont S hn f hbt hfun hD hclos hcldim hdimu hfdop hreg
  refine ⟨A, hA, hAdim, fun x hx => ?_⟩
  show GoContAt f x
  exact (continuousAt_iff_goContAt hbt).mp (hcont.continuousAt (hAcl.isOpen_compl.mem_nhds hx))

/-- The **conclusion of `fun:almost:cont` is satisfiable**: for a constant `f : VF^n → VF^m` with
`n ≥ 1` the set `A = ∅` is definable, closed in the valuation topology, of `VF`-dimension
`0 < n`, and `f` is continuous on its complement.  So the lemma's conclusion is not vacuous. -/
theorem fun_almost_cont_conclusion_const (S : SP M) {n m : ℕ} (hn : 1 ≤ n) (c : Tup M m 0) :
    ∃ A : Set (Tup M n 0), Definable S A ∧ IsClosed A ∧ dimVF S A < n ∧
      ContinuousOn (fun _ : Tup M n 0 => c) Aᶜ := by
  refine ⟨∅, definable_empty S, isClosed_empty, ?_, ?_⟩
  · rw [dimVF_empty S]
    exact hn
  · exact continuous_const.continuousOn

end Sec8

