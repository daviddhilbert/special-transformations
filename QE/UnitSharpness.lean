/-
# M7 / d6: the unit hypothesis of Lemma 3.6 is load-bearing

`UnitTranscend.lean` shows that Lemma 3.6's `Γ`-step is elementary **once `e` is a unit**, i.e. once
`vv(e) = 0`: then every term of an expansion `Σ bᵢeⁱ` is integral and reduction mod the maximal
ideal forbids cancellation.  It also shows the dimension-inequality quote is unnecessary there.

This file machine-checks the sharpness of that hypothesis: **dropping `e ∈ U(M)` makes the
conclusion `Γ(⟨Ŝ,e⟩) = Γ(Ŝ)` false**, even with the base value group trivial (hence divisible) and
`e` transcendental over the base field.  The model is the Hahn field `ℝ⟦ℤ⟧` with `addVal`, the base
field the constants `ℝ · 1`, and `e = t` the monomial at exponent `1`:

* `t` is transcendental over the constants (`t_transcendental`);
* `addVal t = 1` (`val_t`), while
* every nonzero constant has `addVal = 0` (`val_const`).

So the value group of the field generated by the base and `t` strictly contains the base's, and no
element of the base has the value of `t`: the tempting strengthening of Lemma 3.6 obtained by
deleting `e ∈ U(M)` (and with it the dimension-inequality/unit-reduction input) is false.  This is
the counterexample the hypothesis `e ∈ U(M)` excludes; it is why the paper's Lemma 3.5/3.6 case
split (unit vs. `eⁿ ∈ VF(Ŝ)`) cannot be collapsed.

No `sorry`, no `axiom`, no `native_decide`.
-/
import Mathlib

set_option autoImplicit false

namespace M7

/-- The monomial `t` of the Hahn field `ℝ⟦ℤ⟧`: the single term at exponent `1`. -/
noncomputable def ht : HahnSeries ℤ ℝ := HahnSeries.single 1 1

lemma ht_ne_zero : ht ≠ 0 := by
  rw [ht, Ne, HahnSeries.single_eq_zero_iff]
  norm_num

lemma ht_pow (n : ℕ) : ht ^ n = HahnSeries.single ((n : ℤ)) (1 : ℝ) := by
  rw [ht, HahnSeries.single_pow, nsmul_eq_mul, mul_one, one_pow]

/-- `t` is transcendental over the constant field `ℝ · 1` of the Hahn field. -/
theorem t_transcendental (n : ℕ) (c : Fin n → ℝ)
    (h : (∑ i, HahnSeries.single (0 : ℤ) (c i) * ht ^ (i : ℕ)) = 0) :
    ∀ i, c i = 0 := by
  classical
  have hterm : ∀ i : Fin n,
      HahnSeries.single (0 : ℤ) (c i) * ht ^ (i : ℕ) = HahnSeries.single ((i : ℕ) : ℤ) (c i) := by
    intro i
    rw [ht_pow, HahnSeries.single_mul_single]
    simp
  have hsum : (∑ i : Fin n, HahnSeries.single ((i : ℕ) : ℤ) (c i)) = 0 := by
    rw [← h]
    exact Finset.sum_congr rfl fun i _ => (hterm i).symm
  intro i₀
  have hcoeff := congrArg (fun x : HahnSeries ℤ ℝ => x.coeff ((i₀ : ℕ) : ℤ)) hsum
  rw [HahnSeries.coeff_sum, Finset.sum_eq_single i₀] at hcoeff
  · simpa using hcoeff
  · intro i _ hne
    rw [HahnSeries.coeff_single_of_ne]
    intro hcon
    exact hne (Fin.ext (Nat.cast_injective hcon.symm))
  · intro hnot
    exact absurd (Finset.mem_univ i₀) hnot

/-- `addVal t = 1`. -/
lemma val_t : HahnSeries.addVal ℤ ℝ ht = (1 : WithTop ℤ) := by
  rw [HahnSeries.addVal_apply_of_ne ht_ne_zero, ht,
    HahnSeries.order_single (by norm_num : (1 : ℝ) ≠ 0)]
  norm_num

/-- Every nonzero constant has value `0`: the base value group is trivial, hence divisible. -/
lemma val_const (r : ℝ) (hr : r ≠ 0) :
    HahnSeries.addVal ℤ ℝ (HahnSeries.single (0 : ℤ) r) = (0 : WithTop ℤ) := by
  have hne : HahnSeries.single (0 : ℤ) r ≠ 0 := by
    rwa [Ne, HahnSeries.single_eq_zero_iff]
  rw [HahnSeries.addVal_apply_of_ne hne, HahnSeries.order_single hr]
  simp

/-- **Sharpness: the unit hypothesis of Lemma 3.6 cannot be dropped.**  There is a valued field
(`ℝ⟦ℤ⟧` with `addVal`), a base field (the constants, whose value group `{0}` is divisible) and an
element `e` transcendental over it, such that `vv(e) = 1` is *not* the value of any nonzero base
element — so `Γ` grows and Lemma 3.6's conclusion `Γ(⟨Ŝ,e⟩) = Γ(Ŝ)` fails while every hypothesis
but `e ∈ U(M)` holds. -/
theorem unit_hypothesis_essential :
    (∀ (n : ℕ) (c : Fin n → ℝ),
        (∑ i, HahnSeries.single (0 : ℤ) (c i) * ht ^ (i : ℕ)) = 0 → ∀ i, c i = 0)
      ∧ HahnSeries.addVal ℤ ℝ ht = (1 : WithTop ℤ)
      ∧ (∀ r : ℝ, r ≠ 0 →
          HahnSeries.addVal ℤ ℝ (HahnSeries.single (0 : ℤ) r) = (0 : WithTop ℤ))
      ∧ (∀ r : ℝ, r ≠ 0 → HahnSeries.addVal ℤ ℝ (HahnSeries.single (0 : ℤ) r)
          ≠ HahnSeries.addVal ℤ ℝ ht)
      ∧ (1 : WithTop ℤ) ≠ 0 := by
  refine ⟨t_transcendental, val_t, val_const, ?_, by norm_num⟩
  intro r hr hcon
  rw [val_const r hr, val_t] at hcon
  exact absurd hcon.symm (by norm_num)

#print axioms M7.t_transcendental
#print axioms M7.unit_hypothesis_essential

end M7
