/-
**`acl(S)` is a field**: the `VF`-part of the algebraic closure of `S` is closed under `+`, `-`,
`×` and inverse, so it is a subfield of the `VF`-sort containing `VF(S)`, the field generated by
the `VF`-parameters.  This is the first half of paper.tex item 742 (`aclS:model`, Yin
QE:ACVF:min Corollary 4.18: *"Suppose that `S` is `VF`-generated.  If the value group `Γ(acl(S))` is
nontrivial then `acl(S)` is a model of `ACVF_S(0,0)`"*): a model has to be a field, and the frozen
`SP.acl` is the syntactic algebraic closure of `QE/Sec3_frozen.lean`, so the field laws have to be
proved at the level of the encoding's formulas.

The statements are about the frozen `SP.acl`, which is `VF`-sorted only; the field structure on the
sort is `QE/VFField.lean`'s `Transfer.vfFieldOfModel`, and every proof here is carried out on the
carrier (`iVFAdd`, `iVFMul`, ...), so no `Field` instance is needed except in the final `VFGen`
statements, where it is supplied explicitly.

The two formula-level gadgets are `QE/SubstVar.lean` (`substVar`: replace the free variable of a
formula by a term) and the encoding's guarded existential `exSortedG`
(`Milestone0/Encoding.lean`, realised by `QE/ExSortedG.lean`): `acl` is a *syntactic* notion, so
"the set of `x + y` for `x ∈ A`, `y ∈ B`" has to be written as one well-sorted formula, and the
guarded existential is the only quantifier shape `WellSorted` admits.

No `sorry`, no `axiom`, no `native_decide`.
-/
import Enc
import Sat
import Sec3Frozen
import VFField
import SubstVar
import ExSortedG

set_option maxHeartbeats 1000000
set_option linter.unusedVariables false
set_option backward.isDefEq.respectTransparency false

open FirstOrder FirstOrder.Language
open scoped FirstOrder

namespace SpecialTransformations.Milestone0
open LRV

namespace SP

open Transfer
open Sec4Compose

variable {M : Type} [LRV.Structure M]

/-! ## Terms of the well-sorted fragment, at a general parameter type -/

/-- The variable block `x_0 ... x_{k-1}`, all of the `VF` sort. -/
def vfSn (k : ℕ) : Fin k → SortTag := fun _ => SortTag.vf

/-- the `i`-th variable -/
def gv {α : Type} {k : ℕ} (i : Fin k) : LRV.Term (α ⊕ Fin k) := Term.var (Sum.inr i)

/-- `0` of the `VF` sort -/
def gZero {α : Type} {k : ℕ} : LRV.Term (α ⊕ Fin k) := Term.func Fn.vfZero fun i => i.elim0

/-- `1` of the `VF` sort -/
def gOne {α : Type} {k : ℕ} : LRV.Term (α ⊕ Fin k) := Term.func Fn.vfOne fun i => i.elim0

/-- `+` of the `VF` sort -/
def gAdd {α : Type} {k : ℕ} (a b : LRV.Term (α ⊕ Fin k)) : LRV.Term (α ⊕ Fin k) :=
  Term.func Fn.vfAdd ![a, b]

/-- `-` of the `VF` sort -/
def gNeg {α : Type} {k : ℕ} (a : LRV.Term (α ⊕ Fin k)) : LRV.Term (α ⊕ Fin k) :=
  Term.func Fn.vfNeg ![a]

/-- `×` of the `VF` sort -/
def gMul {α : Type} {k : ℕ} (a b : LRV.Term (α ⊕ Fin k)) : LRV.Term (α ⊕ Fin k) :=
  Term.func Fn.vfMul ![a, b]

variable {α : Type} (sα : α → SortTag) {k : ℕ} (sn : Fin k → SortTag)

theorem tmSort_gv (i : Fin k) (hi : sn i = SortTag.vf) :
    TmSort sα sn (gv i) = some SortTag.vf := by
  rw [gv, tmSort_var_inr, hi]

theorem tmSort_gZero : TmSort sα sn (gZero (α := α) (k := k)) = some SortTag.vf :=
  tmSort_func sα sn Fn.vfZero _ (fun i => i.elim0)

theorem tmSort_gOne : TmSort sα sn (gOne (α := α) (k := k)) = some SortTag.vf :=
  tmSort_func sα sn Fn.vfOne _ (fun i => i.elim0)

theorem tmSort_gAdd {a b : LRV.Term (α ⊕ Fin k)}
    (ha : TmSort sα sn a = some SortTag.vf) (hb : TmSort sα sn b = some SortTag.vf) :
    TmSort sα sn (gAdd a b) = some SortTag.vf := by
  rw [gAdd, tmSort_vfAdd]
  exact ⟨ha, hb⟩

theorem tmSort_gNeg {a : LRV.Term (α ⊕ Fin k)}
    (ha : TmSort sα sn a = some SortTag.vf) :
    TmSort sα sn (gNeg a) = some SortTag.vf := by
  rw [gNeg, tmSort_vfNeg]
  exact ha

theorem tmSort_gMul {a b : LRV.Term (α ⊕ Fin k)}
    (ha : TmSort sα sn a = some SortTag.vf) (hb : TmSort sα sn b = some SortTag.vf) :
    TmSort sα sn (gMul a b) = some SortTag.vf := by
  rw [gMul, tmSort_vfMul]
  exact ⟨ha, hb⟩

/-! ## Realization of those terms -/

theorem realize_gv (v : α → M) (xs : Fin k → M) (i : Fin k) :
    Term.realize (Sum.elim v xs) (gv i) = xs i := rfl

theorem realize_gZero (v : α → M) (xs : Fin k → M) :
    Term.realize (Sum.elim v xs) (gZero (α := α) (k := k)) = iVFZero := by
  show FirstOrder.Language.Structure.funMap (L := LRV) Fn.vfZero
      (fun i => Term.realize (L := LRV) (Sum.elim v xs) ((fun j : Fin 0 => j.elim0) i)) = iVFZero
  rw [show (fun i => Term.realize (L := LRV) (Sum.elim v xs) ((fun j : Fin 0 => j.elim0) i))
      = (fun i => i.elim0) from by funext i; exact i.elim0]
  rfl

theorem realize_gOne (v : α → M) (xs : Fin k → M) :
    Term.realize (Sum.elim v xs) (gOne (α := α) (k := k)) = iVFOne := by
  show FirstOrder.Language.Structure.funMap (L := LRV) Fn.vfOne
      (fun i => Term.realize (L := LRV) (Sum.elim v xs) ((fun j : Fin 0 => j.elim0) i)) = iVFOne
  rw [show (fun i => Term.realize (L := LRV) (Sum.elim v xs) ((fun j : Fin 0 => j.elim0) i))
      = (fun i => i.elim0) from by funext i; exact i.elim0]
  rfl

theorem realize_gAdd (v : α → M) (xs : Fin k → M) (a b : LRV.Term (α ⊕ Fin k)) :
    Term.realize (Sum.elim v xs) (gAdd a b)
      = iVFAdd (Term.realize (Sum.elim v xs) a) (Term.realize (Sum.elim v xs) b) := by
  have h : (fun i : Fin 2 => Term.realize (Sum.elim v xs) (![a, b] i))
      = ![Term.realize (Sum.elim v xs) a, Term.realize (Sum.elim v xs) b] := by
    funext i
    fin_cases i <;> rfl
  show FirstOrder.Language.Structure.funMap (L := LRV) Fn.vfAdd
      (fun i => Term.realize (Sum.elim v xs) (![a, b] i)) = _
  rw [h]
  rfl

theorem realize_gNeg (v : α → M) (xs : Fin k → M) (a : LRV.Term (α ⊕ Fin k)) :
    Term.realize (Sum.elim v xs) (gNeg a)
      = iVFNeg (Term.realize (Sum.elim v xs) a) := by
  have h : (fun i : Fin 1 => Term.realize (Sum.elim v xs) (![a] i))
      = ![Term.realize (Sum.elim v xs) a] := by
    funext i
    fin_cases i
    rfl
  show FirstOrder.Language.Structure.funMap (L := LRV) Fn.vfNeg
      (fun i => Term.realize (Sum.elim v xs) (![a] i)) = _
  rw [h]
  rfl

theorem realize_gMul (v : α → M) (xs : Fin k → M) (a b : LRV.Term (α ⊕ Fin k)) :
    Term.realize (Sum.elim v xs) (gMul a b)
      = iVFMul (Term.realize (Sum.elim v xs) a) (Term.realize (Sum.elim v xs) b) := by
  have h : (fun i : Fin 2 => Term.realize (Sum.elim v xs) (![a, b] i))
      = ![Term.realize (Sum.elim v xs) a, Term.realize (Sum.elim v xs) b] := by
    funext i
    fin_cases i <;> rfl
  show FirstOrder.Language.Structure.funMap (L := LRV) Fn.vfMul
      (fun i => Term.realize (Sum.elim v xs) (![a, b] i)) = _
  rw [h]
  rfl

/-! ## Equation atoms and guarded existentials, one and two variables -/

/-- `X = t`, well-sorted when `t` is a `VF`-term. -/
theorem wellSorted_gEq (t : LRV.Term (α ⊕ Fin 1)) (ht : TmSort sα (vfSn 1) t = some SortTag.vf) :
    WellSorted sα (vfSn 1) (pEqG (gv (0 : Fin 1)) t) := by
  refine wellSorted_pEqG sα (vfSn 1) ?_ ht
  exact tmSort_gv sα (vfSn 1) 0 rfl

theorem realize_gEq (t : LRV.Term (α ⊕ Fin 1)) (v : α → M) (X : M) :
    (pEqG (gv (0 : Fin 1)) t).Realize v ![X] ↔ X = Term.realize (Sum.elim v ![X]) t := by
  rw [pEqG, BoundedFormula.realize_bdEqual, realize_gv]
  simp

theorem snoc_vec_one (X a : M) : Fin.snoc ![X] a = ![X, a] := by
  funext i
  fin_cases i <;> simp

theorem snoc_vec_two (X a b : M) : Fin.snoc ![X, a] b = ![X, a, b] := by
  funext i
  fin_cases i <;> simp

/-- The realization of the guarded existential in one variable. -/
theorem exSortedG_one_realize (s : SortTag) (ψ : LRV.BoundedFormula α 2) (v : α → M) (X : M) :
    (exSortedG s ψ).Realize v ![X] ↔
      ∃ a : M, sortEval s a ∧ ψ.Realize v (Fin.snoc ![X] a) :=
  exSortedG_realize (M := M) s ψ v ![X]

/-- The realization of the guarded existential in two variables. -/
theorem exSortedG_two_realize (s : SortTag) (ψ : LRV.BoundedFormula α 3) (v : α → M)
    (X a : M) :
    (exSortedG s ψ).Realize v ![X, a] ↔
      ∃ b : M, sortEval s b ∧ ψ.Realize v (Fin.snoc ![X, a] b) :=
  exSortedG_realize (M := M) s ψ v ![X, a]

theorem exSortedG_two_realize' (s : SortTag) (ψ : LRV.BoundedFormula α 3) (v : α → M)
    (X a : M) :
    (exSortedG s ψ).Realize v ![X, a] ↔
      ∃ b : M, sortEval s b ∧ ψ.Realize v ![X, a, b] := by
  rw [exSortedG_two_realize]
  exact ⟨fun ⟨b, hb, h⟩ => ⟨b, hb, by rwa [snoc_vec_two] at h⟩,
    fun ⟨b, hb, h⟩ => ⟨b, hb, by rwa [snoc_vec_two]⟩⟩

/-! ## Converting the `Fin 1` tuple -/

theorem vecOne (a : M) : (![a] : Fin 1 → M) = fun _ => a := by
  funext i
  fin_cases i
  rfl

theorem realize_vecOne (φ : LRV.BoundedFormula α 1) (v : α → M) (a : M) :
    φ.Realize v ![a] ↔ φ.Realize v (fun _ => a) := by
  rw [vecOne a]

theorem snoc_vfSn (k : ℕ) : Fin.snoc (vfSn k) SortTag.vf = vfSn (k + 1) := by
  funext i
  refine Fin.lastCases ?_ ?_ i
  · rw [Fin.snoc_last]
    rfl
  · intro j
    rw [Fin.snoc_castSucc]
    rfl

/-- The guarded existential of a `VF`-body is well-sorted. -/
theorem wellSorted_exVF {α : Type} (sα : α → SortTag) {k : ℕ}
    {φ : LRV.BoundedFormula α (k + 1)}
    (h : WellSorted sα (vfSn (k + 1)) φ) :
    WellSorted sα (vfSn k) (exSortedG SortTag.vf φ) := by
  refine wellSorted_exSortedG sα ?_
  rw [snoc_vfSn]
  exact h

/-! ## The equation atom at an arbitrary variable block -/

theorem realize_gEq2 {α : Type} (t : LRV.Term (α ⊕ Fin 2)) (v : α → M)
    (ys : Fin 2 → M) :
    (pEqG (gv (0 : Fin 2)) t).Realize v ys ↔ ys 0 = Term.realize (Sum.elim v ys) t := by
  rw [pEqG, BoundedFormula.realize_bdEqual, realize_gv]

theorem wellSorted_gEq2 {α : Type} (sα : α → SortTag) (sn : Fin 2 → SortTag)
    (h0 : sn 0 = SortTag.vf) {t : LRV.Term (α ⊕ Fin 2)}
    (ht : TmSort sα sn t = some SortTag.vf) :
    WellSorted sα sn (pEqG (gv (0 : Fin 2)) t) :=
  wellSorted_pEqG sα sn (tmSort_gv sα sn 0 h0) ht

theorem realize_gEq3 {α : Type} (t : LRV.Term (α ⊕ Fin 3)) (v : α → M)
    (ys : Fin 3 → M) :
    (pEqG (gv (0 : Fin 3)) t).Realize v ys ↔ ys 0 = Term.realize (Sum.elim v ys) t := by
  rw [pEqG, BoundedFormula.realize_bdEqual, realize_gv]

theorem vec3_zero (a b c : M) : (![a, b, c] : Fin 3 → M) 0 = a := rfl

theorem vec3_one (a b c : M) : (![a, b, c] : Fin 3 → M) 1 = b := rfl

theorem vec3_two (a b c : M) : (![a, b, c] : Fin 3 → M) 2 = c := rfl

/-! ## The carrier-level algebra of `+` -/

theorem add_neg_cancel_right {M : Type} [LRV.Structure M] (hM : M ⊨ Axioms.ACVF)
    {y a : M} (hy : iVF y) (ha : iVF a) :
    iVFAdd a (iVFAdd y (iVFNeg a)) = y := by
  have h1 : iVFAdd a (iVFAdd y (iVFNeg a)) = iVFAdd (iVFAdd a y) (iVFNeg a) :=
    (Transfer.vf_add_assoc hM ha hy (Transfer.vf_neg_mem hM ha)).symm
  have h2 : iVFAdd (iVFAdd a y) (iVFNeg a) = iVFAdd (iVFAdd y a) (iVFNeg a) := by
    rw [Transfer.vf_add_comm hM ha hy]
  have h3 : iVFAdd (iVFAdd y a) (iVFNeg a) = iVFAdd y (iVFAdd a (iVFNeg a)) :=
    Transfer.vf_add_assoc hM hy ha (Transfer.vf_neg_mem hM ha)
  have h4 : iVFAdd y (iVFAdd a (iVFNeg a)) = iVFAdd y iVFZero := by
    rw [Transfer.vf_add_neg hM ha]
  have h5 : iVFAdd y iVFZero = y := Transfer.vf_add_zero hM hy
  exact h1.trans (h2.trans (h3.trans (h4.trans h5)))

theorem add_cancel_left {M : Type} [LRV.Structure M] (hM : M ⊨ Axioms.ACVF)
    {x y : M} (hx : iVF x) (hy : iVF y) :
    iVFAdd (iVFAdd x y) (iVFNeg x) = y := by
  have h1 : iVFAdd (iVFAdd x y) (iVFNeg x) = iVFAdd (iVFAdd y x) (iVFNeg x) := by
    rw [Transfer.vf_add_comm hM hx hy]
  have h2 : iVFAdd (iVFAdd y x) (iVFNeg x) = iVFAdd y (iVFAdd x (iVFNeg x)) :=
    Transfer.vf_add_assoc hM hy hx (Transfer.vf_neg_mem hM hx)
  have h3 : iVFAdd y (iVFAdd x (iVFNeg x)) = iVFAdd y iVFZero := by
    rw [Transfer.vf_add_neg hM hx]
  exact h1.trans (h2.trans (h3.trans (Transfer.vf_add_zero hM hy)))

theorem mul_inv_unique {M : Type} [LRV.Structure M] (hM : M ⊨ Axioms.ACVF)
    {a z z' : M} (ha : iVF a) (hz : iVF z) (hz' : iVF z')
    (h : iVFMul a z = iVFOne) (h' : iVFMul a z' = iVFOne) : z = z' := by
  have h1 : z = iVFMul z iVFOne := (Transfer.vf_mul_one hM hz).symm
  have h2 : iVFMul z iVFOne = iVFMul z (iVFMul a z') := by rw [h']
  have h3 : iVFMul z (iVFMul a z') = iVFMul (iVFMul z a) z' :=
    (Transfer.vf_mul_assoc hM hz ha hz').symm
  have h4 : iVFMul (iVFMul z a) z' = iVFMul (iVFMul a z) z' := by
    rw [Transfer.vf_mul_comm hM hz ha]
  have h5 : iVFMul (iVFMul a z) z' = iVFMul iVFOne z' := by rw [h]
  have h6 : iVFMul iVFOne z' = z' := by
    rw [Transfer.vf_mul_comm hM (Transfer.vf_one_mem hM) hz']
    exact Transfer.vf_mul_one hM hz'
  exact h1.trans (h2.trans (h3.trans (h4.trans (h5.trans h6))))

/-! ## `0`, `1` and the `VF`-parameters are algebraic -/

theorem acl_zero (hM : M ⊨ Axioms.ACVF) (S : SP M) : acl S iVFZero := by
  refine ⟨pEqG (gv (0 : Fin 1)) (gZero (α := Fin S.n ⊕ Fin S.m) (k := 1)), ?_, ?_, ?_, ?_⟩
  · exact wellSorted_pEqG S.sortMap (vfSn 1) (tmSort_gv S.sortMap (vfSn 1) 0 rfl)
      (tmSort_gZero S.sortMap (vfSn 1))
  · refine (Set.finite_singleton iVFZero).subset ?_
    rintro y ⟨-, hy⟩
    rw [realize_gEq] at hy
    rw [realize_gZero] at hy
    exact hy
  · exact Transfer.vf_zero_mem hM
  · rw [realize_gEq, realize_gZero]

theorem acl_one (hM : M ⊨ Axioms.ACVF) (S : SP M) : acl S iVFOne := by
  refine ⟨pEqG (gv (0 : Fin 1)) (gOne (α := Fin S.n ⊕ Fin S.m) (k := 1)), ?_, ?_, ?_, ?_⟩
  · exact wellSorted_pEqG S.sortMap (vfSn 1) (tmSort_gv S.sortMap (vfSn 1) 0 rfl)
      (tmSort_gOne S.sortMap (vfSn 1))
  · refine (Set.finite_singleton iVFOne).subset ?_
    rintro y ⟨-, hy⟩
    rw [realize_gEq] at hy
    rw [realize_gOne] at hy
    exact hy
  · exact Transfer.vf_one_mem hM
  · rw [realize_gEq, realize_gOne]

theorem acl_param (hM : M ⊨ Axioms.ACVF) (S : SP M) (i : Fin S.n) : acl S (S.vf i) := by
  have htm : TmSort S.sortMap (vfSn 1) (gv (0 : Fin 1)) = some SortTag.vf :=
    tmSort_gv S.sortMap (vfSn 1) 0 rfl
  have ht : TmSort S.sortMap (vfSn 1) (Term.var (Sum.inl (Sum.inl i))) = some SortTag.vf := by
    rw [tmSort_var_inl]
    rfl
  refine ⟨pEqG (gv (0 : Fin 1)) (Term.var (Sum.inl (Sum.inl i))),
    wellSorted_pEqG S.sortMap (vfSn 1) htm ht, ?_, S.vf_sorted i, ?_⟩
  · refine (Set.finite_singleton (S.vf i)).subset ?_
    rintro y ⟨-, hy⟩
    rw [pEqG, BoundedFormula.realize_bdEqual] at hy
    simp only [realize_gv, Term.realize_var, toFun, Sum.elim_inl] at hy
    exact hy
  · rw [pEqG, BoundedFormula.realize_bdEqual]
    simp only [realize_gv, Term.realize_var, toFun, Sum.elim_inl, Matrix.cons_val_fin_one]

/-! ## Negation -/

theorem acl_neg (hM : M ⊨ Axioms.ACVF) {S : SP M} {x : M} (hx : acl S x) :
    acl S (iVFNeg x) := by
  obtain ⟨φ, hφws, hφfin, hxVF, hφx⟩ := hx
  classical
  set body : LRV.BoundedFormula (Fin S.n ⊕ Fin S.m) 2 :=
    BoundedFormula.substVar (fun _ => gv (1 : Fin 2)) φ ⊓
      pEqG (gv (0 : Fin 2)) (gNeg (gv (1 : Fin 2))) with hbody
  have hws1 : WellSorted S.sortMap (vfSn 2)
      (BoundedFormula.substVar (fun _ => gv (1 : Fin 2)) φ) :=
    wellSorted_substVar S.sortMap hφws (by
      intro i
      exact tmSort_gv S.sortMap (vfSn 2) 1 rfl)
  have hws2 : WellSorted S.sortMap (vfSn 2)
      (pEqG (gv (0 : Fin 2)) (gNeg (gv (1 : Fin 2)))) :=
    wellSorted_pEqG S.sortMap (vfSn 2)
      (tmSort_gv S.sortMap (vfSn 2) 0 rfl)
      (tmSort_gNeg S.sortMap (vfSn 2) (tmSort_gv S.sortMap (vfSn 2) 1 rfl))
  have hbodyReal : ∀ (X a : M), body.Realize S.toFun ![X, a] ↔
      φ.Realize S.toFun ![a] ∧ X = iVFNeg a := by
    intro X a
    rw [hbody, BoundedFormula.realize_inf, realize_substVar, realize_gEq2]
    simp only [realize_gv, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      realize_gNeg]
    rw [realize_vecOne]
  refine ⟨exSortedG SortTag.vf body, ?_, ?_, Transfer.vf_neg_mem hM hxVF, ?_⟩
  · exact wellSorted_exVF S.sortMap (wellSorted_inf S.sortMap (vfSn 2) hws1 hws2)
  · refine (hφfin.image (fun a => iVFNeg a)).subset ?_
    rintro y ⟨-, hy⟩
    rw [exSortedG_one_realize] at hy
    obtain ⟨a, haVF, ha⟩ := hy
    rw [snoc_vec_one, hbodyReal] at ha
    exact ⟨a, ⟨haVF, ha.1⟩, ha.2.symm⟩
  · rw [exSortedG_one_realize]
    exact ⟨x, hxVF, by rw [snoc_vec_one, hbodyReal]; exact ⟨hφx, rfl⟩⟩

/-! ## Addition -/

theorem acl_add (hM : M ⊨ Axioms.ACVF) {S : SP M} {x y : M} (hx : acl S x) (hy : acl S y) :
    acl S (iVFAdd x y) := by
  obtain ⟨φ, hφws, hφfin, hxVF, hφx⟩ := hx
  obtain ⟨ψ, hψws, hψfin, hyVF, hψy⟩ := hy
  classical
  set body : LRV.BoundedFormula (Fin S.n ⊕ Fin S.m) 2 :=
    BoundedFormula.substVar (fun _ => gv (1 : Fin 2)) φ ⊓
      BoundedFormula.substVar (fun _ => gAdd (gv (0 : Fin 2)) (gNeg (gv (1 : Fin 2)))) ψ
    with hbody
  have hws1 : WellSorted S.sortMap (vfSn 2)
      (BoundedFormula.substVar (fun _ => gv (1 : Fin 2)) φ) :=
    wellSorted_substVar S.sortMap hφws (by
      intro i
      exact tmSort_gv S.sortMap (vfSn 2) 1 rfl)
  have hws2 : WellSorted S.sortMap (vfSn 2)
      (BoundedFormula.substVar (fun _ => gAdd (gv (0 : Fin 2)) (gNeg (gv (1 : Fin 2)))) ψ) :=
    wellSorted_substVar S.sortMap hψws (by
      intro i
      exact tmSort_gAdd S.sortMap (vfSn 2) (tmSort_gv S.sortMap (vfSn 2) 0 rfl)
        (tmSort_gNeg S.sortMap (vfSn 2) (tmSort_gv S.sortMap (vfSn 2) 1 rfl)))
  have hbodyReal : ∀ (X a : M), body.Realize S.toFun ![X, a] ↔
      φ.Realize S.toFun ![a] ∧ ψ.Realize S.toFun (fun _ => iVFAdd X (iVFNeg a)) := by
    intro X a
    rw [hbody, BoundedFormula.realize_inf, realize_substVar, realize_substVar]
    simp only [realize_gv, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      realize_gAdd, realize_gNeg]
    rw [realize_vecOne]
  refine ⟨exSortedG SortTag.vf body, ?_, ?_, Transfer.vf_add_mem hM hxVF hyVF, ?_⟩
  · exact wellSorted_exVF S.sortMap (wellSorted_inf S.sortMap (vfSn 2) hws1 hws2)
  · refine ((hφfin.prod hψfin).image (fun p : M × M => iVFAdd p.1 p.2)).subset ?_
    rintro z ⟨hzVF, hz⟩
    rw [exSortedG_one_realize] at hz
    obtain ⟨a, haVF, ha⟩ := hz
    rw [snoc_vec_one, hbodyReal] at ha
    obtain ⟨hφa, hψa⟩ := ha
    have hbVF : iVF (iVFAdd z (iVFNeg a)) :=
      Transfer.vf_add_mem hM hzVF (Transfer.vf_neg_mem hM haVF)
    exact ⟨(a, iVFAdd z (iVFNeg a)), ⟨⟨haVF, hφa⟩, ⟨hbVF, (realize_vecOne ψ S.toFun _).2 hψa⟩⟩,
      add_neg_cancel_right hM hzVF haVF⟩
  · rw [exSortedG_one_realize]
    refine ⟨x, hxVF, ?_⟩
    rw [snoc_vec_one, hbodyReal]
    refine ⟨hφx, ?_⟩
    rw [show iVFAdd (iVFAdd x y) (iVFNeg x) = y from add_cancel_left hM hxVF hyVF]
    exact (realize_vecOne ψ S.toFun y).1 hψy

/-! ## Multiplication -/

theorem acl_mul (hM : M ⊨ Axioms.ACVF) {S : SP M} {x y : M} (hx : acl S x) (hy : acl S y) :
    acl S (iVFMul x y) := by
  obtain ⟨φ, hφws, hφfin, hxVF, hφx⟩ := hx
  obtain ⟨ψ, hψws, hψfin, hyVF, hψy⟩ := hy
  classical
  set body3 : LRV.BoundedFormula (Fin S.n ⊕ Fin S.m) 3 :=
    BoundedFormula.substVar (fun _ => gv (1 : Fin 3)) φ ⊓
      (BoundedFormula.substVar (fun _ => gv (2 : Fin 3)) ψ ⊓
        pEqG (gv (0 : Fin 3)) (gMul (gv (1 : Fin 3)) (gv (2 : Fin 3)))) with hbody3
  have hws31 : WellSorted S.sortMap (vfSn 3)
      (BoundedFormula.substVar (fun _ => gv (1 : Fin 3)) φ) :=
    wellSorted_substVar S.sortMap hφws (by
      intro i
      exact tmSort_gv S.sortMap (vfSn 3) 1 rfl)
  have hws32 : WellSorted S.sortMap (vfSn 3)
      (BoundedFormula.substVar (fun _ => gv (2 : Fin 3)) ψ) :=
    wellSorted_substVar S.sortMap hψws (by
      intro i
      exact tmSort_gv S.sortMap (vfSn 3) 2 rfl)
  have hws33 : WellSorted S.sortMap (vfSn 3)
      (pEqG (gv (0 : Fin 3)) (gMul (gv (1 : Fin 3)) (gv (2 : Fin 3)))) :=
    wellSorted_pEqG S.sortMap (vfSn 3)
      (tmSort_gv S.sortMap (vfSn 3) 0 rfl)
      (tmSort_gMul S.sortMap (vfSn 3) (tmSort_gv S.sortMap (vfSn 3) 1 rfl)
        (tmSort_gv S.sortMap (vfSn 3) 2 rfl))
  have hws3 : WellSorted S.sortMap (vfSn 3) body3 :=
    wellSorted_inf S.sortMap (vfSn 3) hws31 (wellSorted_inf S.sortMap (vfSn 3) hws32 hws33)
  have hbody3Real : ∀ (X a b : M), body3.Realize S.toFun ![X, a, b] ↔
      φ.Realize S.toFun ![a] ∧ ψ.Realize S.toFun ![b] ∧ X = iVFMul a b := by
    intro X a b
    rw [hbody3, BoundedFormula.realize_inf, BoundedFormula.realize_inf, realize_substVar,
      realize_substVar, realize_gEq3]
    simp only [realize_gv, vec3_zero, vec3_one, vec3_two, realize_gMul]
    rw [realize_vecOne, realize_vecOne]
  have hinnerReal : ∀ (X a : M),
      (exSortedG SortTag.vf body3).Realize S.toFun ![X, a] ↔
        ∃ b : M, iVF b ∧ φ.Realize S.toFun ![a] ∧ ψ.Realize S.toFun ![b] ∧
          X = iVFMul a b := by
    intro X a
    rw [exSortedG_two_realize']
    constructor
    · rintro ⟨b, hb, hb'⟩
      rw [hbody3Real] at hb'
      exact ⟨b, hb, hb'.1, hb'.2⟩
    · rintro ⟨b, hb, h1, h2⟩
      exact ⟨b, hb, by rw [hbody3Real]; exact ⟨h1, h2⟩⟩
  set inner : LRV.BoundedFormula (Fin S.n ⊕ Fin S.m) 2 := exSortedG SortTag.vf body3
    with hinner
  have hinnerWS : WellSorted S.sortMap (vfSn 2) inner :=
    wellSorted_exVF S.sortMap hws3
  refine ⟨exSortedG SortTag.vf inner, ?_, ?_, Transfer.vf_mul_mem hM hxVF hyVF, ?_⟩
  · exact wellSorted_exVF S.sortMap hinnerWS
  · refine ((hφfin.prod hψfin).image (fun p : M × M => iVFMul p.1 p.2)).subset ?_
    rintro z ⟨-, hz⟩
    rw [exSortedG_one_realize] at hz
    obtain ⟨a, haVF, ha⟩ := hz
    rw [snoc_vec_one, hinnerReal] at ha
    obtain ⟨b, hbVF, hφa, hψb, hzab⟩ := ha
    exact ⟨(a, b), ⟨⟨haVF, hφa⟩, ⟨hbVF, hψb⟩⟩, hzab.symm⟩
  · rw [exSortedG_one_realize]
    refine ⟨x, hxVF, ?_⟩
    rw [snoc_vec_one, hinnerReal]
    exact ⟨y, hyVF, hφx, hψy, rfl⟩

/-! ## Inverse -/

theorem acl_inv (hM : M ⊨ Axioms.ACVF) {S : SP M} {x z : M} (hx : acl S x) (hz : iVF z)
    (hmul : iVFMul x z = iVFOne) : acl S z := by
  obtain ⟨φ, hφws, hφfin, hxVF, hφx⟩ := hx
  classical
  set body : LRV.BoundedFormula (Fin S.n ⊕ Fin S.m) 2 :=
    BoundedFormula.substVar (fun _ => gv (1 : Fin 2)) φ ⊓
      pEqG (gMul (gv (1 : Fin 2)) (gv (0 : Fin 2)))
        (gOne (α := Fin S.n ⊕ Fin S.m) (k := 2)) with hbody
  have hws1 : WellSorted S.sortMap (vfSn 2)
      (BoundedFormula.substVar (fun _ => gv (1 : Fin 2)) φ) :=
    wellSorted_substVar S.sortMap hφws (by
      intro i
      exact tmSort_gv S.sortMap (vfSn 2) 1 rfl)
  have hws2 : WellSorted S.sortMap (vfSn 2)
      (pEqG (gMul (gv (1 : Fin 2)) (gv (0 : Fin 2)))
        (gOne (α := Fin S.n ⊕ Fin S.m) (k := 2))) :=
    wellSorted_pEqG S.sortMap (vfSn 2)
      (tmSort_gMul S.sortMap (vfSn 2) (tmSort_gv S.sortMap (vfSn 2) 1 rfl)
        (tmSort_gv S.sortMap (vfSn 2) 0 rfl))
      (tmSort_gOne S.sortMap (vfSn 2))
  have hbodyReal : ∀ (X a : M), body.Realize S.toFun ![X, a] ↔
      φ.Realize S.toFun ![a] ∧ iVFMul a X = iVFOne := by
    intro X a
    rw [hbody, BoundedFormula.realize_inf, realize_substVar, pEqG,
      BoundedFormula.realize_bdEqual]
    simp only [realize_gv, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      realize_gMul, realize_gOne]
    rw [realize_vecOne]
  set f : M → M := fun a =>
    if h : ∃ w : M, iVF w ∧ iVFMul a w = iVFOne then Classical.choose h else iVFZero with hf
  have hf_spec : ∀ a, (∃ w : M, iVF w ∧ iVFMul a w = iVFOne) → iVF (f a) ∧ iVFMul a (f a) = iVFOne := by
    intro a h
    rw [hf]
    simp only [dif_pos h]
    exact ⟨(Classical.choose_spec h).1, (Classical.choose_spec h).2⟩
  refine ⟨exSortedG SortTag.vf body, ?_, ?_, hz, ?_⟩
  · exact wellSorted_exVF S.sortMap (wellSorted_inf S.sortMap (vfSn 2) hws1 hws2)
  · refine (hφfin.image f).subset ?_
    rintro w ⟨hwVF, hw⟩
    rw [exSortedG_one_realize] at hw
    obtain ⟨a, haVF, ha⟩ := hw
    rw [snoc_vec_one, hbodyReal] at ha
    have hex : ∃ v : M, iVF v ∧ iVFMul a v = iVFOne := ⟨w, hwVF, ha.2⟩
    have hspec := hf_spec a hex
    have hweq : w = f a :=
      mul_inv_unique hM haVF hwVF hspec.1 ha.2 hspec.2
    exact ⟨a, ⟨haVF, ha.1⟩, hweq.symm⟩
  · rw [exSortedG_one_realize]
    exact ⟨x, hxVF, by rw [snoc_vec_one, hbodyReal]; exact ⟨hφx, hmul⟩⟩

/-! ## `VF(S)` is contained in `acl(S)` -/

/-- **The field `VF(S)(ā)` generated by the `VF`-parameters**, as an inductive closure: the least
subset of the `VF` sort containing the parameters, `0`, `1`, and closed under `+`, `-`, `×` and
inverse (`z` is the inverse of `x` when `x * z = 1`; the language of `L_RV` has no inverse symbol,
so `QE/VFField.lean` obtains it from the field axioms by choice).

This is membership in the Mathlib `Subfield.closure` of the parameter set — the predicate
`Sec3.VFGen` of `QE/Sec3_sat.lean` is that `Subfield` — stated as an inductive family so that no
`Field` instance on the `VF` sort is needed to state or prove the results below. -/
inductive InVFGen {M : Type} [LRV.Structure M] (S : SP M) : M → Prop
  /-- `0` of the `VF` sort -/
  | zero : InVFGen S iVFZero
  /-- `1` of the `VF` sort -/
  | one : InVFGen S iVFOne
  /-- a `VF`-parameter -/
  | param (i : Fin S.n) : InVFGen S (S.vf i)
  /-- a sum -/
  | add {x y : M} : InVFGen S x → InVFGen S y → InVFGen S (iVFAdd x y)
  /-- a negation -/
  | neg {x : M} : InVFGen S x → InVFGen S (iVFNeg x)
  /-- a product -/
  | mul {x y : M} : InVFGen S x → InVFGen S y → InVFGen S (iVFMul x y)
  /-- an inverse: `z` with `x * z = 1` -/
  | inv {x z : M} : InVFGen S x → iVF z → iVFMul x z = iVFOne → InVFGen S z

/-- **`VF(S) ⊆ acl(S)`** (paper.tex item 742, `aclS:model`, first half): every element of the field
generated by the `VF`-parameters is algebraic over `S`.  Together with `acl_zero`, `acl_one`,
`acl_param`, `acl_add`, `acl_neg`, `acl_mul`, `acl_inv` this says that `acl(S)` contains `VF(S)(ā)`
and is closed under the field operations, i.e. the `VF`-part of `acl(S)` is a field — the part of
"`acl(S)` is a model of `ACVF_S(0,0)`" that concerns the field axioms. -/
theorem acl_of_inVFGen (hM : M ⊨ Axioms.ACVF) {S : SP M} {x : M} (h : InVFGen S x) :
    acl S x := by
  induction h with
  | zero => exact acl_zero hM S
  | one => exact acl_one hM S
  | param i => exact acl_param hM S i
  | add hx hy ihx ihy => exact acl_add hM ihx ihy
  | neg hx ih => exact acl_neg hM ih
  | mul hx hy ihx ihy => exact acl_mul hM ihx ihy
  | inv hx hz hxz ih => exact acl_inv hM ih hz hxz



end SP

