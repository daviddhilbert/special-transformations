namespace SpecialTransformations
namespace Milestone0
namespace M2Residue

variable {M N : Type} [LRV.Structure M] [LRV.Structure N]

/-! ### Constants are preserved

`iRVZero` and `iRVOne` are the nullary function symbols `Fn.rvZero`, `Fn.rvOne` of `L_RV`. -/

theorem map_rvZero (g : M ↪[LRV] N) : g iRVZero = (iRVZero : N) := by
  refine (g.map_fun' Fn.rvZero (fun i : Fin 0 => i.elim0)).trans ?_
  exact congrArg (Structure.funMap (L := LRV) Fn.rvZero)
    (by funext i; exact i.elim0 : (⇑g ∘ (fun i : Fin 0 => i.elim0)) = (fun i : Fin 0 => i.elim0))

theorem map_rvOne (g : M ↪[LRV] N) : g iRVOne = (iRVOne : N) := by
  refine (g.map_fun' Fn.rvOne (fun i : Fin 0 => i.elim0)).trans ?_
  exact congrArg (Structure.funMap (L := LRV) Fn.rvOne)
    (by funext i; exact i.elim0 : (⇑g ∘ (fun i : Fin 0 => i.elim0)) = (fun i : Fin 0 => i.elim0))

theorem map_rvMul (g : M ↪[LRV] N) (a b : M) : g (iRVMul a b) = iRVMul (g a) (g b) := by
  refine (g.map_fun' Fn.rvMul ![a, b]).trans ?_
  exact congrArg (Structure.funMap (L := LRV) Fn.rvMul) (by
    funext i
    fin_cases i <;> rfl)

theorem map_kAdd (g : M ↪[LRV] N) (a b : M) : g (iKAdd a b) = iKAdd (g a) (g b) := by
  refine (g.map_fun' Fn.kAdd ![a, b]).trans ?_
  exact congrArg (Structure.funMap (L := LRV) Fn.kAdd) (by
    funext i
    fin_cases i <;> rfl)

/-! ### The induced ring homomorphism -/

section Models

variable [hM : M ⊨ Axioms.ACVF] [hN : N ⊨ Axioms.ACVF]

/-- **A monomorphism of models induces a homomorphism of residue fields.**  Well-definedness uses
that `g` *reflects* `iUnits` (`Embedding.map_rel'`) and preserves the nullary symbol `0`. -/
noncomputable def kOfHom (g : M ↪[LRV] N) : KOf M →+* KOf N where
  toFun x :=
    ⟨g x.1, by
      rcases x.2 with h | h
      · refine Or.inl ?_
        have h' := (g.map_rel' Rel.memUnits ![x.1]).mpr h
        exact (congrArg (Structure.RelMap (L := LRV) Rel.memUnits) (by
          funext i; fin_cases i; rfl)).mp h'
      · exact Or.inr (by rw [h]; exact map_rvZero g)⟩
  map_zero' := by
    apply Subtype.ext
    exact map_rvZero g
  map_one' := by
    apply Subtype.ext
    exact map_rvOne g
  map_mul' := by
    intro a b
    apply Subtype.ext
    show g (iRVMul a.1 b.1) = iRVMul (g a.1) (g b.1)
    exact map_rvMul g a.1 b.1
  map_add' := by
    intro a b
    apply Subtype.ext
    show g (iKAdd a.1 b.1) = iKAdd (g a.1) (g b.1)
    exact map_kAdd g a.1 b.1

/-- The induced homomorphism acts on carriers by `g`. -/
theorem kOfHom_apply (g : M ↪[LRV] N) (x : KOf M) : (kOfHom g x).1 = g x.1 := rfl

/-- On units, the induced map is the embedding itself. -/
theorem kOfHom_apply_units (g : M ↪[LRV] N) (x : M) (hx : iUnits x) :
    (kOfHom g ⟨x, Or.inl hx⟩).1 = g x := rfl

/-! ### Functoriality (stress test 1) -/

theorem kOfHom_id : kOfHom (Embedding.refl LRV M) = RingHom.id (KOf M) := by
  ext x
  rfl

theorem kOfHom_comp {L : Type} [LRV.Structure L] [hL : L ⊨ Axioms.ACVF]
    (g : M ↪[LRV] N) (h : L ↪[LRV] M) :
    kOfHom (g.comp h) = (kOfHom g).comp (kOfHom h) := by
  ext x
  rfl

theorem kOfHom_of_eq (g g' : M ↪[LRV] N) (h : g = g') : kOfHom g = kOfHom g' := by
  rw [h]

/-- The induced map is injective, hence `#K(M) ≤ #K(N)`.  This is input 1's own size content
(`M5Ledger.acfExtends_field_size`), re-derived through the construction: the derivation of input 1
from qf-type realisation adds no cardinality hypothesis. -/
theorem kOfHom_injective (g : M ↪[LRV] N) : Function.Injective (kOfHom g) :=
  RingHom.injective (kOfHom g)

theorem kof_size_le_of_embedding (g : M ↪[LRV] N) :
    Cardinal.mk (KOf M) ≤ Cardinal.mk (KOf N) :=
  Cardinal.mk_le_of_injective (kOfHom_injective g)

end Models

/-! ### Input 1 from qf-type realisation -/

section Models2

variable [hM : M ⊨ Axioms.ACVF] [hN : N ⊨ Axioms.ACVF]

/-- **`ACFExtends` (ledger input 1) follows from qf-type realisation.**  A total monomorphism
`g : M ↪[LRV] N` extending `f` exists by the tree's one-step/exhaustion machinery, and `kOfHom g` is
the required residue-field homomorphism. -/
theorem acfExtends_of_qfsat (hQ : M2Saturation.QFSat M N) :
    M5Ledger.ACFExtends (M := M) (N := N) := by
  intro S f
  have hstep : ∀ (S' : LRV.Substructure M) (f' : S' ↪[LRV] N), ∀ m ∉ S',
      ∃ b, Realize.RealizesAtomic S' f' m b := by
    intro S' f' m _
    exact hQ S' f' m
  obtain ⟨g, hg⟩ := Realize.exists_total_embedding_of_realizesAtomic hstep S f
  refine ⟨kOfHom g, ?_⟩
  intro x hx
  have h2 : ((kOfHom g) ⟨(x : M), Or.inl hx⟩ : KOf N).1 = g (x : M) := rfl
  rw [h2]
  exact hg x

/-- **`ACFExtends` (input 1) follows from `SaturationRealization` (input 5)**: inputs 1 and 5 of the
§10b ledger are not independent. -/
theorem acfExtends_of_satReal (h5 : M5Ledger.SaturationRealization (M := M) (N := N)) :
    M5Ledger.ACFExtends (M := M) (N := N) :=
  acfExtends_of_qfsat (M2Saturation.qfsat_of_satReal h5)

/-- **Input 1 at `PaperHyp` pairs from input 5 there.**  Composing with the §10b ledger's own inputs,
the five-input decomposition can be run with input 1 deleted. -/
theorem ledgerInput1P_of_ledgerInput5P (h5 : M5Ledger.LedgerInput5P) :
    M5Ledger.LedgerInput1P := by
  intro M N _ _ _ _ hP
  exact acfExtends_of_satReal (h5 M N hP)

end Models2

/-! ### Stress test: input 1 is not vacuous, and the derivation keeps its content

`ACFExtends` at a pair forces `#K(M) ≤ #K(N)` (`M5Ledger.acfExtends_field_size`).  Here the same
inequality is obtained from the derivation of this file, so the derived input is not weaker than the
input the ledger was stated with; and it is *not* vacuous at `S = ⊥`: the requirement is about every
substructure, and the field map must agree with `f` on the units of the substructure. -/

section StressTests

variable [hM : M ⊨ Axioms.ACVF] [hN : N ⊨ Axioms.ACVF]

/-- Input 1's size content, through `QFSat`: the derived `ACFExtends` still forces
`#K(M) ≤ #K(N)`. -/
theorem kof_size_le_of_qfsat (hQ : M2Saturation.QFSat M N) (S : LRV.Substructure M)
    (f : S ↪[LRV] N) : Cardinal.mk (KOf M) ≤ Cardinal.mk (KOf N) := by
  have hstep : ∀ (S' : LRV.Substructure M) (f' : S' ↪[LRV] N), ∀ m ∉ S',
      ∃ b, Realize.RealizesAtomic S' f' m b := by
    intro S' f' m _
    exact hQ S' f' m
  obtain ⟨g, -⟩ := Realize.exists_total_embedding_of_realizesAtomic hstep S f
  exact kof_size_le_of_embedding g

end StressTests

