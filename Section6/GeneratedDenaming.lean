import Section6.GeneratedParameters
import Section6.AuxiliaryDenaming
import Section6.NamedLanguage

/-! Dename every RV constant of the native base generated by an original
tuple. The output keeps that tuple free, including its VF coordinates.
The formula is chosen before a henselian substructure or any additional
RV interpretation. This is the parameter step towards Proposition 6.4.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV

namespace SpecialTransformations.Section6.GeneratedDenaming
open RVTermSupport RVAbstraction RVGraphExpansion

variable {C I β : Type} [LRV.Structure C] [hC : C ⊨ Axioms.ACVF]
variable {E : _root_.FirstOrder.Language.{0, 0}}

theorem dename_rv_formula (hcan : CanonicalStructure.IsCanonical (M := C))
    (s : I → SortTag) (v : I → C) (hv : ∀ i, sortEval (s i) (v i))
    (φ : (Auxiliary (NamedExtra E (Substructure.closure LRV (Set.range v)))).Formula β) :
    ∃ χ : (Expanded E).Formula (I ⊕ β),
      ExpandedLogic.IsVFQF χ ∧
      ExpandedLogic.WellSorted (Sum.elim s (fun _ => .rv)) (fun _ => .rv) χ ∧
      ∀ (X : LRV.Substructure C) (hBX : Substructure.closure LRV (Set.range v) ≤ X)
        [E.Structure (SubRV (X : Set C))],
        ∀ b : β → SubRV (X : Set C),
        letI := RVSubstructure.extraStructure (E := E) X
        letI := namedExtraStructure (E := E) (Substructure.closure LRV (Set.range v)) X hBX
        letI := RVSubstructure.auxiliaryStructure (E := NamedExtra E
          (Substructure.closure LRV (Set.range v))) X
        (χ.Realize (Sum.elim
          (fun i => (⟨v i, hBX (Substructure.subset_closure (Set.mem_range_self i))⟩ : X))
          (RVSubstructure.inclusion X ∘ b)) ↔ φ.Realize b) := by
  let B := Substructure.closure LRV (Set.range v)
  have hterms : ∀ r : SubRV (B : Set C), ∃ t : LRV.Term I,
      termSort s ((LHom.sumInl : LRV →ᴸ Expanded E).onTerm t) = some .rv ∧
        t.realize v = r.val.val := by
    intro r
    exact GeneratedParameters.expanded_rv_parameter_term E hcan s v hv r.val.val r.property r.val.property
  choose ts hs ht using hterms
  let σ : SubRV (B : Set C) ⊕ β → (Expanded E).Term (I ⊕ β) :=
    Sum.elim (fun r => ((LHom.sumInl : LRV →ᴸ Expanded E).onTerm (ts r)).relabel Sum.inl)
      (fun b => .var (.inr b))
  have hσ : ∀ r, termSort (Sum.elim s (fun _ => .rv)) (σ r) = some .rv := by
    intro r
    cases r with
    | inl r =>
      exact (GuardedLift.termSort_relabel s (Sum.elim s (fun _ => .rv)) Sum.inl
        (fun _ => rfl) _).trans (hs r)
    | inr b => rfl
  refine ⟨AuxiliaryDenaming.formula σ φ, AuxiliaryDenaming.formula_isVFQF σ φ,
    AuxiliaryDenaming.formula_wellSorted _ σ hσ φ, ?_⟩
  intro X hBX _ b
  letI := RVSubstructure.extraStructure (E := E) X
  letI := RVSubstructure.auxiliaryStructure (E := E) X
  letI := namedExtraStructure (E := E) B X hBX
  letI := RVSubstructure.auxiliaryStructure (E := NamedExtra E B) X
  let param : SubRV (B : Set C) → SubRV (X : Set C) := fun r => ⟨r.val, hBX r.property⟩
  let vX : I → X := fun i => ⟨v i, hBX (Substructure.subset_closure (Set.mem_range_self i))⟩
  have hts (r : SubRV (B : Set C)) :
      (ts r).realize vX = RVSubstructure.inclusion X (param r) := by
    apply Subtype.ext
    have h := HomClass.realize_term (Substructure.subtype X) (t := ts r) (v := vX)
    have he : X.subtype ∘ vX = v := rfl
    rw [he] at h
    have hh : ((ts r).realize vX).val = (ts r).realize v := by
      simpa only [Substructure.coe_subtype] using h.symm
    exact hh.trans (ht r)
  have hsem : ∀ r, (σ r).realize (Sum.elim vX (RVSubstructure.inclusion X ∘ b)) =
      RVSubstructure.inclusion X (Sum.elim param b r) := by
    intro r
    cases r with
    | inl r =>
      simpa only [σ, Sum.elim_inl, Term.realize_relabel, Sum.elim_comp_inl,
        LHom.realize_onTerm] using hts r
    | inr b => rfl
  have he := AuxiliaryDenaming.formula_realize (RVSubstructure.inclusion X)
    (RVSubstructure.inclusion_injective X) (RVSubstructure.functions_compatible X)
    (RVSubstructure.relations_compatible X) (RVSubstructure.guard_compatible X)
    param b (Sum.elim vX (RVSubstructure.inclusion X ∘ b)) σ hsem φ
  have hstr : AuxiliaryDenaming.namedStructure (E := E) param =
      RVSubstructure.auxiliaryStructure (E := NamedExtra E B) X := by
    apply Structure.ext
    · funext k f z
      cases f with
      | inl f => rfl
      | inr f => cases f with
        | inl f => rfl
        | inr c =>
          cases k with
          | zero => rfl
          | succ k => exact isEmptyElim c
    · funext k r z
      cases r with
      | inl r => rfl
      | inr r => cases r with
        | inl r => rfl
        | inr r => exact isEmptyElim r
  rw [hstr] at he
  exact he

end SpecialTransformations.Section6.GeneratedDenaming
